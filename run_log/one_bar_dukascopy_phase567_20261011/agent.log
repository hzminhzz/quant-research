+        "low": [99.25] * len(timestamps),
+        "close": [99.5] * len(timestamps),
+        "volume": [1.0] * len(timestamps),
+    }).with_columns(pl.col("timestamp").cast(pl.Datetime("us", "UTC")))
+    prices = prices.with_columns(
