+    returns = [b / a - 1 for a, b in zip([INITIAL_CASH, *daily_values[:-1]], daily_values) if a]
+    ambiguous = len(strategy.ambiguous)
+    ambiguous_times = [datetime.fromisoformat(row["timestamp"]) for row in strategy.ambiguous]
