+    (OUT / "phase567_results.json").write_text(json.dumps(results, indent=2, default=str) + "\n")
+    hashes = {p.relative_to(ROOT).as_posix(): sha256(p) for p in sorted(OUT.rglob("*")) if p.is_file()}
