+    assert fills["commission"].sum() == 5.0
+    assert round(fills["slippage"].sum(), 8) == 0.5
+    trades = result.to_trades_dataframe()
+    assert round(float(trades["gross_pnl"].sum() - trades["pnl"].sum()), 8) == 5.0
+
+
+INITIAL_CASH = 1_000_000.0

