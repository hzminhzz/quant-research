def _verify_identity(record: dict[str, object], identity_key: str, *, exclude: set[str] | None = None) -> str:
    payload = dict(record)
    claimed = payload.pop(identity_key, None)
    for key in exclude or set():
        payload.pop(key, None)
    if not isinstance(claimed, str) or claimed != canonical_sha256(payload):
        raise ValueError(f"{identity_key} mismatch")
    return claimed


def _load_qualification(path: Path, *, symbol: str) -> tuple[dict[str, object], dict[str, object]]:
    manifest = json.loads(path.read_text())
    expected_schema = INDEXES[symbol]["qualification_schema"]
    if manifest.get("schema_version") != expected_schema:
        raise ValueError(f"{symbol}: unsupported qualification schema {manifest.get('schema_version')}")
    manifest_identity = _verify_identity(manifest, "manifest_identity")
    if manifest.get("source_library") != {"name": "dukascopy-node", "version": "1.46.4"}:
        raise ValueError("index qualification source-library mismatch")
    records = [
        item
        for item in manifest.get("instruments", [])
        if isinstance(item, dict) and item.get("logical_symbol") == symbol
    ]
    if len(records) != 1:
        raise ValueError(f"{symbol}: qualification record missing or ambiguous")
    record = records[0]
    if record.get("source_instrument") != INDEXES[symbol]["source_instrument"]:
        raise ValueError(f"{symbol}: qualification source instrument mismatch")
    _verify_identity(record, "qualification_identity")
    return manifest, {**record, "qualification_manifest_identity": manifest_identity}


