+OUT = ROOT / "run_log/one_bar_dukascopy_2013_2026_20261011"
+START, END = date(2013, 1, 1), date(2026, 7, 14)
+ASSET, MULTIPLIER, NQ_TICK = "NQ_PROXY", 20.0, 0.25
