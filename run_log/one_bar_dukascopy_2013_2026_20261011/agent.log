+def input_files() -> list[Path]:
+    return sorted(
+        p for p in STORE.glob("year=*/month=*/data.parquet")
+        if (p.parent.parent.name.split("=")[1] < "2026")
+        or (p.parent.parent.name == "year=2026" and int(p.parent.name.split("=")[1]) <= 7)
+    )
