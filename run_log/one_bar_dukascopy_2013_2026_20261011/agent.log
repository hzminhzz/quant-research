#!/usr/bin/env python3
"""Legacy direct-.bi5 downloader for non-canonical Dukascopy instruments.

Downloads raw .bi5 files and writes historical monthly Hive partitions. Active
Wave-1 FX production stores are excluded from the default instrument set and
fail closed if supplied programmatically.
"""

from __future__ import annotations

import asyncio
import lzma
import struct
import sys
import time
from calendar import monthrange
from datetime import date, datetime, timezone
from pathlib import Path

import httpx
import polars as pl

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from dukascopy_rebuild.scope import assert_legacy_write_allowed  # noqa: E402

STORE = Path("/home/quant/dev/quant/ml4t-data/.data/store")
URL_ROOT = "https://datafeed.dukascopy.com/datafeed"

# All instruments: (dukascopy_id, symbol, store_name, decimal_factor)
INSTRUMENTS = [
    # Active canonical Wave-1 FX stores are intentionally excluded. They are
    # maintained only by scripts/update_dukascopy_fx.py.
    # DAX and NIKKEI225 are retired from Dukascopy and authoritative via LSE.
    ("eurjpy", "EURJPY", "forex_minute_EURJPY", 1000),
    ("usa500idxusd", "ES", "index_minute_ES", 1000),
    ("usatechidxusd", "NQ", "index_minute_NQ", 1000),
    ("lightcmdusd", "CL", "commodity_minute_CL", 1000),
    ("usa30idxusd", "USA30", "index_minute_USA30", 1000),
    ("eurgbp", "EURGBP", "forex_minute_EURGBP", 1000),
    ("gbpjpy", "GBPJPY", "forex_minute_GBPJPY", 1000),
]

START = date(2013, 1, 1)
TODAY = date.today()
CONCURRENCY = 16  # max parallel downloads per month


def build_url(instrument: str, dt: date) -> str:
    """Build the .bi5 download URL. Month is 0-indexed in Dukascopy's scheme."""
    return (
        f"{URL_ROOT}/{instrument.upper()}/"
        f"{dt.year:04d}/{dt.month - 1:02d}/{dt.day:02d}/"
        f"BID_candles_min_1.bi5"
    )


def decode_bi5(data: bytes, day: date, decimal_factor: int) -> list[tuple]:
    """Decode a compressed .bi5 file into OHLCV candles.

    bi5 m1 struct (24 bytes each, big-endian):
      [0:4]   Int32   - seconds offset from midnight UTC
      [4:8]   Int32   - open (raw)
      [8:12]  Int32   - close (raw)
      [12:16] Int32   - low (raw)
      [16:20] Int32   - high (raw)
      [20:24] Float32 - volume

    Returns list of (timestamp_ms, open, high, low, close, volume).
    """
    if len(data) == 0:
        return []

    decompressed = lzma.decompress(data)
    step = 24
    n = len(decompressed) // step
    if n == 0:
        return []

    day_start_ms = int(
        datetime(day.year, day.month, day.day, tzinfo=timezone.utc).timestamp() * 1000
    )
    inv_df = 1.0 / decimal_factor

    candles = []
    for i in range(n):
        off = i * step
        sec, open_raw, close_raw, low_raw, high_raw = struct.unpack_from(">5i", decompressed, off)
        vol = struct.unpack_from(">f", decompressed, off + 20)[0]
        ts_ms = sec * 1000 + day_start_ms

        # Skip flat candles (zero volume and all prices equal)
        if vol == 0.0 and open_raw == close_raw == low_raw == high_raw:
            continue

        # Reorder from bi5 [open, close, low, high] to standard [open, high, low, close]
        candles.append(
            (
                ts_ms,
                open_raw * inv_df,
                high_raw * inv_df,
                low_raw * inv_df,
                close_raw * inv_df,
                vol,
            )
        )

    return candles


def has_data(store_name: str, year: int, month: int) -> bool:
    """Check if a valid non-empty parquet file already exists."""
    p = STORE / store_name / f"year={year}" / f"month={month}" / "data.parquet"
    if not p.exists():
        return False
    try:
        df = pl.read_parquet(p)
        return len(df) > 0
    except Exception:
        return False


def month_range(start: date, end: date):
    """Yield (year, month, days_in_month) tuples."""
    y, m = start.year, start.month
    while (y, m) <= (end.year, end.month):
        _, dim = monthrange(y, m)
        if date(y, m, 1) <= end:
            actual = min(dim, (end - date(y, m, 1)).days + 1)
            if actual > 0:
                yield y, m, actual
        m += 1
        if m > 12:
            m = 1
            y += 1


async def download_month(
    client: httpx.AsyncClient,
    instrument: str,
    symbol: str,
    store_name: str,
    year: int,
    month: int,
    days_in_month: int,
    decimal_factor: int,
    semaphore: asyncio.Semaphore,
) -> int:
    """Download all days of a non-canonical month and write to Parquet."""
    assert_legacy_write_allowed(
        entrypoint="scripts/download_dukascopy_minute.py:download_month",
        symbol=symbol,
        store_name=store_name,
    )
    dates = [date(year, month, d) for d in range(1, days_in_month + 1)]

    async def fetch(dt: date) -> list[tuple]:
        url = build_url(instrument, dt)
        for attempt in range(3):
            async with semaphore:
                try:
                    r = await client.get(url)
                    if r.status_code == 200 and len(r.content) > 0:
                        return decode_bi5(r.content, dt, decimal_factor)
                    if r.status_code == 404:
                        return []  # No data (weekend/holiday)
                    if r.status_code == 403:
                        await asyncio.sleep(2 * (attempt + 1))
                        continue
                    return []
                except (httpx.HTTPError, httpx.TimeoutException):
                    if attempt < 2:
                        await asyncio.sleep(2 * (attempt + 1))
                    else:
                        return []
        return []

    results = await asyncio.gather(*[fetch(d) for d in dates])
