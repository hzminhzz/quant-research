scripts/run_tokyo_fix_program3_ohlcv_execution_20261011_v1.py:106:    spec={'session_id':SID,'market':'fx','thesis':'Evaluate whether unconditional Gotobi post-fix USDJPY short remains positive under conservative OHLC limit-fill bounds relative to next-open market benchmark. No outcome-based strategy selection.','mechanism':'HYPOTHESIS: settlement-related pre-fix USD demand may unwind after fixing. Price proxies do not measure dealer inventory.','falsifier':'Reject robustness if any conservative bound is nonpositive at1pip full sample, or2024-25 or2026 stress is negative. Report all costs/bounds; economic positivity cannot approve deployment or establish real fill probability.','instruments':[{'symbol':'USDJPY','kind':'cfd','venue':'UNSPECIFIED_RETAIL_FX_BROKER','identity':'LSE composite JPY per USD price proxy. Broker contract/tick/lot/shorting terms unverified; no real orders. Simulated fractional USD10000 base units, tick assumption .001 JPY.','timezone':'Asia/Tokyo','session':'Tokyo bank fix intraday'}],'data':[{'id':f'year{y}','path':str(p.relative_to(ROOT)),'role':'prices','symbol':'USDJPY'} for y,p in zip(range(2020,2027),SOURCES)],'evaluation':{'development_start':'2020-01-01T00:00:00Z','development_end':'2026-08-31T15:00:00Z','holdout_start':'2026-08-31T15:00:00Z','holdout_end':'2026-10-31T15:00:00Z','holdout':'SEALED, never read','development':'2020-23;2024-25 retrospective validation;2026Jan-Aug observed regime stress, all exploratory','initial_usd':10000,'notional_usd':10000,'costs_pips':[.8,1,1.4,2],'variants':variants,'execution_window':[594,630],'proxy_windows':[[510,594],[570,594]],'proxy_features':['extension0830','extension0930','rv','acceleration','range'],'proxy_horizons':[610,630],'placebo_window':[566,580],'reference':'09:54 close available09:55. Submit09:55; first fill09:56; TTL1/3 through09:56/58. Close decision10:09 native MARKET fill10:10. Never use09:55 close.','gating':'Unchanged OHLC; synthetic volume1 only for strict high>limit+buffer within TTL and market exit. PositiveVolumeLimit is execution DATA GATE, not a signal input. Cancel after last eligible bar matching. Filled native limit price=limit, no optimistic open improvement.','multiplicity':'Holm20 proxy controlled contrasts; Holm14 policy/control contrasts. Costs, year and quantiles descriptive. No winner selection. Earlier historical trial count incomplete; DSR/PBO not reproducible.','categorical':'Development2020-23 terciles per feature, applied unchanged; no trading filter','dag':'weekday/year -> Gotobi and returns; settlement -> price and returns; news -> price and returns. Adjust weekday/year only. No causal inventory estimand.','stop_rule':'Execute fixed matrix once; retain runtime failures; no new variants or minute optimization.'},'baseline':'Unconditional Gotobi MARKET09:56-10:10 and ordinary control; old nativev2 preserved with distinct cohort; cash0','costs':{'commission_bps':0,'slippage_bps':0,'roundtrip_pips':[.8,1,1.4,2],'method':'Explicit all-in JPY cash-flow overlay translated at actual raw exit; native raw fills zero slippage to preserve limit price. Applies same assumed costs to market and passive: no rebate/zero-spread claim.','quote_scenarios':'Estimated market .4+.4,.5+.5,.7+.7,1+1pip; passive .2+.6,.3+.7,.5+.9,.8+1.2pip entry/exit budget; aggregate equal. Not broker-calibrated.','financing':'No overnight; no rollover. Actual broker terms UNKNOWN.','impact':'USD10000 small assumed notional; no FX market-volume calibration, capacity UNKNOWN.'},'trials':trials,'evidence':[str((OUT/n).relative_to(ROOT)) for n in ['source_manifest.json','methodology.json','preservation_before.json']]}
