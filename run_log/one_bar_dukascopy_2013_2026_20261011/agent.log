+def freeze_spec(files: list[Path]) -> None:
+    OUT.mkdir(parents=True, exist_ok=True)
+    source_manifest = [
+        {"path": p.relative_to(STORE).as_posix(), "size_bytes": p.stat().st_size, "sha256": sha256(p)}
