+| Net daily Sortino | {c['sortino_daily_252_rf0']:.3f} |
+| Net realized-cashflow CAGR | {c['cagr_realized_cashflow_proxy']:.3%} |
+| Net Calmar | {c['calmar_realized_cashflow_proxy']:.3f} |
