+                                    pl.col("report_gross_pnl").sum().alias("gross_pnl_usd"))
+             .sort("month"))
+    losses = ordered_net[ordered_net < 0]
+    gains = ordered_net[ordered_net > 0]
+    daily_losses = net_returns[net_returns <= np.quantile(net_returns, .05)]
+    metrics = {
+        "trial": trial, "closed_trades": frame.height,
+        "gross_pnl_usd": float(frame["report_gross_pnl"].sum()), "net_pnl_usd": float(frame[pnl_col].sum()),
+        "cost_drag_usd": float(frame["report_gross_pnl"].sum() - frame[pnl_col].sum()),
