+#!/usr/bin/env python3
+"""Build a retrospective report from the completed annual evaluation ledgers."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+import polars as pl
+from ml4t.backtest.analytics import calmar_ratio, cagr, max_drawdown, sharpe_ratio, sortino_ratio
+
+PACKAGE = Path(__file__).resolve().parents[1]
+ROOT = PACKAGE / "backtests/practical_yearly/by_year"
+OUT = PACKAGE / "reports"
+YEARS = range(2013, 2027)
+INITIAL_CASH = 1_000_000.0
+TRIALS = ("native_zero_cost", "native_full_tick_cost")
