SPEC.loader.exec_module(REPORT)


def test_completed_ledgers_reconcile_to_annual_and_summary_totals():
    REPORT.verify_recovery_audit()
    zero = REPORT.load_ledgers("native_zero_cost")
    costed = REPORT.load_ledgers("native_full_tick_cost")
    zero_stats, _, _, _ = REPORT.summarize(zero, "native_zero_cost")
    costed_stats, _, _, costed_annual = REPORT.summarize(costed, "native_full_tick_cost")

    assert zero_stats["closed_trades"] == costed_stats["closed_trades"] == 5462
    assert abs(zero_stats["net_pnl_usd"] - 247566.38) < 0.01
    assert abs(costed_stats["net_pnl_usd"] - 166107.92) < 0.01
    annual = {row["year"]: row for row in costed_annual}
    assert abs(annual[2026]["net_pnl_usd"] - (-14166.96)) < 0.01
    assert sum(row["trades"] for row in costed_annual) == 5462


def test_daily_cashflow_series_includes_no_exit_days_and_cash_base():
    frame = REPORT.load_ledgers("native_full_tick_cost")
    metrics, daily, _, _ = REPORT.summarize(frame, "native_full_tick_cost")
    exit_dates = frame.with_columns(REPORT.pl.col("exit_time").cast(REPORT.pl.Datetime).dt.date().alias("date"))["date"].n_unique()
    assert daily.height > exit_dates
    assert daily["net_realized_equity_usd"][-1] == pytest.approx(1_000_000 + metrics["net_pnl_usd"])
    assert metrics["drawdown_basis"].startswith("Daily realized trade cash flows")


import pytest
The report reads the completed annual `evaluation_trades.csv` ledgers from 2013 through 2026. It uses evaluation trades only and excludes warmup and duplicated boundary trades. PnL uses one hypothetical contract at $20 per index point. The source is Dukascopy `USATECH.IDX/USD` BID-only index/CFD data. It is not a dated CME NQ contract.

The costed trial models $2.50 per fill and 0.25 adverse index points per fill. Its ledger `gross_pnl` includes modeled slippage in execution prices and excludes commissions. Its `pnl` is net of both. The zero-cost trial provides a separate aggregate comparison. Some trades have different exit timestamps across cost variants, so the trials are not matched row by row. Annual engine accounts reset to $1,000,000; this report separately reconstructs cumulative realized cash flows across years. The report uses installed `ml4t.backtest.analytics` for Sharpe, Sortino, maximum drawdown, CAGR, and Calmar calculations. Polars aggregates exit-date cash flows. Daily returns use a synthetic $1,000,000 assigned base, zero risk-free rate, 252 annualization periods, and calendar days between the first and last exit. Dates without trade exits have zero realized PnL.

The plotted curves and drawdown metrics use realized trade cash flows. They do not mark open positions each day and are not native engine mark-to-market equity. The $1,000,000 base is only a scaling convention. It is not verified margin or account capital. No comparable buy-and-hold close series is included, so this report omits the benchmark.

## Costed trial metrics

