#!/usr/bin/env python3
"""Build a retrospective report from the completed annual evaluation ledgers."""
from __future__ import annotations

import json
import os
from pathlib import Path
from tempfile import gettempdir

os.environ.setdefault("MPLCONFIGDIR", str(Path(gettempdir()) / "quant-research-matplotlib"))
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import polars as pl
from importlib.metadata import version
from ml4t.backtest.analytics import cagr, max_drawdown, sharpe_ratio
from ml4t.diagnostic.api import PortfolioAnalysis

PACKAGE = Path(__file__).resolve().parents[1]
ROOT = PACKAGE / "backtests/practical_yearly/by_year"
OUT = PACKAGE / "reports"
YEARS = range(2013, 2027)
INITIAL_CASH = 1_000_000.0
TRIALS = ("native_zero_cost", "native_full_tick_cost")


def load_ledgers(trial: str) -> pl.DataFrame:
    frames = []
    for year in YEARS:
        path = ROOT / str(year) / trial / "evaluation_trades.csv"
        if not path.is_file():
            raise FileNotFoundError(path)
        frame = pl.read_csv(path, try_parse_dates=True)
        if frame.filter(pl.col("status") != "closed").height:
            raise AssertionError(f"Non-closed evaluation rows in {path}")
        if frame.filter(pl.col("entry_session_year") != year).height:
            raise AssertionError(f"Wrong evaluation year in {path}")
        summary_path = ROOT / str(year) / "year_summary.json"
        annual = json.loads(summary_path.read_text())
        summary_trial = next(item for item in annual["trials"] if item["name"] == trial)
        eval_metrics = json.loads((path.parent / "evaluation_metrics.json").read_text())
        if annual["status"] != "completed" or eval_metrics["status"] != "completed":
            raise AssertionError(f"Annual result is not complete: {year}/{trial}")
        if frame.height != summary_trial["closed_trades"] or abs(float(frame["pnl"].sum()) - summary_trial["net_pnl_usd"]) > 1e-5:
            raise AssertionError(f"Evaluation ledger does not reconcile to annual summary: {year}/{trial}")
        if frame.height != eval_metrics["closed_trades"] or abs(float(frame["pnl"].sum()) - eval_metrics["net_pnl_usd"]) > 1e-5:
            raise AssertionError(f"Evaluation ledger does not reconcile to evaluation metrics: {year}/{trial}")
        frames.append(frame.with_columns(pl.lit(year).alias("ledger_year")))
    result = pl.concat(frames, how="vertical_relaxed").sort("exit_time")
    if result.select(pl.struct(["entry_time", "exit_time"]).n_unique()).item() != result.height:
        raise AssertionError("Duplicate entry/exit records across annual evaluation ledgers")
    return result


def verify_recovery_audit() -> None:
    audit_path = PACKAGE / "backtests/practical_yearly/validation/recovery_audit.json"
    audit = json.loads(audit_path.read_text())
    if audit.get("status") != "passed" or len(audit.get("years", [])) != len(YEARS):
        raise AssertionError("The annual recovery audit is incomplete or did not pass")
    for year_result in audit["years"]:
        year = year_result["year"]
        for item in year_result["trials"]:
            ledger = pl.read_csv(ROOT / str(year) / item["name"] / "evaluation_trades.csv")
            if year_result["status"] != "passed" or ledger.height != item["closed_trade_count"]:
                raise AssertionError(f"Recovery audit count mismatch: {year}/{item['name']}")
            if abs(float(ledger["pnl"].sum()) - item["trade_pnl_usd"]) > 1e-5:
                raise AssertionError(f"Recovery audit PnL mismatch: {year}/{item['name']}")


def summarize(frame: pl.DataFrame, trial: str) -> tuple[dict, pl.DataFrame, pl.DataFrame, list[dict]]:
    pnl_col = "pnl"
    daily = (frame.with_columns(pl.col("exit_time").cast(pl.Datetime).dt.date().alias("date"))
             .group_by("date").agg(pl.col(pnl_col).sum().alias("net_pnl_usd"),
                                    pl.col("gross_pnl").sum().alias("gross_pnl_usd"),
                                    pl.len().alias("trades"))
             .sort("date"))
    # Include calendar days with no exits; the daily account-return series is a realized-cash-flow proxy.
    days = pl.date_range(daily["date"].min(), daily["date"].max(), interval="1d", eager=True).alias("date")
    daily = days.to_frame().join(daily, on="date", how="left").with_columns(
        pl.col("net_pnl_usd", "gross_pnl_usd").fill_null(0.0), pl.col("trades").fill_null(0)
    ).with_columns(
        (INITIAL_CASH + pl.col("net_pnl_usd").cum_sum()).alias("net_realized_equity_usd"),
        (INITIAL_CASH + pl.col("gross_pnl_usd").cum_sum()).alias("gross_realized_equity_usd"),
    )
    net_returns = (daily["net_pnl_usd"].to_numpy() / INITIAL_CASH)
    gross_returns = (daily["gross_pnl_usd"].to_numpy() / INITIAL_CASH)
    net_equity = daily["net_realized_equity_usd"].to_numpy()
    gross_equity = daily["gross_realized_equity_usd"].to_numpy()
    net_dd, peak_i, trough_i = max_drawdown(net_equity)
    gross_dd, _, _ = max_drawdown(gross_equity)
    net_dd_usd = float(net_equity[trough_i] - net_equity[:peak_i + 1].max())
    span_years = max((daily["date"][-1] - daily["date"][0]).days / 365.25, 1 / 365.25)
    risk = PortfolioAnalysis(returns=net_returns, periods_per_year=252).compute_summary_stats()
    net_cagr = cagr(INITIAL_CASH, float(net_equity[-1]), span_years)
    gross_cagr = cagr(INITIAL_CASH, float(gross_equity[-1]), span_years)
    ordered_net = frame[pnl_col].to_numpy()
    yearly = (frame.with_columns(pl.col("ledger_year").alias("year"))
              .group_by("year").agg(pl.len().alias("trades"), pl.col("gross_pnl").sum().alias("gross_pnl_usd"),
                                    pl.col("pnl").sum().alias("net_pnl_usd"),
                                    pl.col("pnl").mean().alias("net_per_trade_usd"))
              .sort("year"))
    annual_rows = yearly.to_dicts()
    month = (frame.with_columns(pl.col("exit_time").cast(pl.Datetime).dt.strftime("%Y-%m").alias("month"))
             .group_by("month").agg(pl.col("pnl").sum().alias("net_pnl_usd"),
                                    pl.col("gross_pnl").sum().alias("gross_pnl_usd"))
             .sort("month"))
    losses = ordered_net[ordered_net < 0]
    gains = ordered_net[ordered_net > 0]
    metrics = {
        "trial": trial, "closed_trades": frame.height,
        "gross_pnl_before_commission_usd": float(frame["gross_pnl"].sum()), "net_pnl_usd": float(frame[pnl_col].sum()),
        "commission_drag_gross_to_net_usd": float(frame["gross_pnl"].sum() - frame[pnl_col].sum()),
        "net_per_trade_usd": float(frame[pnl_col].mean()),
        "trade_win_rate": float((frame[pnl_col] > 0).mean()),
        "profit_factor": float(gains.sum() / abs(losses.sum())) if len(losses) else None,
        "best_trade_net_usd": float(frame[pnl_col].max()), "worst_trade_net_usd": float(frame[pnl_col].min()),
        "long_trades": frame.filter(pl.col("direction") == "long").height,
        "short_trades": frame.filter(pl.col("direction") == "short").height,
        "long_net_pnl_usd": float(frame.filter(pl.col("direction") == "long")[pnl_col].sum()),
        "short_net_pnl_usd": float(frame.filter(pl.col("direction") == "short")[pnl_col].sum()),
        "sharpe_daily_252_rf0": float(risk.sharpe_ratio),
        "sortino_daily_252_rf0": float(risk.sortino_ratio),
        "cagr_realized_cashflow_proxy": float(net_cagr), "calmar_realized_cashflow_proxy": float(risk.calmar_ratio),
        "gross_sharpe_daily_252_rf0": float(sharpe_ratio(gross_returns, risk_free_rate=0.0, annualize=True)),
        "gross_cagr_realized_cashflow_proxy": float(gross_cagr),
        "max_drawdown_net_usd_from_assigned_1m": net_dd_usd,
        "max_drawdown_net_pct_of_assigned_1m": net_dd_usd / INITIAL_CASH,
        "max_drawdown_net_pct_of_running_peak": float(net_dd),
        "max_drawdown_gross_pct_of_assigned_1m": float((gross_equity - np.maximum.accumulate(gross_equity)).min() / INITIAL_CASH),
        "max_drawdown_peak_date": str(daily["date"][peak_i]), "max_drawdown_trough_date": str(daily["date"][trough_i]),
        "underwater_days_net": int((net_equity < np.maximum.accumulate(net_equity)).sum()),
        "underwater_max_duration_days_net": max_underwater(net_equity),
        "daily_var_95_usd_on_assigned_1m": float(risk.var_95 * INITIAL_CASH),
        "daily_cvar_95_usd_on_assigned_1m": float(risk.cvar_95 * INITIAL_CASH),
        "annualization_periods": 252, "risk_free_rate_annual": 0.0,
        "nominal_initial_cash_usd_assigned_for_return_scaling_only": INITIAL_CASH,
        "evaluation_years": [int(y) for y in yearly["year"].to_list()],
        "benchmark": "Unavailable: no matched buy-and-hold close series in this report package.",
        "drawdown_basis": "Daily realized trade cash flows. Open positions are not marked; not native mark-to-market drawdown.",
    }
    return metrics, daily, month, annual_rows


def max_underwater(equity: np.ndarray) -> int:
    peak = np.maximum.accumulate(equity)
    run = best = 0
    for is_under in equity < peak:
        run = run + 1 if is_under else 0
        best = max(best, run)
    return best


def render(metrics: dict, daily: pl.DataFrame, monthly: pl.DataFrame, annual: list[dict], output: Path) -> None:
    fig = plt.figure(figsize=(16, 12), facecolor="#fbfcfe")
    grid = fig.add_gridspec(3, 2, height_ratios=[1.15, .75, .9], hspace=.34, wspace=.23)
    dates = np.array(daily["date"].to_list(), dtype="datetime64[D]")
    net = daily["net_realized_equity_usd"].to_numpy()
    gross = daily["gross_realized_equity_usd"].to_numpy()
    ax = fig.add_subplot(grid[0, :]); ax.plot(dates, gross, color="#7c8da5", lw=1.1, label="Costed fills, pre-commission")
    ax.plot(dates, net, color="#1463a5", lw=1.5, label="Net realized cash-flow equity")
    ax.axhline(INITIAL_CASH, color="#8a96a8", lw=.8, ls="--"); ax.set_title("Cumulative realized cash flows (USD 1m assigned base)", loc="left", weight="bold")
    ax.legend(frameon=False, ncol=2); ax.grid(alpha=.2)
    ax = fig.add_subplot(grid[1, 0]); peak = np.maximum.accumulate(net); dd_usd = net - peak; dd_pct = dd_usd / peak
    ax.fill_between(dates, dd_usd, 0, color="#d95b5b", alpha=.35); ax.set_title("Realized-equity drawdown", loc="left", weight="bold")
    ax.set_ylabel("USD"); ax.grid(alpha=.2); ax2 = ax.twinx(); ax2.plot(dates, dd_pct * 100, color="#a33131", lw=.8); ax2.set_ylabel("% of running peak")
    ax = fig.add_subplot(grid[1, 1]); r = daily["net_pnl_usd"].to_numpy() / INITIAL_CASH
    rolling = np.full(len(r), np.nan)
    if len(r) >= 63:
        windows = np.lib.stride_tricks.sliding_window_view(r, 63)
        rolling[62:] = windows.mean(1) / windows.std(1, ddof=1) * np.sqrt(252)
    ax.plot(dates, rolling, color="#47845c", lw=1); ax.axhline(0, color="#888", lw=.8); ax.set_title("63-calendar-day rolling Sharpe", loc="left", weight="bold"); ax.grid(alpha=.2)
    ax = fig.add_subplot(grid[2, 0]); piv = monthly.with_columns(
        pl.col("month").str.slice(0, 4).cast(pl.Int32).alias("year"), pl.col("month").str.slice(5, 2).cast(pl.Int32).alias("month_num")
    ).pivot(on="month_num", index="year", values="net_pnl_usd", aggregate_function="sum").sort("year")
    matrix = np.full((piv.height, 12), np.nan)
    for ri, row in enumerate(piv.iter_rows(named=True)):
        for month_num in range(1,13):
            key = str(month_num)
            if key in row and row[key] is not None: matrix[ri, month_num-1] = row[key]
    maxabs = np.nanmax(np.abs(matrix)) if np.isfinite(matrix).any() else 1
    ax.imshow(matrix, aspect="auto", cmap="RdYlGn", vmin=-maxabs, vmax=maxabs)
    ax.set_yticks(range(piv.height), piv["year"].to_list()); ax.set_xticks(range(12), ["J","F","M","A","M","J","J","A","S","O","N","D"])
    ax.set_title("Monthly net PnL heatmap (USD)", loc="left", weight="bold")
    ax = fig.add_subplot(grid[2, 1]); years = [r["year"] for r in annual]; pnls = [r["net_pnl_usd"] for r in annual]
    ax.bar(years, pnls, color=["#2c8b57" if x >= 0 else "#cf5b5b" for x in pnls]); ax.axhline(0, color="#555", lw=.8); ax.set_title("Annual net PnL (USD)", loc="left", weight="bold"); ax.grid(axis="y", alpha=.2)
    fig.suptitle(f"One-bar NQ 30m | 2013–2026 | {metrics['trial']}", x=.06, ha="left", fontsize=18, weight="bold")
    fig.text(.06, .015, "BID-only Dukascopy USATECH index/CFD proxy; one hypothetical $20/point contract. Realized cash-flow curves are not marked-to-market.", fontsize=9, color="#465365")
    fig.savefig(output, dpi=180, bbox_inches="tight"); plt.close(fig)


def write_report(trial_results: dict[str, tuple[dict, pl.DataFrame, pl.DataFrame, list[dict]]]) -> None:
    OUT.mkdir(parents=True, exist_ok=True)
    selected = "native_full_tick_cost"
    metrics, daily, monthly, annual = trial_results[selected]
    gross_annual = trial_results["native_zero_cost"][3]
    payload = {"classification": "EXPLORATORY retrospective; NOT_APPROVED", "selected_cost_trial": selected,
               "source": "promote/one_bar_nq_30m/backtests/practical_yearly/by_year/YYYY/native_*_cost/evaluation_trades.csv",
               "methodology": {"analytics_library": "ml4t.backtest.analytics and ml4t.diagnostic.api.PortfolioAnalysis",
                   "library_versions": {name: version(name) for name in ("ml4t-backtest", "ml4t-diagnostic", "polars")},
                   "official_skills": {
                       "revision": "ml4t/skills main tree f0ea019e0c517cd9b1e014724a520facd8a742",
                       "ml4t-tearsheet": "backtest/tearsheet/SKILL.md",
                       "ml4t-risk-metrics": "portfolio/risk-metrics/SKILL.md",
                       "ml4t-polars-patterns": "infrastructure/polars-patterns/SKILL.md",
                       "ml4t-run-backtest": "backtest/run-backtest/SKILL.md",
                       "local_discovery": "Requested skills were absent locally; official upstream files were read with TinyFish.",
                   },
                   "daily_cashflow_aggregation": "Polars",
                   "rf_annual": 0.0, "annualization": 252, "daily_calendar": "Calendar days from first to last evaluation exit; no-exit dates have zero realized PnL.",
                   "open_position_marking": False, "buy_hold_benchmark": "unavailable"},
               "metrics": {name: item[0] for name,item in trial_results.items()}, "annual_full_tick_cost": annual,
               "annual_zero_cost": gross_annual,
               "limitations": ["BID-only Dukascopy CFD/index proxy, not dated CME NQ futures.", "Synthetic 1m assigned cash is a return scaling base, not verified margin/capital.", "Realized trade cash flows omit open-position mark-to-market and cannot establish native equity drawdown.", "No buy-and-hold series was bundled; benchmark omitted.", "Costs are modeled assumptions, not broker/exchange certified costs.", "2026 evaluation ends 2026-07-14; later observations remain protected.", "Ambiguous minute OHLC path and atomic OCO behavior remain unresolved."]}
    payload["verification"] = {
        "annual_evaluation_trade_counts_and_net_pnl_match_year_summaries": True,
        "annual_net_pnl_matches_recovery_audit": True,
        "recovery_audit_status": "passed",
        "annual_year_range_inclusive": [2013, 2026],
        "annual_accounts_reset_each_year": True,
        "cross_year_equity_is_report_only_realized_cashflow_reconstruction": True,
        "backtest_rerun": False,
        "sha256_package_manifest_refreshed": True,
    }
    (OUT / "metrics.json").write_text(json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n")
    daily.write_csv(OUT / "daily_equity.csv")
    monthly.write_csv(OUT / "monthly_pnl.csv")
    render(metrics, daily, monthly, annual, OUT / "one_bar_nq_tearsheet_2013_2026.png")
    zero_by_year = {row["year"]: row for row in trial_results["native_zero_cost"][3]}
    rows = ["| Year | Trades | Zero-cost PnL (USD) | Costed gross before commission (USD) | Costed net PnL (USD) | Net/trade (USD) |", "|---:|---:|---:|---:|---:|---:|"]
    for row in annual:
        rows.append(f"| {row['year']} | {row['trades']} | {zero_by_year[row['year']]['net_pnl_usd']:,.2f} | {row['gross_pnl_usd']:,.2f} | {row['net_pnl_usd']:,.2f} | {row['net_per_trade_usd']:,.2f} |")
    c = metrics
    md = f"""# One-bar NQ 30-minute strategy tearsheet, 2013–2026

**Status:** Exploratory retrospective report. The strategy remains `NOT_APPROVED`. This report does not approve live trading.

## Data and method

The report reads the completed annual `evaluation_trades.csv` ledgers from 2013 through 2026. It uses evaluation trades only and excludes warmup and duplicated boundary trades. PnL uses one hypothetical contract at $20 per index point. The source is Dukascopy `USATECH.IDX/USD` BID-only index/CFD data. It is not a dated CME NQ contract.

The costed trial models $2.50 per fill and 0.25 adverse index points per fill. Its ledger `gross_pnl` includes modeled slippage in execution prices and excludes commissions. Its `pnl` is net of both. The zero-cost trial provides a separate aggregate comparison. Some trades have different exit timestamps across cost variants, so the trials are not matched row by row. Annual engine accounts reset to $1,000,000; this report separately reconstructs cumulative realized cash flows across years. The report uses installed `ml4t.backtest.analytics` for Sharpe, Sortino, maximum drawdown, CAGR, and Calmar calculations. Polars aggregates exit-date cash flows. Daily returns use a synthetic $1,000,000 assigned base, zero risk-free rate, 252 annualization periods, and calendar days between the first and last exit. Dates without trade exits have zero realized PnL.

The plotted curves and drawdown metrics use realized trade cash flows. They do not mark open positions each day and are not native engine mark-to-market equity. The $1,000,000 base is only a scaling convention. It is not verified margin or account capital. No comparable buy-and-hold close series is included, so this report omits the benchmark.

## Costed trial metrics

| Metric | Value |
|---|---:|
| Closed evaluation trades | {c['closed_trades']:,} |
| Zero-cost trial PnL | ${c['gross_pnl_usd_zero_cost_trial']:,.2f} |
| Costed gross PnL before commission (slippage remains in fills) | ${c['gross_pnl_before_commission_usd']:,.2f} |
| Net PnL | ${c['net_pnl_usd']:,.2f} |
| Commission drag within costed trial | ${c['commission_drag_gross_to_net_usd']:,.2f} |
| Total difference versus zero-cost trial | ${c['total_cost_drag_vs_zero_cost_trial_usd']:,.2f} |
| Net PnL per trade | ${c['net_per_trade_usd']:,.2f} |
| Trade win rate | {c['trade_win_rate']:.1%} |
| Profit factor | {c['profit_factor']:.3f} |
| Net daily Sharpe (252, RF 0) | {c['sharpe_daily_252_rf0']:.3f} |
| Net daily Sortino | {c['sortino_daily_252_rf0']:.3f} |
"""Focused checks for the annual-ledger tearsheet aggregation."""
import importlib.util
from pathlib import Path

SCRIPT = Path(__file__).resolve().parents[1] / "scripts/generate_tearsheet.py"
SPEC = importlib.util.spec_from_file_location("one_bar_tearsheet", SCRIPT)
REPORT = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(REPORT)


def test_completed_ledgers_reconcile_to_annual_and_summary_totals():
    REPORT.verify_recovery_audit()
    zero = REPORT.load_ledgers("native_zero_cost")
    costed = REPORT.load_ledgers("native_full_tick_cost")
    zero_stats, _, _, _ = REPORT.summarize(zero, "native_zero_cost")
    costed_stats, _, _, costed_annual = REPORT.summarize(costed, "native_full_tick_cost")

    assert zero_stats["closed_trades"] == costed_stats["closed_trades"] == 5462
    assert abs(zero_stats["net_pnl_usd"] - 247566.38) < 0.01
    assert abs(costed_stats["net_pnl_usd"] - 166107.92) < 0.01
    annual = {row["year"]: row for row in costed_annual}
    assert abs(annual[2026]["net_pnl_usd"] - (-14166.96)) < 0.01
    assert sum(row["trades"] for row in costed_annual) == 5462


def test_daily_cashflow_series_includes_no_exit_days_and_cash_base():
    frame = REPORT.load_ledgers("native_full_tick_cost")
    metrics, daily, _, _ = REPORT.summarize(frame, "native_full_tick_cost")
    exit_dates = frame.with_columns(REPORT.pl.col("exit_time").cast(REPORT.pl.Datetime).dt.date().alias("date"))["date"].n_unique()
    assert daily.height > exit_dates
    assert daily["net_realized_equity_usd"][-1] == pytest.approx(1_000_000 + metrics["net_pnl_usd"])
    assert metrics["drawdown_basis"].startswith("Daily realized trade cash flows")


import pytest
#!/usr/bin/env python3
"""Copy immutable one-bar evidence and completed annual slices into this package."""
from __future__ import annotations

import hashlib
import json
import shutil
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
PACKAGE = Path(__file__).resolve().parents[1]


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def copy_file(source: Path, destination: Path, records: dict[str, dict]) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    before = sha256(source)
    shutil.copy2(source, destination)
    copied = sha256(destination)
    after = sha256(source)
    if before != copied or copied != after:
        destination.unlink(missing_ok=True)
        raise RuntimeError(f"Source changed while copying: {source}")
    records[destination.relative_to(PACKAGE).as_posix()] = {
        "sha256": copied,
        "source": source.relative_to(ROOT).as_posix(),
        "source_sha256": after,
    }


def copy_tree(source: Path, destination: Path, records: dict[str, dict]) -> None:
    for path in sorted(source.rglob("*")):
        if any(part.startswith("superseded_") for part in path.relative_to(source).parts):
            continue
        if not path.is_file() or path.suffix in {".log", ".sh"} or path.name in {"agent.log", "timing_agent.log"}:
            continue
        copy_file(path, destination / path.relative_to(source), records)


def completed_years(ledger: dict) -> list[int]:
    running = next((item for item in ledger.get("attempts", [])
                    if item.get("years") and item.get("status") in {"RUNNING", "completed", "COMPLETED"}), None)
    years = []
    if running is None:
        return years
    for item in running.get("years", []):
        year = item.get("year")
        names = {trial.get("name"): trial.get("status") for trial in item.get("trials", [])}
        source = ROOT / "run_log/one_bar_practical_1m_20261012/by_year" / str(year)
        summary = source / "year_summary.json"
        if (item.get("status") == "completed" and names.get("native_zero_cost") == "completed"
                and names.get("native_full_tick_cost") == "completed" and summary.is_file()
                and json.loads(summary.read_text()).get("status") == "completed"):
            required = [source / trial / filename for trial in ("native_zero_cost", "native_full_tick_cost")
                        for filename in ("metrics.json", "trades.csv", "fills.csv", "daily_equity.csv")]
            if all(path.is_file() for path in required):
                years.append(int(year))
    return years


def main() -> None:
    records: dict[str, dict] = {}
    source_files = {
        "src/run_one_bar_50breakout_20261011.py": "scripts/run_one_bar_50breakout_20261011.py",
        "src/run_one_bar_dukascopy_2013_2026_20261011.py": "scripts/run_one_bar_dukascopy_2013_2026_20261011.py",
        "src/run_one_bar_dukascopy_phase567_20261011.py": "scripts/run_one_bar_dukascopy_phase567_20261011.py",
        "src/run_one_bar_execution_remediation_20261012.py": "scripts/run_one_bar_execution_remediation_20261012.py",
        "src/run_one_bar_practical_1m_20261012.py": "scripts/run_one_bar_practical_1m_20261012.py",
        "src/run_one_bar_practical_yearly_20261012.py": "scripts/run_one_bar_practical_yearly_20261012.py",
        "tests/test_one_bar_50breakout_20261011.py": "tests/test_one_bar_50breakout_20261011.py",
        "tests/test_one_bar_dukascopy_2013_2026_20261011.py": "tests/test_one_bar_dukascopy_2013_2026_20261011.py",
        "tests/test_one_bar_dukascopy_phase567_20261011.py": "tests/test_one_bar_dukascopy_phase567_20261011.py",
        "tests/test_one_bar_execution_remediation_20261012.py": "tests/test_one_bar_execution_remediation_20261012.py",
        "tests/test_one_bar_practical_yearly_20261012.py": "tests/test_one_bar_practical_yearly_20261012.py",
    }
    for target, original in source_files.items():
        copy_file(ROOT / original, PACKAGE / target, records)

    runs = {
        "backtests/lse_2026": "run_log/one_bar_50breakout_20261011",
        "backtests/dukascopy_long_history": "run_log/one_bar_dukascopy_2013_2026_20261011",
        "backtests/phase567": "run_log/one_bar_dukascopy_phase567_20261011",
        "backtests/remediation": "run_log/one_bar_execution_remediation_20261012",
    }
    for target, original in runs.items():
        copy_tree(ROOT / original, PACKAGE / target, records)

    yearly_root = ROOT / "run_log/one_bar_practical_1m_20261012"
    ledger = json.loads((yearly_root / "trial_ledger.json").read_text())
    for name in ("frozen_spec.json", "recovery_spec.json", "trial_ledger.json"):
        path = yearly_root / name
        if path.is_file():
            copy_file(path, PACKAGE / "backtests/practical_yearly" / name, records)
    for relative in ("validation", "errors"):
        for path in (yearly_root / relative).rglob("*"):
            if path.is_file():
                copy_file(path, PACKAGE / "backtests/practical_yearly" / path.relative_to(yearly_root), records)
    for year in completed_years(ledger):
        copy_tree(yearly_root / "by_year" / str(year), PACKAGE / "backtests/practical_yearly/by_year" / str(year), records)

    for original in (
        "docs/audit/one_bar_50breakout_20261011_plan.md",
        "docs/audit/one_bar_50breakout_20261011_independent_review.md",
        "docs/audit/one_bar_dukascopy_2013_2026_20261011.md",
        "docs/audit/one_bar_dukascopy_2013_2026_20261011_independent_review.md",
        "docs/audit/one_bar_dukascopy_phase567_20261011.md",
        "docs/audit/one_bar_dukascopy_phase567_20261011_independent.md",
        "docs/audit/one_bar_execution_remediation_20261012.md",
        "run_log/one_bar_50breakout_20261011_mission.md",
        "run_log/one_bar_dukascopy_2013_2026_20261011_mission.md",
        "run_log/one_bar_dukascopy_phase567_20261011_mission.md",
        "run_log/one_bar_execution_remediation_20261012_mission.md",
        "run_log/one_bar_execution_remediation_20261012_timing_review.md",
        "run_log/one_bar_practical_1m_20261012_mission.md",
        "run_log/one_bar_practical_1m_20261012_recovery_mission.md",
    ):
        source = ROOT / original
        if source.is_file():
            copy_file(source, PACKAGE / "audits" / Path(original).name, records)

    for path in sorted(PACKAGE.rglob("*")):
        if path.is_file() and path.relative_to(PACKAGE).as_posix() not in records and path.name != "manifest.json":
            records[path.relative_to(PACKAGE).as_posix()] = {"sha256": sha256(path), "source": None}
    manifest = {
        "created_at_utc": datetime.now(timezone.utc).isoformat(),
        "source_git_head": __import__("subprocess").check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
        "package_root": "promote/one_bar_nq_30m",
        "file_count_excluding_manifest": len(records),
        "files": records,
        "external_references": {
            "canonical_market_data": "/home/quant/dev/quant/ml4t-data/.data/store/index_minute_NQ",
            "excluded_superseded_attempts": [
                "run_log/one_bar_dukascopy_2013_2026_20261011/superseded_wall_clock_attempt",
                "run_log/one_bar_dukascopy_phase567_20261011/superseded_duplicate_oco_diagnostics",
                "run_log/one_bar_dukascopy_phase567_20261011/superseded_pre_oco_cap_accounting",
            ],
        },
        "copied_completed_practical_years": completed_years(ledger),
    }
    annual_status = ledger.get("status", "UNKNOWN")
    active = next((item for item in ledger.get("attempts", [])
                   if item.get("years") and item.get("status") in {"RUNNING", "completed", "COMPLETED"}), None)
    completed = completed_years(ledger)
    pending = [year for year in range(2013, 2027) if year not in completed]
    status_text = (
        "# Packaging status snapshot\n\n"
        f"Captured at {datetime.now(timezone.utc).isoformat()}. The source annual ledger status is `{annual_status}`.\n\n"
        f"Annual trial: `{active.get('trial_id') if active else 'none'}` (`{active.get('status') if active else 'unknown'}`).\n\n"
        f"Completed annual outputs copied: {', '.join(map(str, completed)) or 'none'}. Each copied year has a completed summary and both completed trial ledgers.\n\n"
        f"Years not copied: {', '.join(map(str, pending)) or 'none'}. The package excludes every year without a completed summary and both complete trial output sets.\n\n"
        "The canonical yearly runner and output directory were not edited or moved. Re-run `python promote/one_bar_nq_30m/scripts/refresh_completed_runs.py` after completion to add newly completed years.\n"
    )
    (PACKAGE / "STATUS.md").write_text(status_text)
    records["STATUS.md"] = {"sha256": sha256(PACKAGE / "STATUS.md"), "source": None}
    (PACKAGE / "provenance").mkdir(exist_ok=True)
    (PACKAGE / "provenance/manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    print(f"Copied {len(records)} files; annual completed years: {manifest['copied_completed_practical_years']}")


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Verify package structure, YAML syntax, and content hashes."""
from __future__ import annotations

import hashlib
import json
from pathlib import Path

PACKAGE = Path(__file__).resolve().parents[1]
REQUIRED = [
    "README.md", "STATUS.md", "strategy.yaml", "config/backtest.yaml",
    "config/research_status.yaml", "data/data_manifest.json", "src",
    "tests", "backtests/lse_2026", "backtests/dukascopy_long_history",
    "backtests/phase567", "backtests/remediation", "backtests/practical_yearly",
    "audits", "provenance/manifest.json",
]


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def main() -> None:
    missing = [entry for entry in REQUIRED if not (PACKAGE / entry).exists()]
    if missing:
        raise SystemExit(f"Missing required package entries: {missing}")
    try:
        import yaml
    except ImportError as error:
        raise SystemExit("PyYAML is required to validate package YAML") from error
    for name in ("strategy.yaml", "config/backtest.yaml", "config/research_status.yaml"):
        with (PACKAGE / name).open() as stream:
            if yaml.safe_load(stream) is None:
                raise SystemExit(f"Empty YAML: {name}")
    manifest = json.loads((PACKAGE / "provenance/manifest.json").read_text())
    failures = []
    for relative, record in manifest["files"].items():
        path = PACKAGE / relative
        if not path.is_file() or sha256(path) != record["sha256"]:
            failures.append(relative)
    if failures:
        raise SystemExit(f"SHA256 verification failed: {failures}")
    if len(manifest["files"]) != manifest["file_count_excluding_manifest"]:
        raise SystemExit("Manifest file count mismatch")
    print(f"Verified {len(manifest['files'])} package files and 3 YAML files.")


if __name__ == "__main__":
    main()
