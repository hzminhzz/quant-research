+        for chunk in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def files() -> list[Path]:
+    return sorted(p for p in STORE.glob("year=*/month=*/data.parquet")
