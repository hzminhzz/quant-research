+            continue
+        year_checks = {"year": year, "status": "passed", "trials": []}
+        for trial in summary["trials"]:
+            name = trial["name"]
+            path = year_dir / name
+            closed = pl.read_csv(path / "evaluation_trades.csv", try_parse_dates=True).filter(
+                pl.col("status") == "closed")
