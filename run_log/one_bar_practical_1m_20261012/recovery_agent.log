+            audit["errors"].append(f"{year}: warmup has fewer than 80 complete bars")
+        summary_path.write_text(json.dumps(summary, indent=2) + "\n")
+        audit["years"].append(year_checks)
+
+    # Compare the final two warmup weeks across adjacent Engine shards. This
+    # checks that New Year positions and fills reconstruct from native history.
+    for year in range(FIRST_YEAR, LAST_YEAR):
+        left = OUT / "by_year" / str(year)
+        right = OUT / "by_year" / str(year + 1)
+        for name in ("native_zero_cost", "native_full_tick_cost"):
+            left_trades = pl.read_csv(left / name / "trades.csv", try_parse_dates=True)
+            right_trades = pl.read_csv(right / name / "trades.csv", try_parse_dates=True)
+            lower = datetime(year, 12, 22, tzinfo=timezone.utc)
+            left_overlap = left_trades.filter(pl.col("entry_time") >= lower).select(
+                "entry_time", "exit_time", "pnl").sort("entry_time")
+            right_overlap = right_trades.filter(pl.col("entry_time") >= lower).select(
+                "entry_time", "exit_time", "pnl").sort("entry_time")
+            # The next shard needs 50 bars after its Dec 18 input boundary.
+            # Compare only after that warmup has matured.
+            upper = datetime(year + 1, 1, 1, tzinfo=timezone.utc)
+            left_overlap = left_overlap.filter(pl.col("entry_time") < upper)
+            right_overlap = right_overlap.filter(pl.col("entry_time") < upper)
+            same = left_overlap.equals(right_overlap, null_equal=True)
+            boundary = {"from_year": year, "to_year": year + 1, "trial": name,
+                "warmup_trade_rows_left": left_overlap.height,
+                "warmup_trade_rows_right": right_overlap.height, "reconciled": same}
+            audit["boundary_overlaps"].append(boundary)
+            if not same:
+                audit["errors"].append(f"{year}/{name}: adjacent-year warmup trades differ")
+    if exit_timing_rows:
+        mismatches = pl.DataFrame(exit_timing_rows).with_columns(
+            (pl.col("expected_exit_time") - pl.duration(minutes=1)).alias("prior_minute"))
+        source_times = (pl.scan_parquet([str(p) for p in paths])
+            .filter(pl.col("timestamp").dt.date().is_between(date(2013, 1, 1), DATA_END))
+            .select(pl.col("timestamp").dt.replace_time_zone("UTC").alias("lookup_time"))
+            .unique().with_columns(pl.lit(True).alias("source_print_exists")))
+        lookups = pl.concat([
+            mismatches.select(pl.col("expected_exit_time").alias("lookup_time"))
+                .unique().with_columns(pl.lit("boundary").alias("lookup_kind")),
+            mismatches.select(pl.col("prior_minute").alias("lookup_time"))
+                .unique().with_columns(pl.lit("prior_minute").alias("lookup_kind")),
+        ]).lazy().join(source_times, on="lookup_time", how="left").collect(engine="streaming")
+        presence = {(row["lookup_kind"], row["lookup_time"]): bool(row["source_print_exists"])
+                    for row in lookups.to_dicts()}
+        events = []
+        for row in exit_timing_rows:
+            boundary_exists = presence.get(("boundary", row["expected_exit_time"]), False)
+            prior_exists = presence.get(("prior_minute", row["expected_exit_time"] - timedelta(minutes=1)), False)
+            events.append({"year": row["year"], "trial": row["trial"],
+                "entry_time": row["entry_time"].isoformat(),
+                "expected_boundary": row["expected_exit_time"].isoformat(),
+                "actual_exit": row["exit_time"].isoformat(),
+                "boundary_source_minute_exists": boundary_exists,
+                "prior_submission_minute_exists": prior_exists,
+                "delay_minutes": int((row["exit_time"] - row["expected_exit_time"]).total_seconds() // 60)})
+        cost_events = [event for event in events if event["trial"] == "native_full_tick_cost"]
+        exit_timing = {"status": "documented_deviation" if cost_events else "passed",
+            "late_scheduled_market_exits": len(cost_events),
+            "boundary_source_minute_exists": sum(x["boundary_source_minute_exists"] for x in cost_events),
+            "boundary_source_minute_missing": sum(not x["boundary_source_minute_exists"] for x in cost_events),
+            "boundary_exists_but_prior_submission_minute_missing": sum(
+                x["boundary_source_minute_exists"] and not x["prior_submission_minute_exists"] for x in cost_events),
+            "max_delay_minutes": max((x["delay_minutes"] for x in cost_events), default=0),
+            "native_engine_limit": "NEXT_BAR market orders require a prior source event to submit. The native Strategy cannot submit at the opening timestamp and fill at that same open.",
+            "events": cost_events}
+        audit["exit_timing"] = exit_timing
+        timing_path = OUT / "validation/exit_timing_audit.json"
+        timing_path.parent.mkdir(parents=True, exist_ok=True)
+        timing_path.write_text(json.dumps(exit_timing, indent=2) + "\n")
+    else:
