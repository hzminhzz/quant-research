| 2018 | 424 | $11,194.74 | $26.40 | 1.73 | -0.32% | $11,194.74 |
| 2019 | 405 | $8,552.88 | $21.12 | 1.61 | -0.43% | $8,552.88 |
| 2020 | 437 | $9,284.22 | $21.25 | 0.86 | -0.77% | $8,269.22 |
