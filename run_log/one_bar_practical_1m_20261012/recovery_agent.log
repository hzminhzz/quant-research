+                for row in native.get("ambiguous_examples", []):
+                    ts = datetime.fromisoformat(row["timestamp"])
+                    if _entry_year(ts) == year:
+                        event_kinds[ts] = row.get("kind", "inconclusive")
+                for ts in opposing_times:
