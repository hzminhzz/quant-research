+from datetime import datetime, timezone
+
+from scripts.run_one_bar_practical_yearly_20261012 import (
+    ambiguous_loss_bound,
+    chicago_session_day,
+    eligible_years,
+    next_30m_boundary,
+    with_session_day,
+)
+import polars as pl
+
+
+def test_year_range_covers_2013_through_partial_2026():
+    assert eligible_years() == list(range(2013, 2027))
+
+
+def test_session_assignment_uses_chicago_dst_and_globex_boundary():
+    before_winter_open = datetime(2024, 1, 1, 22, 59, tzinfo=timezone.utc)
+    at_winter_open = datetime(2024, 1, 1, 23, 0, tzinfo=timezone.utc)
+    before_summer_open = datetime(2024, 7, 1, 21, 59, tzinfo=timezone.utc)
+    at_summer_open = datetime(2024, 7, 1, 22, 0, tzinfo=timezone.utc)
+
+    assert str(chicago_session_day(before_winter_open)) == "2023-12-31"
+    assert str(chicago_session_day(at_winter_open)) == "2024-01-01"
+    assert str(chicago_session_day(before_summer_open)) == "2024-06-30"
+    assert str(chicago_session_day(at_summer_open)) == "2024-07-01"
+
+
+def test_polars_session_assignment_does_not_overflow_hour_arithmetic():
+    timestamps = [datetime(2024, 1, 1, 22, 59, tzinfo=timezone.utc),
+                  datetime(2024, 1, 1, 23, 0, tzinfo=timezone.utc),
+                  datetime(2024, 7, 1, 21, 59, tzinfo=timezone.utc),
+                  datetime(2024, 7, 1, 22, 0, tzinfo=timezone.utc)]
+    assigned = with_session_day(pl.DataFrame({"timestamp": timestamps}))
+    assert assigned["session_date"].to_list() == [
+        datetime(2023, 12, 31).date(), datetime(2024, 1, 1).date(),
+        datetime(2024, 6, 30).date(), datetime(2024, 7, 1).date(),
+    ]
+
+
+def test_ambiguous_event_bound_charges_worst_case_and_round_trip_cost():
+    assert ambiguous_loss_bound(500.0,
+        ["entry_and_protective_stop_same_candle", "both_entry_stops_filled"],
+        2.5, 0.25) == -2545.0
+
+
+def test_scheduled_exit_advances_to_next_half_hour_boundary():
+    entry = datetime(2024, 3, 10, 7, 29, tzinfo=timezone.utc)
+    assert next_30m_boundary(entry) == datetime(2024, 3, 10, 7, 30, tzinfo=timezone.utc)

codex
**Recovery completed:** 14 of 14 annual shards ran through the native ML4T Engine, producing 5,462 closed trades in each cost scenario. The independent audit passed, including 26 adjacent-year boundary reconciliations. The result covers 2013-01-01 through 2026-07-14 using the Dukascopy index CFD proxy.

- Zero cost: **$247,566.38** total PnL; **$45.33** average trade.
- Full-tick cost ($2.50 commission and 0.25 points adverse slippage per fill): **$166,107.92** total PnL; **$30.41** average trade.
- The conservative ambiguity diagnostic is **$118,402.92**. No full-period Sharpe is reported because each annual shard resets its account.

The [audit note](/home/quant/dev/quant/quant-research/docs/audit/one_bar_practical_1m_20261012.md) and [final report](/home/quant/dev/quant/quant-research/run_log/one_bar_practical_1m_20261012/final_report.json) record results and limits. The [annual runner](/home/quant/dev/quant/quant-research/scripts/run_one_bar_practical_yearly_20261012.py) and [focused tests](/home/quant/dev/quant/quant-research/tests/test_one_bar_practical_yearly_20261012.py) are in place. The focused tests passed (**5 passed**); no live orders were sent and no commit was made.

**Skipped/not verified:** The optional half-spread sensitivity was not run. The repository-wide pytest suite produced no output and was interrupted after more than four minutes; its result is unknown.

**Risk:** The audit found 98 late scheduled exits, including 19 where the boundary minute existed but native `NEXT_BAR` timing delayed the exit. Results use a CFD proxy and illustrative costs, so they do not establish CME NQ or live execution performance.
