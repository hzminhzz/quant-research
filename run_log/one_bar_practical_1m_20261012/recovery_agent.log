+        zero = next(x for x in summary["trials"] if x["name"] == "native_zero_cost")
+        cost = next(x for x in summary["trials"] if x["name"] == "native_full_tick_cost")
+        observed_drag = zero["net_pnl_usd"] - cost["net_pnl_usd"]
