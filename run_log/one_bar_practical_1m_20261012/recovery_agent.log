+                    ~pl.col("protective_stop_exit") &
+                    (pl.col("exit_time") != pl.col("expected_exit_time"))).height
+                exit_timing_rows.extend({"year": year, "trial": name, **row}
+                    for row in exit_check.filter(~pl.col("protective_stop_exit") &
+                        (pl.col("exit_time") != pl.col("expected_exit_time"))
+                    ).select("entry_time", "expected_exit_time", "exit_time").to_dicts())
+            else:
+                scheduled_exit_mismatches = 0
+            entry_fills = fills.filter((pl.col("order_type") == "stop") & (pl.col("exit_reason") == ""))
