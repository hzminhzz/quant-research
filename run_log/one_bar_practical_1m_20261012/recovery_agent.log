+            trial["evaluation_end_equity_usd"] = ending_equity
+            trial["evaluation_equity_change_usd"] = equity_change
+            trial["initial_margin_per_contract_usd"] = 25_000
+            trial["maintenance_margin_per_contract_usd"] = 20_000
