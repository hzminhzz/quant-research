e, 'prior_submission_minute_exists': False, 'delay_minutes': 91}, {'year': 2023, 'trial': 'native_full_tick_cost', 'entry_time': '2023-08-16T23:34:00+00:00', 'expected_boundary': '2023-08-17T00:00:00+00:00', 'actual_exit': '2023-08-18T00:00:00+00:00', 'boundary_source_minute_exists': False, 'prior_submission_minute_exists': True, 'delay_minutes': 1440}, {'year': 2023, 'trial': 'native_full_tick_cost', 'entry_time': '2023-09-20T20:00:00+00:00', 'expected_boundary': '2023-09-20T20:30:00+00:00', 'actual_exit': '2023-09-20T22:01:00+00:00', 'boundary_source_minute_exists': False, 'prior_submission_minute_exists': False, 'delay_minutes': 91}, {'year': 2023, 'trial': 'native_full_tick_cost', 'entry_time': '2023-10-11T20:01:00+00:00', 'expected_boundary': '2023-10-11T20:30:00+00:00', 'actual_exit': '2023-10-11T22:01:00+00:00', 'boundary_source_minute_exists': False, 'prior_submission_minute_exists': False, 'delay_minutes': 91}, {'year': 2024, 'trial': 'native_full_tick_cost', 'entry_time': '2024-02-01T21:05:00+00:00', 'expected_boundary': '2024-02-01T21:30:00+00:00', 'actual_exit': '2024-02-01T23:01:00+00:00', 'boundary_source_minute_exists': False, 'prior_submission_minute_exists': False, 'delay_minutes': 91}, {'year': 2024, 'trial': 'native_full_tick_cost', 'entry_time': '2024-03-04T21:00:00+00:00', 'expected_boundary': '2024-03-04T21:30:00+00:00', 'actual_exit': '2024-03-04T23:01:00+00:00', 'boundary_source_minute_exists': False, 'prior_submission_minute_exists': False, 'delay_minutes': 91}, {'year': 2024, 'trial': 'native_full_tick_cost', 'entry_time': '2024-05-29T23:30:00+00:00', 'expected_boundary': '2024-05-30T00:00:00+00:00', 'actual_exit': '2024-05-31T00:00:00+00:00', 'boundary_source_minute_exists': False, 'prior_submission_minute_exists': True, 'delay_minutes': 1440}, {'year': 2025, 'trial': 'native_full_tick_cost', 'entry_time': '2025-01-21T21:02:00+00:00', 'expected_boundary': '2025-01-21T21:30:00+00:00', 'actual_exit': '2025-01-21T23:01:00+00:00', 'boundary_so