+                (path / "evaluation_metrics.json").write_text(json.dumps(evaluation_metrics, indent=2) + "\n")
+                (year_dir / "ambiguity_report.json").write_text(json.dumps({"year": year,
+                    "events": [{"timestamp": ts.isoformat(), "kind": kind,
