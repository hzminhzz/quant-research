+                opposing_times = opposing_rows["timestamp"].to_list()
+            else:
+                max_daily = opposing = 0
+                opposing_times = []
+            summary_pnl = float(trial["net_pnl_usd"])
+            if abs(pnl - summary_pnl) > 1e-6:
