+            "boundary_source_minute_exists": sum(x["boundary_source_minute_exists"] for x in cost_events),
+            "boundary_source_minute_missing": sum(not x["boundary_source_minute_exists"] for x in cost_events),
+            "boundary_exists_but_prior_submission_minute_missing": sum(
+                x["boundary_source_minute_exists"] and not x["prior_submission_minute_exists"] for x in cost_events),
+            "max_delay_minutes": max((x["delay_minutes"] for x in cost_events), default=0),
+            "native_engine_limit": "NEXT_BAR market orders require a prior source event to submit. The native Strategy cannot submit at the opening timestamp and fill at that same open.",
+            "events": cost_events}
+        audit["exit_timing"] = exit_timing
+        timing_path = OUT / "validation/exit_timing_audit.json"
+        timing_path.parent.mkdir(parents=True, exist_ok=True)
+        timing_path.write_text(json.dumps(exit_timing, indent=2) + "\n")
+    else:
+        audit["exit_timing"] = {"status": "passed", "late_scheduled_market_exits": 0}
+    audit["status"] = "passed" if not audit["errors"] else "failed"
+    path = OUT / "validation/recovery_audit.json"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(audit, indent=2) + "\n")
+    final_path = OUT / "final_report.json"
+    if final_path.exists():
+        final = json.loads(final_path.read_text())
+        all_annual = []
+        for item in audit["years"]:
+            year_summary = json.loads((OUT / "by_year" / str(item["year"]) / "year_summary.json").read_text())
+            all_annual.extend({"year": item["year"], **trial} for trial in year_summary["trials"])
+        results = {}
+        for name in ("native_zero_cost", "native_full_tick_cost"):
+            selected = [row for row in all_annual if row["name"] == name]
+            pnl = sum(row["net_pnl_usd"] for row in selected)
+            trades = sum(row["closed_trades"] for row in selected)
+            results[name] = {"closed_trades": trades, "net_pnl_usd": pnl,
+                "average_trade_pnl_usd": pnl / trades if trades else None,
+                "conservative_ambiguous_bound_usd": sum(row.get("conservative_ambiguous_bound_usd", row["net_pnl_usd"])
+                    for row in selected) if name == "native_full_tick_cost" else None,
+                "annual_results": [{k: row.get(k) for k in ("year", "closed_trades", "net_pnl_usd",
+                    "average_trade_pnl_usd", "native_daily_equity_sharpe_utc",
+                    "native_daily_equity_max_drawdown_utc", "conservative_ambiguous_bound_usd",
+                    "ambiguous_event_count", "ambiguous_event_kinds")} for row in selected]}
+        final["trial_results"] = results
+        final["annual_trade_results"] = all_annual
+        all_events = [event for year in eligible_years()
+            for event in json.loads((OUT / "by_year" / str(year) / "ambiguity_report.json").read_text()).get("events", [])]
+        final["ambiguity_summary"] = {"event_count": len(all_events),
+            "event_kinds": dict(__import__("collections").Counter(x["kind"] for x in all_events)),
+            "events": all_events, "bound_is_native_replay": False}
+        final["execution_timing"] = audit["exit_timing"]
+        final["independent_reconciliation"] = audit
+        final["status"] = ("completed_with_documented_timing_deviation"
+            if audit["exit_timing"].get("late_scheduled_market_exits", 0)
+            else "completed") if audit["status"] == "passed" else "completed_with_audit_errors"
+        final_path.write_text(json.dumps(final, indent=2, default=str) + "\n")
+        ledger_path = OUT / "trial_ledger.json"
+        ledger = json.loads(ledger_path.read_text())
+        attempt = next(x for x in ledger["attempts"] if x.get("trial_id") == "RESHARD-ANNUAL-20261012")
+        attempt["years"] = [json.loads((OUT / "by_year" / str(y) / "year_summary.json").read_text())
+                            for y in eligible_years()]
+        ledger_path.write_text(json.dumps(ledger, indent=2) + "\n")
+        manifest_path = OUT / "manifest.json"
+        manifest = json.loads(manifest_path.read_text()) if manifest_path.exists() else {}
+        manifest["year_summary_hashes"] = {str(y): sha256(OUT / "by_year" / str(y) / "year_summary.json")
+                                           for y in eligible_years()}
+        manifest["independent_reconciliation"] = audit["status"]
+        manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")
+    return audit
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--year", type=int)
+    parser.add_argument("--audit", action="store_true")
+    args = parser.parse_args()
+    if args.audit:
+        print(json.dumps(audit_completed(), indent=2))
+    elif args.year is None:
+        run_batch()
+    else:
+        # Ensure local repository scripts are importable in this isolated process.
+        sys.path.insert(0, str(ROOT / "scripts"))
+        result = run_year(args.year)
+        (OUT / "by_year" / str(args.year) / "worker_summary.json").write_text(json.dumps(result, indent=2, default=str) + "\n")
+        print(json.dumps(result, default=str), flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_one_bar_practical_yearly_20261012.py b/tests/test_one_bar_practical_yearly_20261012.py
new file mode 100644
index 0000000000000000000000000000000000000000..506712062fea10cd1c1e94aeb5af89ea15475129
--- /dev/null
+++ b/tests/test_one_bar_practical_yearly_20261012.py
@@ -0,0 +1,49 @@
+from datetime import datetime, timezone
+
+from scripts.run_one_bar_practical_yearly_20261012 import (
+    ambiguous_loss_bound,
+    chicago_session_day,
+    eligible_years,
+    next_30m_boundary,
+    with_session_day,
+)
+import polars as pl
+
+
+def test_year_range_covers_2013_through_partial_2026():
+    assert eligible_years() == list(range(2013, 2027))
+
+
+def test_session_assignment_uses_chicago_dst_and_globex_boundary():
+    before_winter_open = datetime(2024, 1, 1, 22, 59, tzinfo=timezone.utc)
+    at_winter_open = datetime(2024, 1, 1, 23, 0, tzinfo=timezone.utc)
+    before_summer_open = datetime(2024, 7, 1, 21, 59, tzinfo=timezone.utc)
+    at_summer_open = datetime(2024, 7, 1, 22, 0, tzinfo=timezone.utc)
+
+    assert str(chicago_session_day(before_winter_open)) == "2023-12-31"
+    assert str(chicago_session_day(at_winter_open)) == "2024-01-01"
+    assert str(chicago_session_day(before_summer_open)) == "2024-06-30"
+    assert str(chicago_session_day(at_summer_open)) == "2024-07-01"
+
+
+def test_polars_session_assignment_does_not_overflow_hour_arithmetic():
+    timestamps = [datetime(2024, 1, 1, 22, 59, tzinfo=timezone.utc),
+                  datetime(2024, 1, 1, 23, 0, tzinfo=timezone.utc),
+                  datetime(2024, 7, 1, 21, 59, tzinfo=timezone.utc),
+                  datetime(2024, 7, 1, 22, 0, tzinfo=timezone.utc)]
+    assigned = with_session_day(pl.DataFrame({"timestamp": timestamps}))
+    assert assigned["session_date"].to_list() == [
+        datetime(2023, 12, 31).date(), datetime(2024, 1, 1).date(),
+        datetime(2024, 6, 30).date(), datetime(2024, 7, 1).date(),
+    ]
+
+
+def test_ambiguous_event_bound_charges_worst_case_and_round_trip_cost():
+    assert ambiguous_loss_bound(500.0,
+        ["entry_and_protective_stop_same_candle", "both_entry_stops_filled"],
+        2.5, 0.25) == -2545.0
+
+
+def test_scheduled_exit_advances_to_next_half_hour_boundary():
+    entry = datetime(2024, 3, 10, 7, 29, tzinfo=timezone.utc)
+    assert next_30m_boundary(entry) == datetime(2024, 3, 10, 7, 30, tzinfo=timezone.utc)

