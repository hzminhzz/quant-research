+    (OUT / "validation/source_coverage.json").write_text(json.dumps(coverage, indent=2) + "\n")
+    for year in eligible_years():
+        year_dir = OUT / "by_year" / str(year)
+        summary_path = year_dir / "year_summary.json"
+        if not summary_path.exists():
