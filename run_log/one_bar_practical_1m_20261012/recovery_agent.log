+                event_kinds = {ts: event_kinds[ts] for ts in sorted(event_kinds)}
+                bound = ambiguous_loss_bound(pnl, list(event_kinds.values()), 2.5, 0.25)
+                trial["ambiguous_event_count"] = len(event_kinds)
