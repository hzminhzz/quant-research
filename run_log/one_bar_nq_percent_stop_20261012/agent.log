+
+def _trade_objects(frame: pl.DataFrame) -> list[Trade]:
+    rows = frame.filter(pl.col("status") == "closed").to_dicts()
+    return [Trade(symbol=row["symbol"], entry_time=row["entry_time"], exit_time=row["exit_time"],
+        entry_price=float(row["entry_price"]), exit_price=float(row["exit_price"]),
+        quantity=float(row["quantity"]), pnl=float(row["pnl"]), pnl_percent=float(row["pnl_percent"]),
+        bars_held=int(row["bars_held"]), fees=float(row.get("fees") or 0.0),
+        exit_slippage=float(row.get("exit_slippage") or 0.0),
+        exit_reason=str(row.get("exit_reason") or "signal"), status="closed",
+        entry_slippage=float(row.get("entry_slippage") or 0.0),
+        multiplier=float(row.get("multiplier") or 20.0)) for row in rows]
+
+
+def chicago_year(ts: datetime) -> int:
+    local = ts.astimezone(TZ)
+    session_day = local.date() if local.hour >= 17 else local.date().fromordinal(local.date().toordinal() - 1)
+    return session_day.year
+
+
+def _load_trade_rows(root: Path, year: int, name: str) -> pl.DataFrame:
+    path = root / "by_year" / str(year) / name / "evaluation_trades.csv"
+    return pl.read_csv(path, try_parse_dates=True).filter(pl.col("status") == "closed")
+
+
+def _load_daily(root: Path, year: int, name: str) -> pl.DataFrame:
+    path = root / "by_year" / str(year) / name / "daily_equity.csv"
+    return (pl.read_csv(path, try_parse_dates=True).sort("timestamp")
+        .with_columns(pl.col("timestamp").dt.date().alias("utc_day"))
+        .filter(pl.col("utc_day").dt.year() == year)
+        .with_columns(pl.col("equity").shift(1).fill_null(1_000_000.0).alias("prior_equity"))
+        .with_columns((pl.col("equity") / pl.col("prior_equity") - 1).alias("daily_return"))
+        .select("utc_day", "equity", "daily_return"))
+
+
+def _trade_metrics(frame: pl.DataFrame, fills: pl.DataFrame) -> dict:
+    analyzer = TradeAnalyzer(_trade_objects(frame))
+    exits = fills.filter((pl.col("order_type") == "stop") & (pl.col("exit_reason") == "signal"))
+    stop_exits = frame.filter(pl.col("exit_time").is_in(exits["timestamp"]))
+    return {
+        "closed_trades": analyzer.num_trades,
+        "net_pnl_usd": analyzer.net_profit,
+        "average_trade_pnl_usd": analyzer.net_profit / analyzer.num_trades if analyzer.num_trades else None,
+        "win_rate": analyzer.win_rate,
+        "profit_factor": analyzer.profit_factor,
+        "worst_trade_loss_usd": float(frame["pnl"].min()) if frame.height else None,
+        "worst_trade_return": analyzer.largest_loss,
+        "protective_stop_exits": stop_exits.height,
+        "protective_stop_rate": stop_exits.height / analyzer.num_trades if analyzer.num_trades else None,
+        "gross_minus_net_pnl_usd": analyzer.total_gross_pnl - analyzer.net_profit,
+        "commission_usd": analyzer.total_commission,
+        "trade_analyzer": analyzer.to_dict(),
+    }
+
+
+def _period_metrics(root: Path, year_values: list[int], name: str) -> tuple[dict, pl.DataFrame]:
+    trades = pl.concat([_load_trade_rows(root, y, name) for y in year_values])
+    fills = pl.concat([pl.read_csv(root / "by_year" / str(y) / name / "fills.csv", try_parse_dates=True)
+        for y in year_values])
+    result = _trade_metrics(trades, fills)
+    daily_parts = [_load_daily(root, y, name) for y in year_values]
+    daily = pl.concat(daily_parts).unique(subset=["utc_day"], keep="last").sort("utc_day")
+    return result, daily
+
+
+def _risk_on_common_days(reference: pl.DataFrame, candidate: pl.DataFrame) -> dict:
+    common = reference.select("utc_day", pl.col("daily_return").alias("reference_return"))
+    common = common.join(candidate.select("utc_day", pl.col("daily_return").alias("candidate_return")),
+        on="utc_day", how="inner").sort("utc_day")
+    output = {"common_calendar_days": common.height}
+    for label, column in (("reference", "reference_return"), ("candidate", "candidate_return")):
+        returns = common[column].to_list()
+        equity = [1_000_000.0]
+        for value in returns:
+            equity.append(equity[-1] * (1.0 + value))
+        drawdown = max_drawdown(equity)[0] if len(equity) > 1 else 0.0
+        years = max((common["utc_day"][-1] - common["utc_day"][0]).days / 365.25, 1 / 365.25) if common.height else 0.0
+        growth = cagr(equity[0], equity[-1], years) if years else 0.0
+        output[label] = {"daily_sharpe": sharpe_ratio(returns, annualize=True) if returns else None,
+            "max_drawdown": drawdown, "calmar": calmar_ratio(growth, drawdown) if drawdown else None,
+            "cagr": growth, "equity_change_usd_on_common_dates": equity[-1] - equity[0]}
+    return output
+
+
+def _direction_metrics(trades: pl.DataFrame, fills: pl.DataFrame, direction: str) -> dict:
+    frame = trades.filter(pl.col("direction").str.to_lowercase() == direction)
+    return _trade_metrics(frame, fills)
+
+
+def audit_and_report() -> dict:
+    spec = json.loads((OUT / "frozen_spec.json").read_text())
+    protected_before = json.loads((OUT / "validation/protected_baseline_hashes.json").read_text())
+    source = base.verify_source()
+    errors = []
+    summaries = {}
+    for year in YEARS:
+        year_dir = OUT / "by_year" / str(year)
+        summary_path = year_dir / "year_summary.json"
+        if not summary_path.exists():
+            errors.append(f"{year}: missing year_summary.json")
+            continue
+        summary = json.loads(summary_path.read_text())
+        if summary.get("status") != "completed":
+            errors.append(f"{year}: status={summary.get('status')}")
+            continue
+        for trial in TRIALS:
+            path = year_dir / trial
+            required = ["trades.csv", "fills.csv", "evaluation_trades.csv", "daily_equity.csv", "metrics.json", "evaluation_metrics.json", "entry_context.csv"]
+            for item in required:
+                if not (path / item).exists():
+                    errors.append(f"{year}/{trial}: missing {item}")
+        summaries[year] = summary
+    if errors:
+        return {"status": "incomplete", "errors": errors}
+
+    annual = []
+    for year in YEARS:
+        row = {"year": year}
+        for side, baseline_trial, percent_trial in (
+            ("zero_cost", "native_zero_cost", "percent_zero_cost"),
+            ("costed", "native_full_tick_cost", "percent_costed"),
+        ):
+            b0_trades = _load_trade_rows(BASELINE, year, baseline_trial)
+            p_trades = _load_trade_rows(OUT, year, percent_trial)
+            b0_fills = pl.read_csv(BASELINE / "by_year" / str(year) / baseline_trial / "fills.csv", try_parse_dates=True)
+            p_fills = pl.read_csv(OUT / "by_year" / str(year) / percent_trial / "fills.csv", try_parse_dates=True)
+            row[side] = {"B0": _trade_metrics(b0_trades, b0_fills),
+                "fixed_percent_stop": _trade_metrics(p_trades, p_fills)}
+            if side == "costed" and year == 2026:
+                row[side]["B0_by_direction"] = {direction: _direction_metrics(b0_trades, b0_fills, direction)
+                    for direction in ("long", "short")}
+                row[side]["fixed_percent_stop_by_direction"] = {direction: _direction_metrics(p_trades, p_fills, direction)
+                    for direction in ("long", "short")}
+        annual.append(row)
+
+    periods = {"2013-2021_ex_post_anchor_period": list(range(2013, 2022)),
+        "2022-2025_chronology_after_anchor_not_OOS": list(range(2022, 2026)), "2026_through_Jul14": [2026]}
+    scenario_summary = {}
+    risk_comparison = {}
+    for label, years in periods.items():
+        scenario_summary[label] = {}
+        risk_comparison[label] = {}
+        for cost_label, b0_name, percent_name in (
+            ("zero_cost", "native_zero_cost", "percent_zero_cost"),
+            ("costed", "native_full_tick_cost", "percent_costed"),
+        ):
+            b0_metrics, b0_daily = _period_metrics(BASELINE, years, b0_name)
+            p_metrics, p_daily = _period_metrics(OUT, years, percent_name)
+            scenario_summary[label][cost_label] = {"B0": b0_metrics, "fixed_percent_stop": p_metrics,
+                "net_pnl_change_usd": p_metrics["net_pnl_usd"] - b0_metrics["net_pnl_usd"]}
+            risk_comparison[label][cost_label] = _risk_on_common_days(b0_daily, p_daily)
+
+    all_scenarios = {}
+    gross_cost_drag = {}
+    for label, trial in (("B0", "native_zero_cost"), ("percent_stop", "percent_zero_cost")):
+        cost_trial = "native_full_tick_cost" if label == "B0" else "percent_costed"
+        zero, zero_daily = _period_metrics(BASELINE if label == "B0" else OUT, YEARS, trial)
+        cost, cost_daily = _period_metrics(BASELINE if label == "B0" else OUT, YEARS, cost_trial)
+        all_scenarios[label] = {"zero_cost": zero, "costed": cost,
+            "zero_to_cost_pnl_change_usd": cost["net_pnl_usd"] - zero["net_pnl_usd"]}
+        gross_cost_drag[label] = cost["gross_minus_net_pnl_usd"]
+    risk_comparison["full_history"] = {}
+    for cost_label, b0_name, percent_name in (
+        ("zero_cost", "native_zero_cost", "percent_zero_cost"),
+        ("costed", "native_full_tick_cost", "percent_costed"),
+    ):
+        _, b0_daily = _period_metrics(BASELINE, YEARS, b0_name)
+        _, p_daily = _period_metrics(OUT, YEARS, percent_name)
+        risk_comparison["full_history"][cost_label] = _risk_on_common_days(b0_daily, p_daily)
+
+    # Independently verify stop price anchoring, one-contract entries, and the session cap.
+    stop_audit = {"status": "passed", "years": [], "errors": []}
+    for year in YEARS:
+        path = OUT / "by_year" / str(year) / "percent_costed"
+        contexts = pl.read_csv(path / "entry_context.csv")
+        trades = pl.read_csv(path / "evaluation_trades.csv", try_parse_dates=True).filter(pl.col("status") == "closed")
+        fills = pl.read_csv(path / "fills.csv", try_parse_dates=True)
+        entry_fills = fills.filter((pl.col("order_type") == "stop") & (pl.col("exit_reason") == ""))
+        exit_stops = fills.filter((pl.col("order_type") == "stop") & (pl.col("exit_reason") == "signal"))
+        if entry_fills.filter(pl.col("quantity").abs() != 1).height:
+            stop_audit["errors"].append(f"{year}: entry fill quantity differs from one contract")
+        if contexts.filter(pl.col("quantity") != 1).height:
+            stop_audit["errors"].append(f"{year}: entry context quantity differs from one contract")
+        if contexts.filter(pl.col("stop_fraction") != FRACTION).height:
+            stop_audit["errors"].append(f"{year}: stop fraction changed")
+        if contexts.filter(((pl.col("side") == "long") & (pl.col("stop_price") >= pl.col("entry_price"))) |
+                ((pl.col("side") == "short") & (pl.col("stop_price") <= pl.col("entry_price")))).height:
+            stop_audit["errors"].append(f"{year}: stop is not protective")
+        if entry_fills.height:
+            from scripts.run_one_bar_nq_percent_stop_yearly_20261012 import chicago_session_day
+            entry_fills = entry_fills.with_columns(pl.col("timestamp").map_elements(
+                chicago_session_day, return_dtype=pl.Date).alias("session_day"))
+            counts = entry_fills.group_by("session_day").len()
+            max_entries = int(counts["len"].max()) if counts.height else 0
+        else:
+            max_entries = 0
+        gap_stops = exit_stops.filter(
+            ((pl.col("side") == "sell") & (pl.col("reference_price") < pl.col("stop_price"))) |
+            ((pl.col("side") == "buy") & (pl.col("reference_price") > pl.col("stop_price"))))
+        if max_entries > 2:
+            stop_audit["errors"].append(f"{year}: {max_entries} native entry STOP fills on one session day")
+        stop_audit["years"].append({"year": year, "entries": contexts.height,
+            "long_entries": contexts.filter(pl.col("side") == "long").height,
+            "short_entries": contexts.filter(pl.col("side") == "short").height,
+            "stop_exit_fills": exit_stops.height, "closed_trades": trades.height,
+            "gap_through_stop_fills": gap_stops.height,
+            "max_entry_stop_fills_per_utc_date": max_entries,
+            "protective_stops_are_native_stop_price_orders": True})
+    stop_audit["status"] = "passed" if not stop_audit["errors"] else "failed"
+
+    protection_after = baseline_protection(source)
+    if protection_after != protected_before:
+        errors.append("Original B0 or promoted immutable hash changed during the run")
+    audit = {"status": "passed" if not errors and stop_audit["status"] == "passed" else "failed",
+        "errors": errors, "source_identity_matches_frozen": source["manifest_sha256"] == spec["data"]["source_manifest_sha256"],
+        "protected_baseline_hashes_before": protected_before,
+        "protected_baseline_hashes_after": protection_after,
+        "percent_stop_invariants": stop_audit}
+    (OUT / "validation/native_reconciliation.json").write_text(json.dumps(audit, indent=2) + "\n")
+    report = {
+        "status": "COMPLETED_EXPLORATORY" if audit["status"] == "passed" else "COMPLETED_WITH_AUDIT_ERRORS",
+        "classification": spec["classification"], "parameter_fraction": FRACTION,
+        "parameter_anchor": spec["parameter_freeze"], "source": spec["data"],
+        "annual_comparison": annual, "period_comparison": scenario_summary,
+        "common_calendar_daily_risk": risk_comparison,
+        "all_history": all_scenarios, "gross_cost_drag_usd": gross_cost_drag,
+        "audit": audit, "execution_caveats": spec["limitations"],
+        "conclusion": "Descriptive historical counterfactual only. Do not infer live readiness or an unseen out-of-sample result.",
+    }
+    (OUT / "final_report.json").write_text(json.dumps(report, indent=2, default=str) + "\n")
+    (OUT / "yearly_summary.json").write_text(json.dumps({"annual_comparison": annual,
+        "period_comparison": scenario_summary, "daily_risk": risk_comparison}, indent=2, default=str) + "\n")
+    ledger = json.loads((OUT / "trial_ledger.json").read_text())
+    for trial in ledger["trials"]:
+        if trial["name"] in TRIALS:
+            trial["status"] = "completed" if audit["status"] == "passed" else "completed_with_audit_errors"
+            trial["year_count"] = len(YEARS)
+            trial["years"] = [{"year": year, "status": summaries[year]["status"],
+                "trials": summaries[year]["trials"]} for year in YEARS]
+    ledger["status"] = audit["status"]
+    (OUT / "trial_ledger.json").write_text(json.dumps(ledger, indent=2) + "\n")
+    hashes = {p.relative_to(ROOT).as_posix(): sha256(p) for p in OUT.rglob("*")
+        if p.is_file() and p.name != "hashes.json"}
+    (OUT / "hashes.json").write_text(json.dumps(hashes, indent=2) + "\n")
+    return report
+
+
+def run() -> None:
+    if not (OUT / "frozen_spec.json").exists():
+        prepare()
+    else:
+        assert_anchor()
+        source = base.verify_source()
+        if source["manifest_sha256"] != json.loads((OUT / "frozen_spec.json").read_text())["data"]["source_manifest_sha256"]:
+            raise ValueError("Frozen source identity changed")
+    ledger_path = OUT / "trial_ledger.json"
+    ledger = json.loads(ledger_path.read_text())
+    for trial in ledger["trials"]:
+        if trial["id"] in ("PZ", "PC"):
+            if trial["status"] in ("planned", "running"):
+                trial["status"] = "running"
+    ledger["status"] = "running"
+    ledger_path.write_text(json.dumps(ledger, indent=2) + "\n")
+    for year in YEARS:
+        year_dir = OUT / "by_year" / str(year)
+        summary_path = year_dir / "year_summary.json"
+        if summary_path.exists() and json.loads(summary_path.read_text()).get("status") == "completed":
+            print(f"YEAR={year} SKIP durable completed summary", flush=True)
+            continue
+        year_dir.mkdir(parents=True, exist_ok=True)
+        command = [sys.executable, str(ROOT / "scripts/run_one_bar_nq_percent_stop_yearly_20261012.py"), str(year)]
+        env = os.environ.copy()
+        env["UV_CACHE_DIR"] = "/tmp/uv-cache"
+        process = subprocess.run(command, cwd=ROOT, env=env, text=True, capture_output=True)
+        (OUT / "logs").mkdir(exist_ok=True)
+        (OUT / f"logs/year_{year}.log").write_text(process.stdout + process.stderr)
+        if process.returncode:
+            result = {"year": year, "status": "failed", "exit_code": process.returncode,
+                "log": f"run_log/one_bar_nq_percent_stop_20261012/logs/year_{year}.log"}
+        else:
+            result = json.loads((year_dir / "worker_summary.json").read_text())
+        summary_path.write_text(json.dumps(result, indent=2, default=str) + "\n")
+        print(f"YEAR={year} status={result['status']}", flush=True)
+        if result["status"] != "completed":
+            ledger = json.loads(ledger_path.read_text())
+            ledger.setdefault("failed_years", []).append(result)
+            ledger_path.write_text(json.dumps(ledger, indent=2) + "\n")
+    if all((OUT / "by_year" / str(y) / "year_summary.json").exists() and
+        json.loads((OUT / "by_year" / str(y) / "year_summary.json").read_text()).get("status") == "completed" for y in YEARS):
+        report = audit_and_report()
+        print(json.dumps({"status": report["status"], "output": str(OUT / "final_report.json")}, indent=2), flush=True)
+    else:
+        print("FULL_HISTORY_INCOMPLETE; inspect per-year status and resume with this command.", flush=True)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--prepare", action="store_true")
+    parser.add_argument("--audit", action="store_true")
+    args = parser.parse_args()
+    if args.prepare:
+        prepare()
+    elif args.audit:
+        print(json.dumps(audit_and_report(), indent=2, default=str))
+    else:
+        run()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/run_one_bar_nq_percent_stop_yearly_20261012.py b/scripts/run_one_bar_nq_percent_stop_yearly_20261012.py
new file mode 100644
index 0000000000000000000000000000000000000000..5ea1e05c2873d2ba86e75bfadf1eaea48c44dfdb
--- /dev/null
+++ b/scripts/run_one_bar_nq_percent_stop_yearly_20261012.py
@@ -0,0 +1,252 @@
+"""Run one annual shard of the frozen fixed-percent-stop NQ counterfactual."""
+from __future__ import annotations
+
+import gc
+import json
+import sys
+from datetime import date, datetime, timedelta, timezone
+from decimal import Decimal, ROUND_CEILING, ROUND_FLOOR
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import polars as pl
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+import run_one_bar_practical_yearly_20261012 as base
+import run_one_bar_dukascopy_phase567_20261011 as phase
+from ml4t.backtest import Strategy
+from ml4t.backtest.types import OrderType
+
+OUT = ROOT / "run_log/one_bar_nq_percent_stop_20261012"
+ASSET, MULTIPLIER, TICK = "NQ_PROXY", 20.0, 0.25
+STOP_FRACTION = 50 / 14598.25
+TZ = ZoneInfo("America/Chicago")
+
+
+def percent_stop_price(entry_price: float, direction: str) -> float:
+    """Return a fixed-fraction stop rounded one tick away from entry."""
+    entry = Decimal(str(entry_price))
+    fraction = Decimal(str(STOP_FRACTION))
+    tick = Decimal("0.25")
+    if direction == "long":
+        raw = entry * (Decimal(1) - fraction)
+        units = (raw / tick).to_integral_value(rounding=ROUND_FLOOR)
+    elif direction == "short":
+        raw = entry * (Decimal(1) + fraction)
+        units = (raw / tick).to_integral_value(rounding=ROUND_CEILING)
+    else:
+        raise ValueError(f"direction must be 'long' or 'short', got {direction!r}")
+    return float(units * tick)
+
+
+def chicago_session_day(ts: datetime) -> date:
+    local = ts.astimezone(TZ)
+    return local.date() if local.hour >= 17 else local.date() - timedelta(days=1)
+
+
+def next_30m_boundary(ts: datetime) -> datetime:
+    epoch = int(ts.timestamp())
+    return datetime.fromtimestamp((epoch // 1800 + 1) * 1800, tz=timezone.utc)
+
+
+class PercentStopStrategy(Strategy):
+    """B0 entry/exit behavior with only the protective stop changed."""
+
+    def __init__(self, evaluation_end: date):
+        self.evaluation_end = evaluation_end
+        self.entries_by_day: dict[str, int] = {}
+        self.entry_orders = []
+        self.stop_order = None
+        self.trade = None
+        self.max_daily_entries = 0
+        self.ambiguous = []
+        self.trade_metadata = []
+
+    def on_data(self, timestamp, data, context, broker):
+        if chicago_session_day(timestamp) > self.evaluation_end:
+            pos = broker.get_position(ASSET)
+            active = bool(pos or self.trade or any(
+                order and order.status.value == "pending" for order in self.entry_orders))
+            if not active:
+                return
+            item = dict(data[ASSET])
+            item["signals"] = {}
+            data = {**data, ASSET: item}
+
+        bar = data[ASSET]
+        pos = broker.get_position(ASSET)
+        qty = float(pos.quantity) if pos else 0.0
+        filled_entry_orders = [order for order in self.entry_orders
+            if order and order.status.value == "filled"]
+        if filled_entry_orders:
+            day = chicago_session_day(timestamp).isoformat()
+            self.entries_by_day[day] = self.entries_by_day.get(day, 0) + len(filled_entry_orders)
+            self.max_daily_entries = max(self.max_daily_entries, self.entries_by_day[day])
+            if len(filled_entry_orders) > 1:
+                self.ambiguous.append({"timestamp": timestamp.isoformat(),
+                    "kind": "both_entry_stops_filled", "fills": len(filled_entry_orders)})
+            self.entry_orders = [o for o in self.entry_orders if o and o.status.value == "pending"]
+
+        if qty and self.trade is None:
+            day = chicago_session_day(timestamp).isoformat()
+            if not filled_entry_orders:
+                self.entries_by_day[day] = self.entries_by_day.get(day, 0) + 1
+                self.max_daily_entries = max(self.max_daily_entries, self.entries_by_day[day])
+            direction = "long" if qty > 0 else "short"
+            entry_price = float(pos.entry_price)
+            stop = percent_stop_price(entry_price, direction)
+            if (qty > 0 and float(bar["low"]) <= stop) or (qty < 0 and float(bar["high"]) >= stop):
+                self.ambiguous.append({"timestamp": timestamp.isoformat(),
+                    "kind": "entry_and_protective_stop_same_candle", "side": direction,
+                    "entry_price": entry_price, "stop_price": stop})
+            self.trade = {"entry_time": timestamp, "entry_price": entry_price,
+                "side": direction, "stop": stop, "scheduled_exit": next_30m_boundary(timestamp)}
+            self.trade_metadata.append({"entry_time": timestamp.isoformat(), "side": direction,
+                "quantity": abs(qty), "entry_price": entry_price, "stop_price": stop,
+                "stop_fraction": STOP_FRACTION, "stop_gap_points": abs(entry_price - stop)})
+            for order in self.entry_orders:
+                if order and order.status.value == "pending":
+                    broker.cancel_order(order.order_id)
+            self.entry_orders.clear()
+            self.stop_order = broker.submit_order(ASSET, -qty,
+                order_type=OrderType.STOP, stop_price=stop)
+
+        if qty and self.trade:
+            submit_at = self.trade["scheduled_exit"] - timedelta(minutes=1)
+            if timestamp >= submit_at:
+                if self.stop_order and self.stop_order.status.value == "pending":
+                    broker.cancel_order(self.stop_order.order_id)
+                broker.submit_order(ASSET, -qty, order_type=OrderType.MARKET)
+                self.trade["exit_submitted_at"] = timestamp
+
+        if not qty and self.trade:
+            self.trade = None
+            self.stop_order = None
+
+        local = timestamp.astimezone(TZ)
+        if not qty and local.minute in (29, 59):
+            for order in self.entry_orders:
+                if order and order.status.value == "pending":
+                    broker.cancel_order(order.order_id)
+            self.entry_orders.clear()
+            values = bar.get("signals", {})
+            long_stop, short_stop = values.get("next_long_stop"), values.get("next_short_stop")
+            entry_day = chicago_session_day(timestamp + timedelta(minutes=1)).isoformat()
+            if long_stop is not None and short_stop is not None and self.entries_by_day.get(entry_day, 0) < 2:
+                long_stop = round(round(float(long_stop) / TICK) * TICK, 8)
+                short_stop = round(round(float(short_stop) / TICK) * TICK, 8)
+                self.entry_orders = [
+                    broker.submit_order(ASSET, 1, order_type=OrderType.STOP, stop_price=long_stop),
+                    broker.submit_order(ASSET, -1, order_type=OrderType.STOP, stop_price=short_stop),
+                ]
+
+
+def run_year(year: int) -> dict:
+    from ml4t.backtest.analytics import max_drawdown, sharpe_ratio
+
+    year_dir = OUT / "by_year" / str(year)
+    year_dir.mkdir(parents=True, exist_ok=True)
+    feed, quality = base.build_year_feed(year)
+    (year_dir / "source_quality.json").write_text(json.dumps(quality, indent=2) + "\n")
+    eval_end = base.DATA_END if year == base.LAST_YEAR else date(year, 12, 31)
+    state: dict = {}
+
+    def strategy_factory():
+        state["strategy"] = PercentStopStrategy(eval_end)
+        return state["strategy"]
+
+    phase.CausalOneBar = strategy_factory
+    phase.OUT = year_dir
+    trials = []
+    for code, name, commission, slippage in (
+        ("PZ", "percent_zero_cost", 0.0, 0.0),
+        ("PC", "percent_costed", 2.5, 0.25),
+    ):
+        print(f"YEAR={year} ENGINE_START {name} {datetime.now(timezone.utc).isoformat()}", flush=True)
+        phase.run_native(feed, name, commission, slippage)
+        trial_dir = year_dir / name
+        trades = pl.read_csv(trial_dir / "trades.csv", try_parse_dates=True)
+        fills = pl.read_csv(trial_dir / "fills.csv", try_parse_dates=True)
+        native_metrics = json.loads((trial_dir / "metrics.json").read_text())
+        if trades.height:
+            evaluation = trades.with_columns(pl.col("entry_time").map_elements(
+                base._entry_year, return_dtype=pl.Int32).alias("entry_session_year"))
+            evaluation = evaluation.filter(pl.col("entry_session_year") == year)
+        else:
+            evaluation = trades.with_columns(pl.lit(None, dtype=pl.Int32).alias("entry_session_year"))
+        evaluation.write_csv(trial_dir / "evaluation_trades.csv")
+        pl.DataFrame(state["strategy"].trade_metadata, schema={
+            "entry_time": pl.String, "side": pl.String, "quantity": pl.Float64,
+            "entry_price": pl.Float64, "stop_price": pl.Float64,
+            "stop_fraction": pl.Float64, "stop_gap_points": pl.Float64,
+        }, orient="row").write_csv(trial_dir / "entry_context.csv")
+        closed = evaluation.filter(pl.col("status") == "closed")
+        annual_pnl = float(closed["pnl"].sum() or 0.0)
+        stop_exit_times = fills.filter((pl.col("order_type") == "stop") &
+            (pl.col("exit_reason") == "signal"))["timestamp"].to_list()
+        if closed.height:
+            stop_count = closed.filter(pl.col("exit_time").is_in(stop_exit_times)).height
+        else:
+            stop_count = 0
+        dailies = pl.read_csv(trial_dir / "daily_equity.csv", try_parse_dates=True).sort("timestamp")
+        if dailies.height:
+            dailies = dailies.with_columns(pl.col("equity").shift(1)
+                .fill_null(1_000_000.0).alias("prior_equity"))
+            dailies = dailies.with_columns((pl.col("equity") / pl.col("prior_equity") - 1)
+                .alias("daily_return"))
+            annual_days = dailies.filter(pl.col("timestamp").dt.year() == year)
+            daily_returns, equity_values = annual_days["daily_return"].to_list(), annual_days["equity"].to_list()
+            annual_sharpe = sharpe_ratio(daily_returns, annualize=True) if daily_returns else None
+            annual_dd = max_drawdown(equity_values)[0] if equity_values else None
+        else:
+            annual_sharpe = annual_dd = None
+        ambiguity = []
+        for event in state["strategy"].ambiguous:
+            if base._entry_year(datetime.fromisoformat(event["timestamp"])) == year:
+                ambiguity.append(event)
+        year_metrics = {
+            "trial_id": code, "name": name, "status": "completed",
+            "closed_trades": closed.height, "net_pnl_usd": annual_pnl,
+            "average_trade_pnl_usd": float(closed["pnl"].mean()) if closed.height else None,
+            "protective_stop_exits": stop_count,
+            "protective_stop_rate": stop_count / closed.height if closed.height else None,
+            "native_daily_equity_sharpe_utc": annual_sharpe,
+            "native_daily_equity_max_drawdown_utc": annual_dd,
+            "native_engine_final_value_including_warmup": native_metrics.get("native_engine_metrics", {}).get("final_value"),
+            "ending_native_open_trades": native_metrics.get("open_trades_at_end"),
+            "same_minute_ambiguity_count": len(ambiguity),
+            "max_entries_per_chicago_session_day": state["strategy"].max_daily_entries,
+            "commission_per_fill_usd": commission,
+            "adverse_slippage_points_per_fill": slippage,
+            "one_contract_each_entry": True,
+        }
+        (trial_dir / "evaluation_metrics.json").write_text(json.dumps(year_metrics, indent=2) + "\n")
+        if name == "percent_costed":
+            (year_dir / "ambiguity_report.json").write_text(json.dumps({
+                "year": year, "events": ambiguity,
+                "classification": "INCONCLUSIVE_SAME_MINUTE_OHLC",
+                "native_engine_fills_retained": True,
+            }, indent=2, default=str) + "\n")
+        trials.append(year_metrics)
+        print(f"YEAR={year} ENGINE_DONE {name} trades={closed.height} pnl={annual_pnl:.2f}", flush=True)
+        del trades, fills, dailies, evaluation, closed
+        gc.collect()
+
+    del feed
+    return {"year": year, "status": "completed", "quality": quality, "trials": trials,
+        "ending_strategy_state": {"open_entry_orders": sum(bool(o and o.status.value == "pending")
+            for o in state["strategy"].entry_orders),
+            "open_protective_order": bool(state["strategy"].stop_order and
+                state["strategy"].stop_order.status.value == "pending"),
+            "tracked_trade": state["strategy"].trade is not None}}
+
+
+if __name__ == "__main__":
+    year = int(sys.argv[1])
+    if year not in base.eligible_years():
+        raise SystemExit(f"unsupported year {year}")
+    summary = run_year(year)
+    target = OUT / "by_year" / str(year) / "worker_summary.json"
+    target.write_text(json.dumps(summary, indent=2, default=str) + "\n")
+    print(json.dumps(summary, default=str), flush=True)
diff --git a/tests/test_one_bar_nq_percent_stop_20261012.py b/tests/test_one_bar_nq_percent_stop_20261012.py
new file mode 100644
index 0000000000000000000000000000000000000000..552693073dfb8b19269b655bd5fd94ac42188dbe
--- /dev/null
+++ b/tests/test_one_bar_nq_percent_stop_20261012.py
@@ -0,0 +1,170 @@
+from __future__ import annotations
+
+from datetime import date, datetime, timezone
+from pathlib import Path
+from types import SimpleNamespace
+
+import polars as pl
+
+from scripts import run_one_bar_nq_percent_stop_yearly_20261012 as runner
+from scripts import run_one_bar_dukascopy_phase567_20261011 as phase
+
+
+class FakeBroker:
+    def __init__(self, position=None):
+        self.position = position
+        self.orders = []
+
+    def get_position(self, _asset):
+        return self.position
+
+    def submit_order(self, asset, quantity, **kwargs):
+        order = SimpleNamespace(asset=asset, quantity=quantity, kwargs=kwargs,
+            status=SimpleNamespace(value="pending"), order_id=str(len(self.orders)))
+        self.orders.append(order)
+        return order
+
+    def cancel_order(self, _order_id):
+        for order in self.orders:
+            if order.order_id == _order_id:
+                order.status.value = "cancelled"
+
+
+def test_2021_and_2026_stop_distances_and_directional_ticks():
+    long_2021 = runner.percent_stop_price(14598.25, "long")
+    short_2021 = runner.percent_stop_price(14598.25, "short")
+    assert long_2021 == 14548.25
+    assert short_2021 == 14648.25
+    assert 49.75 <= 14598.25 - long_2021 <= 50.0
+    assert 50.0 <= short_2021 - 14598.25 <= 50.25
+
+    long_2026 = runner.percent_stop_price(25828.5, "long")
+    short_2026 = runner.percent_stop_price(25828.5, "short")
+    assert 88.25 <= 25828.5 - long_2026 <= 88.5
+    assert 88.5 <= short_2026 - 25828.5 <= 88.75
+    assert (long_2026 / 0.25).is_integer()
+    assert (short_2026 / 0.25).is_integer()
+
+
+def test_filled_contract_gets_one_fixed_protective_stop_and_two_entry_orders():
+    strategy = runner.PercentStopStrategy(date(2026, 12, 31))
+    broker = FakeBroker()
+    timestamp = datetime(2026, 1, 5, 23, 29, tzinfo=timezone.utc)  # 17:29 Chicago
+    strategy.on_data(timestamp, {runner.ASSET: {"signals": {
+        "next_long_stop": 25800.0, "next_short_stop": 25700.0}}}, {}, broker)
+    assert [order.quantity for order in broker.orders] == [1, -1]
+    assert all(order.kwargs["order_type"] == phase.OrderType.STOP for order in broker.orders)
+
+    broker.orders[0].status.value = "filled"
+    broker.position = SimpleNamespace(quantity=1.0, entry_price=25800.25)
+    strategy.on_data(datetime(2026, 1, 5, 23, 30, tzinfo=timezone.utc),
+        {runner.ASSET: {"open": 25800.25, "high": 25801.0, "low": 25800.0,
+                        "signals": {}}}, {}, broker)
+    assert broker.orders[1].status.value == "cancelled"
+    stop_order = broker.orders[-1]
+    stop_price = stop_order.kwargs["stop_price"]
+    assert stop_order.quantity == -1.0
+    assert stop_price == runner.percent_stop_price(25800.25, "long")
+
+    broker.position.entry_price = 26000.0
+    strategy.on_data(datetime(2026, 1, 5, 23, 31, tzinfo=timezone.utc),
+        {runner.ASSET: {"open": 25800.0, "high": 25801.0, "low": 25799.0,
+                        "signals": {}}}, {}, broker)
+    assert broker.orders[-1] is stop_order
+    assert strategy.trade["stop"] == stop_price
+    assert strategy.trade_metadata[0]["stop_fraction"] == runner.STOP_FRACTION
+    assert strategy.trade_metadata[0]["quantity"] == 1
+
+
+def test_session_day_uses_chicago_dst_boundaries():
+    # The spring-forward day has no local 02:xx timestamps; UTC-to-Chicago stays causal.
+    before = datetime(2021, 3, 14, 7, 29, tzinfo=timezone.utc)
+    after = datetime(2021, 3, 14, 8, 0, tzinfo=timezone.utc)
+    assert runner.chicago_session_day(before) == date(2021, 3, 13)
+    assert runner.chicago_session_day(after) == date(2021, 3, 13)
+    assert runner.next_30m_boundary(before) == datetime(2021, 3, 14, 7, 30, tzinfo=timezone.utc)
+    assert runner.chicago_session_day(datetime(2021, 3, 14, 21, 59, tzinfo=timezone.utc)) == date(2021, 3, 13)
+    assert runner.chicago_session_day(datetime(2021, 3, 14, 22, 0, tzinfo=timezone.utc)) == date(2021, 3, 14)
+
+
+def test_two_filled_entries_per_chicago_session_day_is_the_cap():
+    strategy = runner.PercentStopStrategy(date(2026, 12, 31))
+    broker = FakeBroker()
+    signals = {"next_long_stop": 25800.0, "next_short_stop": 25700.0}
+    strategy.on_data(datetime(2026, 1, 5, 23, 29, tzinfo=timezone.utc),
+        {runner.ASSET: {"signals": signals}}, {}, broker)
+    first_entry = broker.orders[0]
+    first_entry.status.value = "filled"
+    broker.position = SimpleNamespace(quantity=1.0, entry_price=25800.25)
+    strategy.on_data(datetime(2026, 1, 5, 23, 30, tzinfo=timezone.utc),
+        {runner.ASSET: {"open": 25800.25, "high": 25801.0, "low": 25800.0, "signals": {}}}, {}, broker)
+    broker.position = None
+    strategy.on_data(datetime(2026, 1, 5, 23, 31, tzinfo=timezone.utc),
+        {runner.ASSET: {"open": 25800.0, "high": 25801.0, "low": 25799.0, "signals": {}}}, {}, broker)
+
+    strategy.on_data(datetime(2026, 1, 6, 5, 59, tzinfo=timezone.utc),
+        {runner.ASSET: {"signals": signals}}, {}, broker)  # 23:59 Chicago, same Globex day
+    second_entry = strategy.entry_orders[0]
+    second_entry.status.value = "filled"
+    broker.position = SimpleNamespace(quantity=1.0, entry_price=25801.0)
+    strategy.on_data(datetime(2026, 1, 6, 6, 0, tzinfo=timezone.utc),
+        {runner.ASSET: {"open": 25801.0, "high": 25802.0, "low": 25800.5, "signals": {}}}, {}, broker)
+    assert strategy.max_daily_entries == 2
+    order_count = len(broker.orders)
+
+    broker.position = None
+    strategy.on_data(datetime(2026, 1, 6, 6, 1, tzinfo=timezone.utc),
+        {runner.ASSET: {"open": 25801.0, "high": 25802.0, "low": 25800.0, "signals": {}}}, {}, broker)
+    strategy.on_data(datetime(2026, 1, 6, 6, 29, tzinfo=timezone.utc),
+        {runner.ASSET: {"signals": signals}}, {}, broker)
+    assert len(broker.orders) == order_count
+
+
+def test_scheduled_market_exit_is_submitted_at_next_30m_boundary():
+    strategy = runner.PercentStopStrategy(date(2026, 12, 31))
+    timestamp = datetime(2026, 1, 5, 23, 30, tzinfo=timezone.utc)
+    broker = FakeBroker(SimpleNamespace(quantity=1.0, entry_price=25800.25))
+    protective = broker.submit_order(runner.ASSET, -1.0,
+        order_type=phase.OrderType.STOP, stop_price=25700.0)
+    strategy.stop_order = protective
+    strategy.trade = {"scheduled_exit": datetime(2026, 1, 6, 0, 0, tzinfo=timezone.utc),
+        "stop": 25700.0}
+    strategy.on_data(datetime(2026, 1, 5, 23, 59, tzinfo=timezone.utc),
+        {runner.ASSET: {"open": 25800.0, "high": 25801.0, "low": 25799.0, "signals": {}}}, {}, broker)
+    assert protective.status.value == "cancelled"
+    exit_order = broker.orders[-1]
+    assert exit_order.kwargs["order_type"] == phase.OrderType.MARKET
+    assert exit_order.quantity == -1.0
+    assert strategy.trade["exit_submitted_at"] == datetime(2026, 1, 5, 23, 59, tzinfo=timezone.utc)
+
+
+def test_native_stop_price_gap_fills_at_open_with_frozen_fraction_and_costs(tmp_path: Path, monkeypatch):
+    timestamps = [datetime(2021, 1, 4, 23, minute, tzinfo=timezone.utc) for minute in (29, 30, 31)]
+    feed = pl.DataFrame({
+        "timestamp": timestamps, "asset": [runner.ASSET] * 3,
+        "open": [100.0, 100.0, 98.0], "high": [100.0, 101.0, 99.0],
+        "low": [100.0, 100.0, 97.0], "close": [100.0, 100.5, 98.0],
+        "volume": [1.0, 1.0, 1.0], "next_long_stop": [100.25] * 3,
+        "next_short_stop": [99.75] * 3, "range_proxy": [0.01] * 3,
+    })
+    strategy_state = {}
+
+    def strategy_factory():
+        strategy_state["strategy"] = runner.PercentStopStrategy(date(2021, 1, 31))
+        return strategy_state["strategy"]
+
+    monkeypatch.setattr(phase, "CausalOneBar", strategy_factory)
+    monkeypatch.setattr(phase, "OUT", tmp_path)
+    metrics = phase.run_native(feed, "synthetic", 2.5, 0.25)
+    fills = pl.read_csv(tmp_path / "synthetic/fills.csv", try_parse_dates=True)
+    protective = fills.filter((pl.col("order_type") == "stop") & (pl.col("exit_reason") == "signal"))
+    assert protective.height == 1
+    stop_row = protective.row(0, named=True)
+    assert stop_row["reference_price"] == 98.0
+    assert stop_row["reference_price"] - stop_row["price"] == 0.25
+    assert stop_row["price"] == 97.75  # adverse slippage follows the gap-open trigger fill
+    actual_entry = strategy_state["strategy"].trade_metadata[0]["entry_price"]
+    assert stop_row["stop_price"] == runner.percent_stop_price(actual_entry, "long")
+    assert metrics["native_engine_metrics"]["total_commission"] == 5.0
+    assert metrics["slippage_cost_usd"] == 10.0
+    assert strategy_state["strategy"].trade_metadata[0]["quantity"] == 1.0

