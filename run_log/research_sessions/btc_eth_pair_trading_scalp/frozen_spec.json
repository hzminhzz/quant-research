  "spec": {
    "baseline": "Zero-trade baseline (0% return), and static buy-and-hold 50/50 BTC/ETH portfolio.",
    "costs": {
      "assumptions": "VIP0 / retail taker fee schedule (4 bps/leg) plus 2 bps conservative slippage/spread per side. Funding rates applied 8-hourly based on official Binance settlement timestamps.",
      "commission_bps": 4.0,
      "funding_included": true,
      "slippage_bps": 2.0
    },
