+        pl.when(pl.col("efficiency_20") <= er_cuts[0]).then(pl.lit("low"))
+        .when(pl.col("efficiency_20") <= er_cuts[1]).then(pl.lit("mid")).otherwise(pl.lit("high")).alias("efficiency_regime"))
+    regime_rows = []
