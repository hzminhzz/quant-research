+                       "profit_factor": float(y2026.filter(pl.col("pnl") > 0)["pnl"].sum() / -y2026.filter(pl.col("pnl") < 0)["pnl"].sum()),
+                       "daily_cashflow_drawdown": daily_drawdown(y2026),
