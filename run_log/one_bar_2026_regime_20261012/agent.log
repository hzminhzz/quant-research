+    regime_rows = []
+    for feature, label, cuts in [("atr20_bps", "atr_regime", atr_cuts), ("efficiency_20", "efficiency_regime", er_cuts)]:
+        base_rows = reference.with_columns(
+            pl.when(pl.col(feature) <= cuts[0]).then(pl.lit("low"))
