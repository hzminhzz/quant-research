+{
+  "analysis_type": "historical descriptive review; not preregistered prospective testing",
+  "outcome_boundary_utc_inclusive": "2026-07-14T23:59:59Z",
+  "protected_after_boundary": true,
+  "strategy": "Frozen 50 complete 30-minute bar NQ-equivalent breakout; unchanged; BID CFD/index proxy, not CME NQ",
+  "accounting": {
+    "primary_ledger": "promote/one_bar_nq_30m/backtests/practical_yearly/by_year/YYYY/native_full_tick_cost/evaluation_trades.csv",
+    "comparison_ledger": "promote/one_bar_nq_30m/backtests/practical_yearly/by_year/YYYY/native_zero_cost/evaluation_trades.csv",
+    "season_window": "entry timestamp from January 1 through July 14 inclusive for each year",
+    "subgroups": ["calendar month", "long/short", "STOP/MARKET/other exit reason", "bars held", "RTH 09:30-16:00 America/Chicago vs overnight", "year-matched sample"],
+    "concentration": ["worst/best 1, 3, 5, 10 trades"],
+    "costed_gross_definition": "Trade ledger gross_pnl is before commissions but includes modeled fill slippage; zero-cost PnL is reported from the separate zero-cost ledger. Do not label costed gross as zero-cost gross."
+  },
+  "market_features": {
+    "bar_construction": "30 unique one-minute source rows per complete Chicago 17:00-anchored 30-minute interval; same bins as fixed strategy",
+    "causal_feature_availability": "features at trade entry use only prior fully completed 30-minute bars; rolling fields are shifted one completed bar",
+    "features": ["ATR(20) in points and bps", "20-bar efficiency ratio", "prior range / ATR(20)", "50-bar high-low channel width in points and bps", "ATR versus trailing 252-complete-bar 33rd/67th percentile thresholds"],
+    "regime_comparison": "Use 2018-2025 Jan 1-Jul 14 entry observations as the reference; report 2026 trade counts, costed net/gross PnL, and win rate by reference-tercile thresholds. Terciles are descriptive, not a trading rule.",
+    "market_context": "Daily close-to-close realized volatility and close trend from the same proxy; external reporting only as dated context and hypothesis, never as causal proof."
+  },
+  "event_windows": "Fixed descriptive tags: 2026-01; 2026-02; 2026-03; 2026-04; 2026-05; 2026-06; 2026-07-01 through 2026-07-14. No post-boundary context.",
+  "methods": {
+    "ledger_processing": "Polars group_by aggregations; no backtest rerun",
+    "market_feature_engine": "Polars expressions following ml4t-polars-patterns; ML4T engineer API inspected. Use ml4t.engineer.compute_features only if actual registry parameters reproduce a needed feature. No model fitting or predictive performance claims.",
+    "causal_interpretation": "Accounting identities are verified. Feature/PnL slices are conditional associations, not identified causal effects. Exclude post-entry MFE/MAE from feature definitions. 1-minute OHLC cannot identify within-minute event ordering.",
+    "uncertainty": "Report sample sizes and descriptive differences. Do not fabricate confidence intervals if a valid day-cluster bootstrap is not implemented."
+  },
+  "required_reconciliations": {
+    "trade_count": 238,
+    "zero_cost_pnl_usd": -10806.96,
+    "full_tick_net_pnl_usd": -14166.96,
+    "modeled_cost_drag_usd": 3360.0,
+    "all_reported_partitioned_pnl_must_sum_to_total": true
+  },
+  "provenance": {
+    "source_manifest_sha256": "fd810bef0a390a77972d22d1cb0100e6d17f46dec437bed5abf865f39e579e75",
+    "canonical_source_root": "/home/quant/dev/quant/ml4t-data/.data/store/index_minute_NQ",
+    "data_cutoff": "2026-07-14",
+    "classification": "EXPLORATORY retrospective; NOT_APPROVED"
+  },
+  "workflow_note": "The mission asked for bin declaration before outcome inspection. An earlier broad inspection exposed a legacy aggregate report and a phase-567 run metric before this file was written. Those observations are not used as diagnostic inputs. This manifest records the historical-review scope before the relevant annual trade ledgers and source features are analyzed."
+}
