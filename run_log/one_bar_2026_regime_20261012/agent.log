+    lines += [f"- **Exit:** `{row['exit_class']}`: {row['trades']} trades, net ${row['net_pnl_usd']:,.2f}, win rate {row['win_rate']:.1%}. Raw ledger reasons: {', '.join(f'{item["exit_reason"]}={item["trades"]}' for item in breakdowns['exit_reason_raw'])}." for row in breakdowns["exit_class"]]
+    lines += [f"- **Session:** `{row['session']}`: {row['trades']} trades, net ${row['net_pnl_usd']:,.2f}, win rate {row['win_rate']:.1%}." for row in breakdowns["session"]]
