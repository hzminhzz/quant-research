+    }
+    (REPORT / "metrics.json").write_text(json.dumps(metrics, indent=2, default=str) + "\n")
+    y2026.select("entry_time", "feature_available_at", "direction", "entry_price", "exit_time", "exit_price", "pnl", "exit_reason",
