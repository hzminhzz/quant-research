+        "accounting": {"2026_trades": y2026.height, "zero_cost_pnl_usd": float(zero_2026["pnl"].sum()),
+                       "full_tick_costed_gross_before_commission_usd": float(y2026["gross_pnl"].sum()),
+                       "full_tick_net_pnl_usd": float(y2026["pnl"].sum()),
