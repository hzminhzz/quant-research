+    y2026 = y2026.join(context.select("entry_time", "volatility_proxy"), on="entry_time", how="left")
+
+    monthly = (agg(y2026, "entry_month").rename({"net_pnl_usd": "costed_net_usd",
+                "costed_gross_before_commission_usd": "costed_gross_usd"})
