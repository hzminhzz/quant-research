+                                                          "q10": float(y2026["breakout_distance_points"].quantile(0.10)),
+                                                          "q90": float(y2026["breakout_distance_points"].quantile(0.90))},
+                     "next_observed_open_move_points": {"mean": float(y2026["next_observed_open_move_points"].mean()),
