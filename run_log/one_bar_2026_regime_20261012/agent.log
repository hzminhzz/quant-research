+             .with_columns(pl.col("entry_time").dt.convert_time_zone("America/Chicago").dt.strftime("%Y-%m-%d %H:%M %Z").alias("entry_time"))
+             .to_dicts())
+    metrics = {
+        "analysis_classification": "EXPLORATORY retrospective historical review; NOT_APPROVED",
