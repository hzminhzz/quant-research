+            pl.when(pl.col(feature) <= cuts[0]).then(pl.lit("low"))
+            .when(pl.col(feature) <= cuts[1]).then(pl.lit("mid")).otherwise(pl.lit("high")).alias("regime"))
+        current_rows = y2026.rename({label: "regime"})
