+    {"name": "ml4t-tearsheet", "local_path": ".agents/skills/ml4t-tearsheet/SKILL.md", "reason": "present monthly net/gross outcomes with market context", "invariants": "include gross and net and the sample cutoff", "verification": "chart, CSV, and trade ledger reconciliation"}
+  ],
