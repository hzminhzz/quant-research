+    {"name": "ml4t-lookahead-bias", "local_path": ".agents/skills/ml4t-lookahead-bias/SKILL.md", "reason": "entry-time feature availability and protected cutoff", "invariants": "no feature after entry; no observations after 2026-07-14", "verification": "strict timestamp checks in focused tests and analysis cutoff guard"},
+    {"name": "ml4t-calendar-ops", "local_path": ".agents/skills/ml4t-calendar-ops/SKILL.md", "reason": "Chicago DST-aware source bars and RTH attribution", "invariants": "explicit America/Chicago conversion and 17:00 bar anchor", "verification": "same bar construction as frozen runner; tests check cutoff and availability"},
+    {"name": "ml4t-non-stationarity", "local_path": ".agents/skills/ml4t-non-stationarity/SKILL.md", "reason": "compare feature distributions across periods", "invariants": "do not normalize using the future; show distributions and date boundaries", "verification": "matched 2018-2025 reference and 2026 sample sizes in metrics.json"},
