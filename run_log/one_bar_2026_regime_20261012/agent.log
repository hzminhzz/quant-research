+                       "average_loser_usd": float(y2026.filter(pl.col("pnl") < 0)["pnl"].mean()),
+                       "median_net_trade_usd": float(y2026["pnl"].median()),
+                       "mean_bars_held": float(y2026["bars_held"].mean()),
