+                     "trailing_252_atr_regime": summarise(y2026.drop_nulls("atr_past252_regime"), "atr_past252_regime"),
+                     "reference_2018_2025_tercile_cutpoints": {"atr20_bps": list(atr_cuts), "efficiency_20": list(er_cuts)},
