+                                                        "positive_fraction": float((y2026["next_observed_open_move_points"] > 0).mean())},
+                     "ledger_excursions_points": {"median_mfe": float(y2026["ledger_mfe_points"].median()),
+                                                  "median_mae": float(y2026["ledger_mae_points"].median()),
