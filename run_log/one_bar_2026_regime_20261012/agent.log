+    write_chart(monthly, regimes.filter(pl.col("source_period") == "2026"), daily, REPORT / "one_bar_2026_regime_diagnostics.png")
+    (REPORT / "README.md").write_text(render_report(metrics, monthly, regimes, breakdowns))
