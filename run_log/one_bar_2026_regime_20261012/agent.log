+                       "session_breakdown": breakdowns["session"], "side_by_exit": breakdowns["side_by_exit"],
+                       "month_by_side": breakdowns["month_by_side"], "month_by_exit": breakdowns["month_by_exit"],
+                       "worst_10_trades": worst},
