+            {"period": "2026-02", "source": "Nasdaq Global Indexes: February 2026 Scorecard", "url": "https://www.nasdaq.com/articles/global-indexes/index-monthly-scorecard-february-2026", "role": "not independently retrieved; omitted from causal interpretation"},
+            {"period": "2026-04", "source": "Nasdaq Global Indexes: April 2026 Scorecard", "url": "https://www.nasdaq.com/articles/global-indexes/monthly-scorecard-april-2026", "role": "not independently retrieved; omitted from causal interpretation"},
