+    breakdowns = {name: summarise(y2026, fields) for name, fields in groupings.items()}
+    if not math.isclose(sum(row["net_pnl_usd"] for row in breakdowns["side"]), float(y2026["pnl"].sum()), abs_tol=0.01):
