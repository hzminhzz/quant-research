+                       "commissions_usd": float(y2026["fees"].sum()),
+                       "sum_of_total_slippage_cost_usd": float(y2026["total_slippage_cost"].sum()),
+                       "entry_costed_gross_minus_net_usd": float((y2026["gross_pnl"] - y2026["pnl"]).sum()),
