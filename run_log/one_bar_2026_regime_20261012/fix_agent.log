   239	def daily_drawdown(frame: pl.DataFrame) -> dict:
   240	    daily = (frame.group_by("exit_date_chicago").agg(pl.col("pnl").sum().alias("pnl"))
   241	             .sort("exit_date_chicago").with_columns(pl.col("pnl").cum_sum().alias("equity"),
   242	                 pl.col("pnl").cum_sum().cum_max().alias("peak"))
   243	             .with_columns((pl.col("equity") - pl.col("peak")).alias("drawdown")))
   244	    row = daily.sort("drawdown").head(1).to_dicts()
   245	    return {"sessions": daily.height, "max_drawdown_usd_from_running_cashflow_peak": row[0] if row else None}
   246	
