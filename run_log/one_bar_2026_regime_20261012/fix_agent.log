+    assert baseline["atr20"].to_list() == [8.0, 10.0]
+    assert mutated["atr20"].to_list() == baseline["atr20"].to_list()
+    assert baseline["efficiency_20"].to_list() == mutated["efficiency_20"].to_list()
+    assert baseline["atr20"].to_list()[0] == 8.0  # The 09:29 entry cannot see the bar that releases at 09:30.
