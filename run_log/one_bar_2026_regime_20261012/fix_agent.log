+    baseline = audit.join_available_features(trades, released, ["atr20", "efficiency_20"])
+
+    changed_future = bars.with_columns(
+        pl.when(pl.col("bar_start") == starts[2]).then(999.0).otherwise(pl.col("atr20")).alias("atr20"),
+        pl.when(pl.col("bar_start") == starts[2]).then(999.0).otherwise(pl.col("efficiency_20")).alias("efficiency_20"))
+    mutated = audit.join_available_features(trades, audit.release_complete_30m_bars(changed_future),
+                                            ["atr20", "efficiency_20"])
