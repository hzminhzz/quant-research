   216	def agg(frame: pl.DataFrame, by: str | list[str]) -> pl.DataFrame:
   217	    return frame.group_by(by).agg(
   218	        pl.len().alias("trades"), pl.col("pnl").sum().alias("net_pnl_usd"),
   219	        pl.col("gross_pnl").sum().alias("costed_gross_before_commission_usd"),
   220	        (pl.col("pnl") > 0).mean().alias("win_rate"),
   221	        pl.col("pnl").filter(pl.col("pnl") > 0).sum().alias("wins_usd"),
   222	        pl.col("pnl").filter(pl.col("pnl") < 0).sum().alias("losses_usd"),
   223	        pl.col("bars_held").mean().alias("mean_bars_held"),
   224	        pl.col("bars_held").median().alias("median_bars_held"),
   225	    ).with_columns(
   226	        pl.when(pl.col("losses_usd") < 0).then(pl.col("wins_usd") / -pl.col("losses_usd"))
   227	        .otherwise(None).alias("profit_factor"))
   228	
   229	
   230	def summarise(frame: pl.DataFrame, by: str | list[str]) -> list[dict]:
   231	    return agg(frame, by).sort(by).to_dicts()
