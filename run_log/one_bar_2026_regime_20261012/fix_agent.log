   248	def top_concentration(frame: pl.DataFrame) -> dict:
   249	    rows = frame.sort("pnl").select("pnl").to_series().to_list()
   250	    best = sorted(rows, reverse=True)
   251	    worst = sorted(rows)
   252	    return {f"best_{n}_sum_usd": sum(best[:n]) for n in (1, 3, 5, 10)} | {
   253	        f"worst_{n}_sum_usd": sum(worst[:n]) for n in (1, 3, 5, 10)}
   254	
