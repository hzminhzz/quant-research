+
+    assert (exits["STOP"]["trades"], round(exits["STOP"]["net_pnl_usd"], 2)) == (44, -48058.76)
+    assert (exits["MARKET"]["trades"], round(exits["MARKET"]["net_pnl_usd"], 2)) == (194, 33891.80)
+    assert sessions["RTH"]["trades"] > 0
