    path = LEDGERS / str(year) / trial / "evaluation_trades.csv"
    if not path.is_file():
        raise FileNotFoundError(path)
    frame = read_csv(path).filter(pl.col("status") == "closed")
    fills = read_csv(path.parent / "fills.csv")
    exit_fills = (fills.filter(pl.col("exit_reason") == "signal").group_by("timestamp").agg(
        pl.col("order_type").first().alias("exit_fill_order_type"),
        pl.col("order_type").n_unique().alias("exit_fill_order_type_count"),
    ).rename({"timestamp": "exit_time"}))
