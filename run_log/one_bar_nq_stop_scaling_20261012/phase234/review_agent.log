/usr/bin/zsh -lc "UV_CACHE_DIR=/tmp/uv-cache uv run python - <<'PY'
import csv, json, statistics
from pathlib import Path
root=Path('run_log/one_bar_nq_stop_scaling_20261012/phase234')
base=Path('run_log/one_bar_practical_1m_20261012')
for y in range(2013,2027):
 s=json.loads((root/'by_year'/str(y)/'year_summary.json').read_text())
 vals=[]
 for label in ('B2_costed','B2_zero_cost'):
  d=root/'by_year'/str(y)/label
  with (d/'evaluation_trades.csv').open() as f: tr=list(csv.DictReader(f))
  pnls=[float(t['pnl']) for t in tr if t['status']=='closed']
  pf=sum(x for x in pnls if x>0)/-sum(x for x in pnls if x<0) if any(x<0 for x in pnls) else None
  with (d/'daily_equity.csv').open() as f: eq=list(csv.DictReader(f))
  daily=[]
  for i in range(1,len(eq)):
   daily.append(float(eq[i]['equity'])-float(eq[i-1]['equity']))
  m=next(t for t in s['trials'] if t['trial_id']==label)
  vals.append((label,len(pnls),round(sum(pnls),2),round(pf or 0,3),round(min(daily,default=0),2),m['stop_exit_count_actual_order_type']))
 print(y, vals)
# quantity distributions, stop consistency, fills cardinality, listing date split
for label in ('B2_costed','B2_zero_cost'):
 groups={'prelaunch':[],'2026':[]}; total_fills=total_trades=stop=0; badrisk=badsize=0
 for y in range(2013,2027):
  d=root/'by_year'/str(y)/label
  with (d/'evaluation_trades.csv').open() as f: ts=list(csv.DictReader(f))
  with (d/'fills.csv').open() as f: fs=list(csv.DictReader(f))
  total_trades+=len([t for t in ts if t['status']=='closed']); total_fills+=len(fs)
  stop+=sum(t.get('exit_order_type')=='stop' for t in ts)
  for t in ts:
   day=t['entry_time'][:10]
   qty=abs(float(t['quantity'])); dist=float(t['stop_distance']); risk=float(t['nominal_risk_usd'])
   if risk>1000+1e-6: badrisk+=1
   if qty*dist*2>1000+1e-6: badsize+=1
   if day<'2019-05-06': groups['prelaunch'].append(qty)
   if y==2026: groups['2026'].append(qty)
 print(label, 'trades',total_trades,'fills',total_fills,'stops',stop,'stoprate',stop/total_trades,'risk>1000',badrisk,'sizeViolation',badsize,'qty prelaunch median,max',statistics.median(groups['prelaunch']),max(groups['prelaunch']),'2026 median,max',statistics.median(groups['2026']),max(groups['2026']))
for y in range(2013,2027):
 p=base/'by_year'/str(y)/'native_full_tick_cost/evaluation_trades.csv'
 with p.open() as f: rows=[r for r in csv.DictReader(f) if r['status']=='closed']
 print('B0',y,len(rows),round(sum(float(r['pnl']) for r in rows),2))
