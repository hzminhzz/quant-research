+    filled = [metadata_by_order_id[o.order_id] for o in orders
+              if o and o.status.value == "filled" and o.order_id in metadata_by_order_id
+              and metadata_by_order_id[o.order_id]["signed_quantity"] * position_quantity > 0]
+    if len(filled) != 1:
