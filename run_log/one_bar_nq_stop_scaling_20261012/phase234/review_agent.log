import csv
from pathlib import Path
r=Path('run_log/one_bar_nq_stop_scaling_20261012/phase234')
for y in range(2013,2027):
 p=r/'by_year'/str(y)/'B2_costed/evaluation_trades.csv'
 with p.open() as f: rows=list(csv.DictReader(f))
 bad=[x for x in rows if float(x['quantity'])*float(x['stop_distance'])*2>1000+1e-9]
 if bad: print(y,[(x['entry_time'],x['quantity'],x['stop_distance'],x['nominal_risk_usd']) for x in bad])
