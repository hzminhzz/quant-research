+"""Freeze inputs, build causal ATR20 context, and run the B2 yearly workers."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import subprocess
+import sys
+from datetime import date, datetime, timedelta, timezone
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import polars as pl
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / "run_log/one_bar_nq_stop_scaling_20261012/phase234"
+BASE = ROOT / "run_log/one_bar_dukascopy_2013_2026_20261011"
+STORE = Path("/home/quant/dev/quant/ml4t-data/.data/store/index_minute_NQ")
+FIRST_YEAR, LAST_YEAR, END = 2013, 2026, date(2026, 7, 14)
+TZ = ZoneInfo("America/Chicago")
+
+
+def sha(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as f:
+        for block in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def write(path: Path, obj: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(obj, indent=2, default=str) + "\n")
+
+
+def stop_distance(atr20: float) -> float:
+    return math.ceil(1.5 * atr20 / 0.25) * 0.25
+
+
+def mnq_quantity(distance: float, budget: float = 1000.0) -> int:
+    return math.floor(budget / (2.0 * distance)) if distance > 0 else 0
+
+
+def protective_stop(entry_price: float, distance: float, quantity: float, tick: float = 0.25) -> float:
+    raw = entry_price - distance if quantity > 0 else entry_price + distance
+    return round((math.floor(raw / tick) if quantity > 0 else math.ceil(raw / tick)) * tick, 8)
+
+
+def can_enter(entries_by_day: dict, day, limit: int = 2) -> bool:
+    return entries_by_day.get(day, 0) < limit
+
+
+def source_files() -> list[Path]:
+    return sorted(p for p in STORE.glob("year=*/month=*/data.parquet")
+                  if int(p.parent.parent.name.split("=")[1]) < 2026
+                  or (p.parent.parent.name == "year=2026" and int(p.parent.name.split("=")[1]) <= 7))
+
+
+def verify_source() -> dict:
+    frozen = json.loads((BASE / "frozen_spec.json").read_text())
+    manifest_path = BASE / "source_manifest.json"
+    records = json.loads(manifest_path.read_text())
+    paths = source_files()
+    if sha(manifest_path) != frozen["data"]["source_manifest_sha256"]:
+        raise ValueError("Frozen source manifest hash mismatch")
+    if len(paths) != frozen["data"]["partitions"] or len(paths) != len(records):
+        raise ValueError("Frozen source partition count mismatch")
+    total_bytes = 0
+    partition_hashes = []
+    for path, rec in zip(paths, records, strict=True):
+        digest = sha(path)
+        if path.relative_to(STORE).as_posix() != rec["path"] or digest != rec["sha256"]:
+            raise ValueError(f"Frozen source partition mismatch: {path}")
+        total_bytes += path.stat().st_size
+        partition_hashes.append({"path": rec["path"], "bytes": path.stat().st_size, "sha256": digest})
+    archive = ROOT / "run_log/one_bar_nq_stop_scaling_20261012/frozen_baseline/one_bar_nq_30m_as_is_20261012.tar.gz"
+    snap = json.loads((ROOT / "run_log/one_bar_nq_stop_scaling_20261012/frozen_baseline/snapshot.json").read_text())
+    if sha(archive) != snap["archive"]["sha256"]:
+        raise ValueError("Frozen promoted archive hash mismatch")
+    raw = (pl.scan_parquet([str(p) for p in paths])
+           .filter(pl.col("timestamp").dt.date().is_between(date(2013, 1, 1), END))
+           .select("timestamp", "open", "high", "low", "close", "volume").sort("timestamp").collect()
+           .with_columns(pl.col("timestamp").dt.replace_time_zone("UTC")))
+    local = pl.col("timestamp").dt.convert_time_zone("America/Chicago")
+    raw = raw.with_columns(local.alias("local"),
+        pl.when(local.dt.hour() >= 17).then(local.dt.date())
+        .otherwise(local.dt.date().dt.offset_by("-1d")).alias("session_date"))
+    starts = pl.DataFrame({"session_date": raw["session_date"].unique().sort(),
+        "session_start_utc": [datetime(d.year, d.month, d.day, 17, tzinfo=TZ).astimezone(timezone.utc)
+                              for d in raw["session_date"].unique().sort().to_list()]})
+    bins = (raw.join(starts, on="session_date").with_columns(
+        ((pl.col("timestamp") - pl.col("session_start_utc")).dt.total_minutes() // 30).alias("bar_no"))
+        .group_by("session_date", "bar_no").agg(pl.len().alias("rows"),
+            pl.col("timestamp").n_unique().alias("unique_minutes"),
+            pl.col("timestamp").min().alias("first"), pl.col("timestamp").max().alias("last")))
+    complete = bins.filter((pl.col("rows") == 30) & (pl.col("unique_minutes") == 30))
+    quality = {
+        "confidence": "VERIFIED source bytes and bounded schema/date checks; underlying quote identity remains proxy",
+        "source": "Dukascopy USATECH.IDX/USD BID-only one-minute CFD/index proxy, not dated CME NQ/MNQ",
+        "source_root": str(STORE), "source_symbol": "USATECH.IDX/USD", "source_price_side": "BID",
+        "source_manifest": "run_log/one_bar_dukascopy_2013_2026_20261011/source_manifest.json",
+        "source_manifest_sha256": sha(manifest_path), "partition_count": len(paths),
+        "partition_bytes": total_bytes, "partition_hashes_match_frozen_manifest": True,
+        "partition_hashes": partition_hashes,
+        "frozen_promoted_archive_sha256": sha(archive), "frozen_promoted_archive_bytes": archive.stat().st_size,
+        "source_timestamps_utc": {"first": raw["timestamp"].min().isoformat(), "last_in_scope": raw["timestamp"].max().isoformat()},
+        "inclusive_cutoff_utc_date": str(END), "rows_in_scope": raw.height,
+        "rows_after_protected_cutoff_read": 0,
+        "naive_source_timestamps_interpreted_as": "UTC, per frozen source contract",
+        "timezone_and_session": "America/Chicago with IANA DST; 17:00 local session anchor; UTC bar timestamps",
+        "schema": {k: str(v) for k, v in raw.schema.items()},
+        "duplicate_timestamps": raw.height - raw["timestamp"].n_unique(),
+        "null_ohlc": sum(raw[c].null_count() for c in ("open", "high", "low", "close")),
+        "invalid_ohlc": raw.filter((pl.col("high") < pl.col("low")) |
+            (pl.col("close") > pl.col("high")) | (pl.col("close") < pl.col("low"))).height,
+        "non_finite_ohlc": raw.select(pl.any_horizontal([~pl.col(c).is_finite() for c in ("open", "high", "low", "close")]).sum()).item(),
+        "session_anchored_30m_bins": bins.height, "complete_30m_bins": complete.height,
+        "incomplete_or_missing_30m_bins": bins.height - complete.height,
+        "incomplete_30m_bins_are_not_removed_from_minute_execution": True,
+        "coverage_caveat": "Only observed source bins are counted; closed sessions and vendor outages are not imputed.",
+        "MNQ_contract_map": {"multiplier_usd_per_point": 2, "tick_points": 0.25, "tick_value_usd": 0.5,
+            "commission_usd_per_contract_per_fill": 1.25, "slippage_points_per_fill": 0.25,
+            "cost_source": "Illustrative, NOT broker-verified; BID-only data omits ASK/spread."},
+        "margin": {"initial_margin_usd_per_contract": 2500, "maintenance_margin_usd_per_contract": 2000,
+            "confidence": "Illustrative engine guardrail only, not broker/exchange verified."},
+    }
+    if quality["duplicate_timestamps"] or quality["null_ohlc"] or quality["invalid_ohlc"] or quality["non_finite_ohlc"]:
+        raise ValueError(f"Source validation failed: {quality}")
+    return quality
+
+
+def frozen_spec() -> dict:
+    return {
+        "status": "frozen_before_results", "classification": "EXPLORATORY retrospective; NOT_APPROVED_FOR_LIVE",
+        "trial": "B2 only; 1.5 x ATR20; integer MNQ sizing to $1,000 nominal stop risk",
+        "hypothesis": "Volatility-scaled protective stops may reduce premature stop-outs without changing 50-bar breakouts or next-30m-open exits.",
+        "falsifier": "Native cost-aware result is non-positive per nominal R or intended stop/entry/accounting invariants fail; no optimization follows.",
+        "period_utc_date_inclusive": ["2013-01-01", "2026-07-14"], "protected_after": "2026-07-14",
+        "source_manifest_sha256": sha(BASE / "source_manifest.json"),
+        "bar_and_feature": {"bar": "30m, 17:00 America/Chicago session anchored, only exactly 30 distinct source minutes qualify",
+            "atr": "ml4t.engineer.compute_features ATR period=20; standard True Range; TA-Lib-compatible Wilder smoothing verified against library output",
+            "decision_availability": "Feature computed from completed bar and released on its final one-minute row; order is NEXT_BAR and therefore first eligible on following source row.",
+        "stop": "ceil(1.5 * ATR20 / 0.25) * 0.25 points, protective trigger from actual filled entry price; native stop fill mode retained from baseline and gap behavior audited."},
+        "unchanged_entry_exit": {"lookback": 50, "entries": "buy STOP at previous 50 complete highs; sell STOP at previous 50 complete lows; intended OCO",
+            "exit": "market order submitted on prior available minute for immediately next 30m boundary opening print; missing opening print may delay to next source event",
+            "daily_cap": "2 filled entry contracts/orders per Chicago session day", "filters": "none"},
+        "sizing": {"budget_usd": 1000, "formula": "floor(1000 / (2 USD/point * stop_distance_points))",
+            "skip_when_qty_below": 1, "integer_contracts": True, "gap_losses_can_exceed_budget": True},
+        "contract_proxy": {"symbol": "MNQ proxy", "multiplier_usd_per_point": 2, "tick_points": 0.25,
+            "initial_margin_per_contract_usd": 2500, "maintenance_margin_per_contract_usd": 2000,
+            "margin_source": "Illustrative only; broker and dated-contract requirements unknown."},
+        "cost_trials": [{"id": "B2_zero_cost", "commission_per_contract_per_fill_usd": 0, "slippage_points_per_fill": 0},
+            {"id": "B2_costed", "commission_per_contract_per_fill_usd": 1.25, "slippage_points_per_fill": 0.25,
+             "cost_source": "Illustrative, NOT broker-verified; spread/ASK is absent from source."}],
+        "methodology_skills": [
+            {"name": "ml4t-fetch-data", "path": ".agents/skills/ml4t-fetch-data/SKILL.md", "invariant": "verify partition identity and expected date range"},
+            {"name": "ml4t-validate-data", "path": ".agents/skills/ml4t-validate-data/SKILL.md", "invariant": "schema, finite OHLC, duplicates and gaps counted"},
+            {"name": "ml4t-calendar-ops", "path": ".agents/skills/ml4t-calendar-ops/SKILL.md", "invariant": "Chicago IANA DST and session-year attribution"},
+            {"name": "ml4t-compute-features", "path": ".agents/skills/ml4t-compute-features/SKILL.md", "invariant": "sorted causal ATR using complete bars"},
+            {"name": "ml4t-lookahead-bias", "path": ".agents/skills/ml4t-lookahead-bias/SKILL.md", "invariant": "only completed data before entry; native NEXT_BAR"},
+            {"name": "ml4t-polars-patterns", "path": ".agents/skills/ml4t-polars-patterns/SKILL.md", "invariant": "Polars sorted rolling and as-of operations"},
+            {"name": "ml4t-run-backtest", "path": ".agents/skills/ml4t-run-backtest/SKILL.md", "invariant": "native Engine/Strategy/DataFeed; no hand-rolled fills"},
+            {"name": "ml4t-position-sizing", "path": ".agents/skills/ml4t-position-sizing/SKILL.md", "invariant": "integer risk-budget sizing and available margin"},
+            {"name": "ml4t-cost-model", "path": ".agents/skills/ml4t-cost-model/SKILL.md", "invariant": "per-contract, per-fill commission and slippage"},
+            {"name": "ml4t-transaction-costs", "path": ".agents/skills/ml4t-transaction-costs/SKILL.md", "invariant": "show cost drag and missing spread caveat"},
+            {"name": "ml4t-risk-metrics", "path": ".agents/skills/ml4t-risk-metrics/SKILL.md", "invariant": "drawdown and loss tails alongside PnL"},
+            {"name": "ml4t-sensitivity-analysis", "path": ".agents/skills/ml4t-sensitivity-analysis/SKILL.md", "invariant": "no unregistered parameter sweep"},
+        ],
+        "trial_count": 2, "notes": ["No new holdout is claimed.", "2026 is already observed stress evidence.",
+            "Native opposing STOP orders are non-atomic; same-minute event ambiguity is reported.",
+            "Annual Engine cash resets are disclosed; annual summary is by Chicago entry-session year."],
+    }
+
+
+def main() -> None:
+    OUT.mkdir(parents=True, exist_ok=True)
+    quality = verify_source()
+    write(OUT / "phase2_data_quality.json", quality)
+    spec = frozen_spec()
+    write(OUT / "frozen_spec.json", spec)
+    ledger_path = OUT / "trial_ledger.json"
+    old = json.loads(ledger_path.read_text()) if ledger_path.exists() else {}
+    ledger = {"frozen_at_utc": old.get("frozen_at_utc", datetime.now(timezone.utc).isoformat()), "registered_trials": [
+        {"id": "B2_zero_cost", "status": "registered"}, {"id": "B2_costed", "status": "registered"}], "attempts": []}
+    ledger["attempts"] = old.get("attempts", [])
+    write(OUT / "trial_ledger.json", ledger)
+    print("PHASE2_VERIFIED_AND_SPEC_FROZEN", flush=True)
+    if not __import__("os").environ.get("ONE_BAR_B2_SKIP_STUDY"):
+        if __import__("os").environ.get("ONE_BAR_B2_FREEZE_ONLY"):
+            return
+        study()
+    for year in range(FIRST_YEAR, LAST_YEAR + 1):
+        out = OUT / "by_year" / str(year)
+        if (out / "year_summary.json").exists() and json.loads((out / "year_summary.json").read_text()).get("status") == "completed":
+            continue
+        cmd = [sys.executable, str(ROOT / "scripts/run_one_bar_nq_b2_yearly_20261012.py"), "--year", str(year)]
+        proc = subprocess.run(cmd, cwd=ROOT, text=True, capture_output=True)
+        out.mkdir(parents=True, exist_ok=True)
+        (out / "worker.log").write_text(proc.stdout + proc.stderr)
+        if proc.returncode:
+            write(out / "year_summary.json", {"year": year, "status": "failed", "exit_code": proc.returncode})
+            ledger["attempts"].append({"year": year, "status": "failed", "trial_count": 2, "log": str((out / "worker.log").relative_to(ROOT))})
+            write(OUT / "trial_ledger.json", ledger)
+            print(f"YEAR_FAILED={year}", flush=True)
+            raise RuntimeError(f"Year {year} failed; inspect {out / 'worker.log'}")
+        ledger["attempts"].append({"year": year, "status": "completed", "trial_count": 2})
+        write(OUT / "trial_ledger.json", ledger)
+        print(f"YEAR_COMPLETED={year}", flush=True)
+    study()
+    finalize()
+
+
+def study() -> None:
+    """Join fixed B0 entries to causal ATR and source-minute excursions."""
+    from run_one_bar_nq_b2_yearly_20261012 import build_bars
+    paths = source_files()
+    raw = (pl.scan_parquet([str(p) for p in paths])
+           .filter(pl.col("timestamp").dt.date().is_between(date(2013, 1, 1), END))
+           .select("timestamp", "open", "high", "low", "close", "volume").sort("timestamp").collect()
+           .with_columns(pl.col("timestamp").dt.replace_time_zone("UTC")))
+    bars = build_bars(raw)
+    b0 = pl.read_csv(BASE / "cost_aware/trades.csv", try_parse_dates=True)
+    if "entry_price" not in b0.columns:
+        raise ValueError(f"Unexpected B0 columns: {b0.columns}")
+    b0 = b0.filter((pl.col("entry_time").dt.date() <= END) & (pl.col("status") == "closed"))
+    features = bars.select(pl.col("available_at").alias("feature_available_at"), "atr20")
+    events = b0.join_asof(features, left_on="entry_time", right_on="feature_available_at", strategy="backward")
+    events = events.with_columns(
+        pl.when(pl.col("atr20").is_not_null()).then(((1.5 * pl.col("atr20") / 0.25).ceil() * 0.25)).otherwise(None).alias("stop_points"),
+    ).with_columns(
+        pl.when(pl.col("stop_points") > 0).then((1000 / (2 * pl.col("stop_points"))).floor().cast(pl.Int64)).otherwise(None).alias("mnq_qty"),
+        (pl.col("exit_time") - pl.col("entry_time")).dt.total_minutes().alias("holding_minutes"),
+    )
+    # Source paths are bounded to native B0 trade intervals; the join is diagnostic only.
+    minute = raw.select("timestamp", "high", "low")
+    entry_minute = minute.rename({"high": "entry_minute_high", "low": "entry_minute_low"})
+    events = events.join(entry_minute, left_on="entry_time", right_on="timestamp", how="left")
+    events = events.with_columns(
+        pl.when(pl.col("direction").str.to_lowercase().is_in(["long", "buy"]))
+          .then(pl.col("entry_price") - pl.col("entry_minute_low"))
+          .otherwise(pl.col("entry_minute_high") - pl.col("entry_price")).alias("entry_minute_mae_points"),
+    ).with_columns((pl.col("entry_minute_mae_points") >= pl.col("stop_points")).alias("same_minute_entry_stop_ambiguous"))
+    gaps = raw.select("timestamp").with_columns(pl.col("timestamp").diff().dt.total_minutes().alias("minutes_since_prior_source"))
+    events = events.join(gaps, left_on="entry_time", right_on="timestamp", how="left")
+    # Restore the minute frame after attaching entry-bar extrema.
+    events = events.drop("entry_minute_high", "entry_minute_low")
+    events = events.drop("timestamp") if "timestamp" in events.columns else events
+    raw_events = events
+    path = minute.join_where(events.select("entry_time", "exit_time", "entry_price", "direction", "stop_points", "mnq_qty", "atr20"),
+        pl.col("timestamp") >= pl.col("entry_time"), pl.col("timestamp") <= pl.col("exit_time"))
+    path_metrics = path.group_by("entry_time", "exit_time", "entry_price", "direction", "stop_points", "mnq_qty", "atr20").agg(
+        pl.col("high").max().alias("path_high"), pl.col("low").min().alias("path_low"), pl.len().alias("source_minutes"))
+    path_metrics = path_metrics.with_columns(
+        pl.when(pl.col("direction").str.to_lowercase().is_in(["long", "buy"]))
+          .then(pl.col("entry_price") - pl.col("path_low")).otherwise(pl.col("path_high") - pl.col("entry_price")).alias("mae_points"),
+        pl.when(pl.col("direction").str.to_lowercase().is_in(["long", "buy"]))
+          .then(pl.col("path_high") - pl.col("entry_price")).otherwise(pl.col("entry_price") - pl.col("path_low")).alias("mfe_points"),
+    )
+    regime = path_metrics.with_columns(
+        pl.col("entry_time").dt.convert_time_zone("America/Chicago").dt.year().alias("entry_year"),
+        pl.col("entry_time").dt.convert_time_zone("America/Chicago").dt.date().alias("session_day"))
+    regime = regime.with_columns(pl.when(pl.col("entry_year").is_between(2018, 2025)).then(pl.lit("2018-2025"))
+        .when(pl.col("entry_year") == 2026).then(pl.lit("2026-01-01_to_2026-07-14"))
+        .otherwise(pl.lit("2013-2017")).alias("period"))
+    period_summary = regime.group_by("period").agg(pl.len().alias("trades"),
+        pl.col("session_day").n_unique().alias("session_days"),
+        pl.col("atr20").median().alias("median_atr20_points"),
+        pl.col("stop_points").median().alias("median_stop_points"),
+        pl.col("mae_points").median().alias("median_mae_points"),
+        pl.col("mfe_points").median().alias("median_mfe_points"),
+        (pl.col("mae_points") >= pl.col("stop_points")).sum().alias("B0_path_stop_touch_count"),
+        pl.col("direction").filter(pl.col("direction").str.to_lowercase().is_in(["long", "buy"])).len().alias("long_trades"),
+        pl.col("direction").filter(pl.col("direction").str.to_lowercase().is_in(["short", "sell"])).len().alias("short_trades"))
+    period_summary.write_csv(OUT / "phase3_period_summary.csv")
+    path_metrics.write_csv(OUT / "phase3_entry_study.csv")
+    baseline_fills = pl.read_csv(BASE / "cost_aware/fills.csv", try_parse_dates=True)
+    dual_b0 = baseline_fills.filter((pl.col("order_type") == "stop") & (pl.col("exit_reason") == ""))
+    simultaneous_b0 = dual_b0.group_by("timestamp").len().filter(pl.col("len") > 1).height
+    summary = {
+        "classification": "INFERENCE; fixed B0 event-path diagnostic, not B2 replay",
+        "b0_closed_trade_count": b0.height, "events_with_atr20": events.filter(pl.col("atr20").is_not_null()).height,
+        "atr20_points": events.select(pl.col("atr20").median()).item(),
+        "stop_points_distribution": {str(k): int(v) for k, v in path_metrics.group_by("stop_points").len().sort("stop_points").rows() if k is not None},
+        "mnq_qty_distribution": {str(k): int(v) for k, v in path_metrics.group_by("mnq_qty").len().sort("mnq_qty").rows() if k is not None},
+        "qty_below_one_or_unavailable": path_metrics.filter(pl.col("mnq_qty").is_null() | (pl.col("mnq_qty") < 1)).height,
+        "long_count": path_metrics.filter(pl.col("direction").str.to_lowercase().is_in(["long", "buy"])).height,
+        "short_count": path_metrics.filter(pl.col("direction").str.to_lowercase().is_in(["short", "sell"])).height,
+        "mean_mae_points": path_metrics["mae_points"].mean(), "median_mae_points": path_metrics["mae_points"].median(),
+        "median_mfe_points": path_metrics["mfe_points"].median(),
+        "same_minute_entry_stop_ambiguous_count_on_B0_entries_using_B2_distance": int(raw_events["same_minute_entry_stop_ambiguous"].sum() or 0),
+        "same_minute_double_entry_ambiguity_in_B0_fills": simultaneous_b0,
+        "B0_entries_after_source_gaps_gt_1m": events.filter(pl.col("minutes_since_prior_source") > 1).height,
+        "B0_entry_same_minute_ambiguities": int(events["same_minute_entry_stop_ambiguous"].sum() or 0),
+        "period_summary_csv": "phase3_period_summary.csv",
+        "entry_path_issue": "B0 trade paths condition on B0 entries and exits; B2 holding/entry sequence may differ.",
+        "protective_stop_breach_count_on_B0_path": path_metrics.filter(pl.col("mae_points") >= pl.col("stop_points")).height,
+        "study_csv": "phase3_entry_study.csv",
+    }
+    write(OUT / "phase3_entry_study_summary.json", summary)
+
+
+def finalize() -> None:
+    years = []
+    for year in range(FIRST_YEAR, LAST_YEAR + 1):
+        p = OUT / "by_year" / str(year) / "year_summary.json"
+        if p.exists(): years.append(json.loads(p.read_text()))
+    complete = [x for x in years if x.get("status") == "completed"]
+    totals = {}
+    for trial in ("B2_zero_cost", "B2_costed"):
+        rows = [t for y in complete for t in y["trials"] if t["trial_id"] == trial]
+        totals[trial] = {"years_completed": len(rows), "trades": sum(r["closed_trades"] for r in rows),
+            "gross_pnl_usd": sum(r["gross_pnl_usd"] for r in rows), "net_pnl_usd": sum(r["net_pnl_usd"] for r in rows),
+            "fees_usd": sum(r["fees_usd"] for r in rows), "slippage_usd": sum(r["slippage_usd"] for r in rows),
+            "actual_nominal_risk_usd": sum(r["actual_nominal_risk_usd"] for r in rows),
+            "r_sum": sum(r["r_sum"] for r in rows), "ambiguous_events": sum(r["ambiguous_events"] for r in rows),
+            "max_entries_per_session_day": max((r["max_entries_per_chicago_session_day"] for r in rows), default=0)}
+    status = "BLOCKED" if len(complete) != 14 else ("INCONCLUSIVE" if totals["B2_costed"]["ambiguous_events"] else "VERIFIED")
+    if totals["B2_costed"]["ambiguous_events"]: status = "INCONCLUSIVE"
+    report = {"status": status, "classification": "EXPLORATORY; NOT_APPROVED_FOR_LIVE",
+        "period": {"start": "2013-01-01", "end_inclusive": "2026-07-14", "years_completed": [x["year"] for x in complete],
+            "missing_years": sorted(set(range(2013, 2027)) - {x["year"] for x in complete})},
+        "trial_count": 2, "annual_engine_runs_expected": 28, "annual_engine_runs_completed": sum(len(x.get("trials", [])) for x in complete),
+        "trials": totals, "annual": years,
+        "control": {"original_B0_cost_aware_net_usd": 166107.92, "source": "run_log/one_bar_practical_1m_20261012/final_report.json native_full_tick_cost; same bid-only proxy; unlike contract sizing and not a new trial",
+            "2026_B0_STOP_exits": 44, "2026_B0_trades": 238, "2026_B0_net_usd": -14166.96},
+        "limitations": ["BID-only Dukascopy CFD/index proxy, not CME futures", "No ASK/spread data; cost inputs are illustrative, not broker-verified",
+            "MNQ margin inputs are illustrative guardrails, not broker margin or prop feasibility", "Native Engine years reset cash to $1,000,000",
+            "Opposing STOP OCO is not atomic; ambiguity events remain unresolved", "No unseen holdout; 2026 was observed stress data"],
+    }
+    write(OUT / "final_report.json", report)
+    ledger = json.loads((OUT / "trial_ledger.json").read_text())
+    ledger["status"] = "completed" if len(complete) == 14 else "incomplete"
+    ledger["total_engine_trials"] = report["annual_engine_runs_completed"]
+    write(OUT / "trial_ledger.json", ledger)
+    hashes = {str(p.relative_to(ROOT)): sha(p) for p in OUT.rglob("*") if p.is_file() and p.name != "hashes.json"}
+    write(OUT / "hashes.json", hashes)
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--study-only", action="store_true")
+    args = ap.parse_args()
+    if args.study_only:
+        study()
+    else:
+        main()
diff --git a/scripts/run_one_bar_nq_b2_yearly_20261012.py b/scripts/run_one_bar_nq_b2_yearly_20261012.py
new file mode 100644
index 0000000000000000000000000000000000000000..4313984caedbb446ecc9fa494277e328e2d42eed
--- /dev/null
+++ b/scripts/run_one_bar_nq_b2_yearly_20261012.py
@@ -0,0 +1,284 @@
+"""One Chicago-session-year B2 replay, launched by run_one_bar_nq_b2_20261012.py."""
+from __future__ import annotations
+
+import json
+import math
+import sys
+from collections import defaultdict
+from datetime import date, datetime, timedelta, timezone
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import polars as pl
+from ml4t.engineer import compute_features
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+from run_one_bar_nq_b2_20261012 import BASE, END, OUT, STORE, can_enter, protective_stop, sha, write, source_files
+
+ASSET = "MNQ_PROXY"
+TZ = ZoneInfo("America/Chicago")
+MULTIPLIER, TICK = 2.0, 0.25
+INITIAL_CASH = 1_000_000.0
+INITIAL_MARGIN, MAINTENANCE_MARGIN = 2500.0, 2000.0
+
+
+def files_for_year(year: int) -> list[Path]:
+    return [p for p in source_files() if int(p.parent.parent.name.split("=")[1]) in (year - 1, year, year + 1)]
+
+
+def build_bars(raw: pl.DataFrame) -> pl.DataFrame:
+    local = pl.col("timestamp").dt.convert_time_zone("America/Chicago")
+    raw = raw.with_columns(local.alias("local"),
+        pl.when(local.dt.hour() >= 17).then(local.dt.date())
+        .otherwise(local.dt.date().dt.offset_by("-1d")).alias("session_date"))
+    dates = raw["session_date"].unique().sort().to_list()
+    starts = pl.DataFrame({"session_date": dates,
+        "session_start_utc": [datetime(d.year, d.month, d.day, 17, tzinfo=TZ).astimezone(timezone.utc) for d in dates]})
+    source = raw.join(starts, on="session_date").with_columns(
+        ((pl.col("timestamp") - pl.col("session_start_utc")).dt.total_minutes() // 30).alias("bar_no"))
+    bars = (source.group_by("session_date", "bar_no").agg(
+        pl.col("timestamp").min().alias("bar_start"), pl.col("open").first().alias("open"),
+        pl.col("high").max().alias("high"), pl.col("low").min().alias("low"),
+        pl.col("close").last().alias("close"), pl.col("volume").sum().alias("volume"),
+        pl.len().alias("n"), pl.col("timestamp").n_unique().alias("unique_n"))
+        .filter((pl.col("n") == 30) & (pl.col("unique_n") == 30)).sort("bar_start"))
+    # Installed ML4T implementation uses TA-Lib-compatible ATR (Wilder RMA).
+    bars = compute_features(bars.select("bar_start", "open", "high", "low", "close", "volume")
+                            .rename({"bar_start": "timestamp"}),
+                            [{"name": "atr", "params": {"period": 20}}], timestamp_col="timestamp")
+    return (bars.rename({"timestamp": "bar_start", "atr": "atr20"})
+        .with_columns((pl.col("bar_start") + pl.duration(minutes=30)).alias("available_at"),
+            pl.col("high").rolling_max(50).alias("next_long_stop"),
+            pl.col("low").rolling_min(50).alias("next_short_stop"))
+        .with_columns((pl.col("available_at") - pl.duration(minutes=1)).alias("release_decision_at"),
+            pl.when(pl.col("atr20").is_finite()).then(((1.5 * pl.col("atr20") / TICK).ceil() * TICK)).otherwise(None).alias("stop_points"))
+        .with_columns(pl.when(pl.col("stop_points").is_not_null() & (pl.col("stop_points") > 0))
+            .then((1000 / (MULTIPLIER * pl.col("stop_points"))).floor().cast(pl.Int64))
+            .otherwise(None).alias("mnq_qty")))
+
+
+def attach_signals(raw: pl.DataFrame, bars: pl.DataFrame) -> pl.DataFrame:
+    return raw.sort("timestamp").join_asof(
+        bars.select("release_decision_at", "next_long_stop", "next_short_stop", "atr20", "stop_points", "mnq_qty").sort("release_decision_at"),
+        left_on="timestamp", right_on="release_decision_at", strategy="backward")
+
+
+def build_year_feed(year: int) -> tuple[pl.DataFrame, dict]:
+    warm_start = date(year, 1, 1) if year == 2013 else date(year, 1, 1) - timedelta(days=14)
+    eval_end = END if year == 2026 else date(year, 12, 31)
+    source_end = min(END, eval_end + timedelta(days=7))
+    paths = files_for_year(year)
+    raw = (pl.scan_parquet([str(p) for p in paths])
+        .filter(pl.col("timestamp").dt.date().is_between(warm_start, source_end))
+        .select("timestamp", "open", "high", "low", "close", "volume").sort("timestamp").collect()
+        .with_columns(pl.col("timestamp").dt.replace_time_zone("UTC")))
+    if raw.is_empty(): raise ValueError(f"No rows for {year}")
+    bars = build_bars(raw)
+    local = pl.col("timestamp").dt.convert_time_zone("America/Chicago")
+    source = raw.with_columns(local.alias("local"),
+        pl.when(local.dt.hour() >= 17).then(local.dt.date())
+        .otherwise(local.dt.date().dt.offset_by("-1d")).alias("session_date"))
+    feed = attach_signals(source, bars).with_columns(pl.lit(ASSET).alias("asset"))
+    eval_rows = feed.filter(pl.col("session_date").dt.year() == year)
+    warm = bars.filter(pl.col("available_at") <= eval_rows["timestamp"].min()).height if eval_rows.height else 0
+    all_bins = (source.with_columns(((pl.col("timestamp") - pl.col("session_date").map_elements(
+        lambda d: datetime(d.year, d.month, d.day, 17, tzinfo=TZ).astimezone(timezone.utc),
+        return_dtype=pl.Datetime("us", "UTC"))).dt.total_minutes() // 30).alias("bar_no"))
+        .group_by("session_date", "bar_no").len().height)
+    quality = {"year": year, "raw_rows": raw.height, "execution_rows_retained": feed.height,
+        "complete_30m_bars": bars.height, "warmup_complete_bars": warm,
+        "duplicate_timestamps": raw.height - raw["timestamp"].n_unique(),
+        "null_ohlc": sum(raw[c].null_count() for c in ("open", "high", "low", "close")),
+        "invalid_ohlc": raw.filter((pl.col("high") < pl.col("low")) |
+            (pl.col("close") > pl.col("high")) | (pl.col("close") < pl.col("low"))).height,
+        "incomplete_bins": all_bins - bars.height,
+        "source_start": raw["timestamp"].min().isoformat(), "source_end": raw["timestamp"].max().isoformat(),
+        "partial_30m_execution_rows_preserved": True, "atr_release": "available on final minute of completed bar; first fill event is next source minute"}
+    if year > 2013 and warm < 80: raise ValueError(f"Insufficient prior context for year {year}: {warm} bars")
+    if quality["duplicate_timestamps"] or quality["null_ohlc"] or quality["invalid_ohlc"]: raise ValueError(str(quality))
+    return feed, quality
+
+
+def chicago_day(ts: datetime) -> date:
+    local = ts.astimezone(TZ)
+    return local.date() if local.hour >= 17 else local.date() - timedelta(days=1)
+
+
+def next_boundary(ts: datetime) -> datetime:
+    return datetime.fromtimestamp((int(ts.timestamp()) // 1800 + 1) * 1800, timezone.utc)
+
+
+def run(year: int) -> dict:
+    from ml4t.backtest import AssetClass, BacktestConfig, CommissionType, ContractSpec, DataFeed, Engine, Strategy
+    from ml4t.backtest.config import SlippageType
+    from ml4t.backtest.types import ExecutionMode, OrderType, StopFillMode
+
+    feed, quality = build_year_feed(year)
+    ydir = OUT / "by_year" / str(year)
+    ydir.mkdir(parents=True, exist_ok=True)
+    write(ydir / "source_quality.json", quality)
+    prices = feed.select("timestamp", "asset", "open", "high", "low", "close", "volume")
+    signals = feed.select("timestamp", "asset", "next_long_stop", "next_short_stop", "atr20", "stop_points", "mnq_qty")
+    yearsummaries = []
+
+    class B2(Strategy):
+        def __init__(self):
+            self.counts = defaultdict(int); self.entries = []; self.entry_orders = []
+            self.stop_order = None; self.trade = None; self.ambiguous = []; self.skipped = 0
+        def on_data(self, timestamp, data, context, broker):
+            bar = data[ASSET]; pos = broker.get_position(ASSET); qty = float(pos.quantity) if pos else 0.0
+            newly_filled = [o for o in self.entry_orders if o and o.status.value == "filled"]
+            if newly_filled:
+                if len(newly_filled) > 1: self.ambiguous.append({"timestamp": timestamp.isoformat(), "kind": "both_entry_stops_filled"})
+                self.counts[chicago_day(timestamp)] += len(newly_filled)
+                self.entry_orders = [o for o in self.entry_orders if o and o.status.value == "pending"]
+            if qty and self.trade is None:
+                side = "long" if qty > 0 else "short"
+                distance = self.pending_distance
+                stop_price = protective_stop(float(pos.entry_price), distance, qty)
+                touched = (float(bar["low"]) <= stop_price) if qty > 0 else (float(bar["high"]) >= stop_price)
+                if touched: self.ambiguous.append({"timestamp": timestamp.isoformat(), "kind": "entry_and_stop_same_minute", "entry": float(pos.entry_price), "stop": stop_price})
+                self.trade = {"side": side, "distance": distance, "entry_time": timestamp,
+                    "scheduled_exit": next_boundary(timestamp), "qty": abs(qty), "entry_price": float(pos.entry_price)}
+                self.entries.append({**self.trade, "atr20": self.pending_atr, "nominal_risk_usd": abs(qty)*distance*MULTIPLIER})
+                for order in self.entry_orders:
+                    if order and order.status.value == "pending": broker.cancel_order(order.order_id)
+                self.entry_orders.clear()
+                self.stop_order = broker.submit_order(ASSET, -qty, order_type=OrderType.STOP, stop_price=stop_price)
+            if qty and self.trade and timestamp >= self.trade["scheduled_exit"] - timedelta(minutes=1):
+                if self.stop_order and self.stop_order.status.value == "pending": broker.cancel_order(self.stop_order.order_id)
+                broker.submit_order(ASSET, -qty, order_type=OrderType.MARKET)
+            if not qty and self.trade:
+                self.trade = None; self.stop_order = None
+            eval_end = END if year == 2026 else date(year, 12, 31)
+            if chicago_day(timestamp) > eval_end: return
+            local = timestamp.astimezone(TZ)
+            if local.minute not in (29, 59) or qty: return
+            for order in self.entry_orders:
+                if order and order.status.value == "pending": broker.cancel_order(order.order_id)
+            self.entry_orders.clear()
+            s = bar.get("signals", {})
+            long_level, short_level = s.get("next_long_stop"), s.get("next_short_stop")
+            dist, n = s.get("stop_points"), s.get("mnq_qty")
+            day = chicago_day(timestamp + timedelta(minutes=1))
+            if long_level is None or short_level is None or dist is None or n is None: return
+            n = int(n)
+            if n < 1: self.skipped += 1; return
+            if not can_enter(self.counts, day): return
+            self.pending_distance, self.pending_atr = float(dist), float(s["atr20"])
+            self.entry_orders = [broker.submit_order(ASSET, n, order_type=OrderType.STOP, stop_price=round(round(float(long_level)/TICK)*TICK,8)),
+                broker.submit_order(ASSET, -n, order_type=OrderType.STOP, stop_price=round(round(float(short_level)/TICK)*TICK,8))]
+
+    for label, commission, slip in (("B2_zero_cost", 0.0, 0.0), ("B2_costed", 1.25, 0.25)):
+        strategy = B2()
+        config = BacktestConfig(initial_cash=INITIAL_CASH, allow_short_selling=True, allow_leverage=True,
+            fixed_margin_schedule={ASSET: (INITIAL_MARGIN, MAINTENANCE_MARGIN)},
+            execution_mode=ExecutionMode.NEXT_BAR, stop_fill_mode=StopFillMode.NEXT_BAR_OPEN,
+            commission_type=CommissionType.PER_SHARE if commission else CommissionType.NONE,
+            commission_per_share=commission,
+            slippage_type=SlippageType.FIXED if slip else SlippageType.NONE, slippage_fixed=slip,
+            reject_on_insufficient_cash=True)
+        spec = ContractSpec(symbol=ASSET, asset_class=AssetClass.FUTURE, multiplier=MULTIPLIER, tick_size=TICK, margin=INITIAL_MARGIN)
+        result = Engine(DataFeed(prices_df=prices, signals_df=signals), strategy, config,
+            contract_specs={ASSET: spec}).run()
+        path = ydir / label; path.mkdir(parents=True, exist_ok=True)
+        trades, fills = result.to_trades_dataframe(), result.to_fills_dataframe()
+        for frame, cols in ((trades, ("entry_time", "exit_time")), (fills, ("timestamp",))):
+            for col in cols:
+                if frame.height and frame[col].dtype == pl.Datetime and frame[col].dtype.time_zone is None:
+                    frame.replace_column(frame.columns.index(col), frame[col].dt.replace_time_zone("UTC"))
+        trades.write_csv(path / "trades.csv"); fills.write_csv(path / "fills.csv")
+        eq = pl.DataFrame({"timestamp": [t for t, _ in result.equity_curve], "equity": [float(v) for _, v in result.equity_curve]})
+        daily = eq.with_columns(pl.col("timestamp").dt.date().alias("date")).group_by("date").agg(pl.col("timestamp").last(), pl.col("equity").last()).sort("date")
+        daily.write_csv(path / "daily_equity.csv")
+        closed = trades.filter(pl.col("status") == "closed") if trades.height else trades
+        # Attribute by actual entry timestamp's Chicago session year; final partial year uses the fixed cutoff.
+        if closed.height:
+            closed = closed.with_columns(pl.col("entry_time").map_elements(chicago_day, return_dtype=pl.Date).alias("session_day"))
+            closed = closed.filter(pl.col("session_day").dt.year() == year)
+        if closed.height:
+            trade_rows = []
+            candidate_entries = [e for e in strategy.entries if chicago_day(e["entry_time"]).year == year]
+            for trade in closed.to_dicts():
+                entry = next((e for e in candidate_entries if e["entry_time"] == trade["entry_time"]), None)
+                if entry is None:
+                    entry = min(candidate_entries, key=lambda e: abs((e["entry_time"] - trade["entry_time"]).total_seconds()))
+                direction = str(trade["direction"]).lower()
+                stop_price = protective_stop(float(trade["entry_price"]), float(entry["distance"]),
+                                             float(trade["quantity"]) if direction == "long" else -float(trade["quantity"]))
+                exit_matches = fills.filter((pl.col("timestamp") == trade["exit_time"]) &
+                    (pl.col("side") == ("sell" if direction == "long" else "buy")))
+                exit_fill = exit_matches.row(0, named=True) if exit_matches.height else None
+                trade["stop_distance"] = float(entry["distance"])
+                trade["stop_price"] = stop_price
+                trade["nominal_risk_usd"] = abs(float(trade["quantity"])) * abs(float(trade["entry_price"]) - stop_price) * MULTIPLIER
+                trade["r_multiple"] = float(trade["pnl"]) / trade["nominal_risk_usd"]
+                trade["exit_order_type"] = exit_fill["order_type"] if exit_fill else None
+                reference = float(exit_fill["reference_price"]) if exit_fill and exit_fill["reference_price"] is not None else (float(exit_fill["price"]) if exit_fill else 0.0)
+                trade["gap_overshoot_points"] = (max(0.0, stop_price - reference) if direction == "long"
+                    else max(0.0, reference - stop_price)) if exit_fill and exit_fill["order_type"] == "stop" else 0.0
+                trade["gap_overshoot_usd"] = trade["gap_overshoot_points"] * abs(float(trade["quantity"])) * MULTIPLIER
+                boundary = next_boundary(trade["entry_time"])
+                trade["late_market_exit_minutes"] = (max(0.0, (trade["exit_time"] - boundary).total_seconds() / 60)
+                    if trade["exit_order_type"] == "market" else 0.0)
+                trade_rows.append(trade)
+            closed = pl.DataFrame(trade_rows)
+            closed.write_csv(path / "evaluation_trades.csv")
+        gross = float(closed["gross_pnl"].sum() or 0) if closed.height else 0.0
+        net = float(closed["pnl"].sum() or 0) if closed.height else 0.0
+        fees = float(closed["fees"].sum() or 0) if closed.height else 0.0
+        slip_cost = float(closed["total_slippage_cost"].sum() or 0) if closed.height else 0.0
+        exit_stops = closed.filter(pl.col("exit_order_type") == "stop").height if closed.height else 0
+        entries = [e for e in strategy.entries if chicago_day(e["entry_time"]).year == year]
+        nominal = sum(e["nominal_risk_usd"] for e in entries)
+        qtys = [e["qty"] for e in entries]
+        rsum = float(closed["r_multiple"].sum()) if closed.height else 0.0
+        daily_entries = defaultdict(int)
+        for e in entries: daily_entries[chicago_day(e["entry_time"])] += 1
+        metrics = {"trial_id": label, "status": "completed", "closed_trades": closed.height,
+            "gross_pnl_usd": gross, "net_pnl_usd": net, "fees_usd": fees, "slippage_usd": slip_cost,
+            "actual_nominal_risk_usd": float(closed["nominal_risk_usd"].sum()) if closed.height else 0.0,
+            "actual_nominal_risk_usd_max": float(closed["nominal_risk_usd"].max()) if closed.height else 0.0,
+            "trades_over_1000_actual_tick_rounded_trigger_risk": closed.filter(pl.col("nominal_risk_usd") > 1000).height if closed.height else 0,
+            "risk_budget_deployment_utilization": (float(closed["nominal_risk_usd"].mean()) / 1000 if closed.height else 0.0),
+            "r_sum": rsum, "expectancy_r": rsum / closed.height if closed.height else None,
+            "worst_trade_r": float(closed["r_multiple"].min()) if closed.height else None,
+            "stop_exit_count_actual_order_type": exit_stops,
+            "gap_overshoot_points_max": float(closed["gap_overshoot_points"].max()) if closed.height else 0.0,
+            "gap_overshoot_usd_total": float(closed["gap_overshoot_usd"].sum()) if closed.height else 0.0,
+            "late_scheduled_market_exits": closed.filter(pl.col("late_market_exit_minutes") > 0).height if closed.height else 0,
+            "max_late_market_exit_minutes": float(closed["late_market_exit_minutes"].max()) if closed.height else 0.0,
+            "long_short": {side: {"trades": closed.filter(pl.col("direction").str.to_lowercase() == side).height,
+                "net_pnl_usd": float(closed.filter(pl.col("direction").str.to_lowercase() == side)["pnl"].sum() or 0)}
+                for side in ("long", "short")},
+            "gross_minus_net_equals_fees": abs((gross - net) - fees) < 1e-6,
+            "native_margin_rejected_orders": result.metrics.get("num_rejected_orders"),
+            "ambiguous_events": len([e for e in strategy.ambiguous if chicago_day(datetime.fromisoformat(e["timestamp"])).year == year]),
+            "ambiguity_kinds": {k: sum(1 for e in strategy.ambiguous if e["kind"] == k and chicago_day(datetime.fromisoformat(e["timestamp"])).year == year)
+                for k in {e["kind"] for e in strategy.ambiguous}},
+            "qty_distribution": {str(q): qtys.count(q) for q in sorted(set(qtys))}, "skipped_qty_lt_1": strategy.skipped,
+            "entry_contract_sides": sum(qtys), "round_trip_contract_sides_for_closed_trades": 2 * sum(abs(float(x)) for x in closed["quantity"].to_list()) if closed.height else 0,
+            "max_entries_per_chicago_session_day": max(daily_entries.values(), default=0),
+            "commission_per_contract_per_fill_usd": commission, "slippage_points_per_fill": slip,
+            "initial_margin_per_contract_usd": INITIAL_MARGIN, "maintenance_margin_per_contract_usd": MAINTENANCE_MARGIN,
+            "native_engine_final_value": result.metrics.get("final_value"),
+            "native_engine_open_trades": trades.filter(pl.col("status") != "closed").height if trades.height else 0,
+            "strategy_entries": len(entries), "initial_cash_usd": INITIAL_CASH}
+        write(path / "metrics.json", metrics); yearsummaries.append(metrics)
+        print(f"{year} {label} trades={closed.height} net={net:.2f}", flush=True)
+    from importlib.metadata import version
+    summary = {"year": year, "status": "completed", "generated_at_utc": datetime.now(timezone.utc).isoformat(),
+        "command": [sys.executable, *sys.argv], "runner_sha256": sha(Path(__file__)),
+        "frozen_spec_sha256": sha(OUT / "frozen_spec.json"), "source_manifest_sha256": sha(BASE / "source_manifest.json"),
+        "quality": quality, "trials": yearsummaries,
+        "engine_versions": {"ml4t_backtest": version("ml4t-backtest"), "ml4t_engineer": version("ml4t-engineer")},
+        "git_head": __import__("subprocess").check_output(["git","rev-parse","HEAD"],cwd=ROOT,text=True).strip(),
+        "ending_cash_resets_each_year": True}
+    write(ydir / "year_summary.json", summary)
+    return summary
+
+
+if __name__ == "__main__":
+    year = int(sys.argv[sys.argv.index("--year") + 1])
+    run(year)
diff --git a/tests/test_one_bar_nq_b2_20261012.py b/tests/test_one_bar_nq_b2_20261012.py
new file mode 100644
index 0000000000000000000000000000000000000000..40f99deaea991d067aaf3a7922dd39feb7c230eb
--- /dev/null
+++ b/tests/test_one_bar_nq_b2_20261012.py
@@ -0,0 +1,133 @@
+from __future__ import annotations
+
+from datetime import date, datetime, timedelta, timezone
+from zoneinfo import ZoneInfo
+
+import polars as pl
+
+from scripts.run_one_bar_nq_b2_20261012 import can_enter, mnq_quantity, protective_stop, stop_distance
+from scripts.run_one_bar_nq_b2_yearly_20261012 import attach_signals, build_bars
+
+
+def test_atr_distance_rounding_and_integer_risk_budget() -> None:
+    distance = stop_distance(66.7)
+    assert distance == 100.25
+    assert mnq_quantity(distance) == 4
+    assert mnq_quantity(distance) * distance * 2 <= 1000
+    assert mnq_quantity(500.25) == 0
+
+
+def test_protective_stop_uses_actual_entry_and_adverse_tick_rounding() -> None:
+    assert protective_stop(100.125, 10.25, 4) == 89.75
+    assert protective_stop(100.125, 10.25, -4) == 110.5
+
+
+def test_daily_entry_cap_counts_filled_entries() -> None:
+    day = date(2026, 10, 12)
+    counts = {day: 0}
+    assert can_enter(counts, day)
+    counts[day] += 1
+    assert can_enter(counts, day)
+    counts[day] += 1
+    assert not can_enter(counts, day)
+
+
+def test_chicago_17_anchor_tracks_dst() -> None:
+    tz = ZoneInfo("America/Chicago")
+    winter = datetime(2026, 1, 5, 17, tzinfo=tz).astimezone(timezone.utc)
+    summer = datetime(2026, 7, 6, 17, tzinfo=tz).astimezone(timezone.utc)
+    assert winter.hour == 23
+    assert summer.hour == 22
+
+
+def test_ml4t_atr20_is_released_only_after_complete_bar() -> None:
+    start = datetime(2026, 1, 5, 23, tzinfo=timezone.utc)
+    timestamps = [start + timedelta(minutes=i) for i in range(30 * 21)]
+    minute = pl.DataFrame({"timestamp": timestamps, "open": [100.0] * len(timestamps),
+        "high": [101.0] * len(timestamps), "low": [99.0] * len(timestamps),
+        "close": [100.0] * len(timestamps), "volume": [1] * len(timestamps)})
+    bars = build_bars(minute)
+    first = bars.row(0, named=True)
+    assert first["available_at"] == first["bar_start"] + timedelta(minutes=30)
+    assert first["release_decision_at"] == first["available_at"] - timedelta(minutes=1)
+    assert bars.filter(pl.col("atr20").is_finite()).height > 0
+    assert bars.filter(pl.col("atr20").is_finite())["bar_start"].min() >= first["bar_start"] + timedelta(minutes=19 * 30)
+
+
+def test_feature_asof_release_has_no_incomplete_bar_leakage() -> None:
+    start = datetime(2026, 1, 5, 23, tzinfo=timezone.utc)
+    timestamps = [start + timedelta(minutes=i) for i in range(30 * 22)]
+    raw = pl.DataFrame({"timestamp": timestamps, "open": [100.0] * len(timestamps),
+        "high": [101.0] * len(timestamps), "low": [99.0] * len(timestamps),
+        "close": [100.0] * len(timestamps), "volume": [1] * len(timestamps)})
+    bars = build_bars(raw)
+    first_valid = bars.filter(pl.col("atr20").is_finite()).row(0, named=True)
+    joined = attach_signals(raw, bars)
+    before = joined.filter(pl.col("timestamp") == first_valid["release_decision_at"] - timedelta(minutes=1))[0, "atr20"]
+    at_release = joined.filter(pl.col("timestamp") == first_valid["release_decision_at"])[0, "atr20"]
+    assert before is None
+    assert at_release == first_valid["atr20"]
+
+
+def test_native_engine_stop_uses_actual_fill_and_charges_each_contract_fill() -> None:
+    from ml4t.backtest import AssetClass, BacktestConfig, CommissionType, ContractSpec, DataFeed, Engine, Strategy
+    from ml4t.backtest.config import SlippageType
+    from ml4t.backtest.types import ExecutionMode, OrderType, StopFillMode
+
+    ts = [datetime(2026, 1, 5, 23, tzinfo=timezone.utc) + timedelta(minutes=i) for i in range(5)]
+    prices = pl.DataFrame({"timestamp": ts, "asset": ["MNQ"] * 5,
+        "open": [100.0, 100.0, 98.0, 98.0, 98.0], "high": [100.0, 101.0, 99.0, 99.0, 99.0],
+        "low": [100.0, 99.0, 97.0, 97.0, 97.0], "close": [100.0, 100.0, 98.0, 98.0, 98.0]})
+
+    class StopAfterFill(Strategy):
+        def __init__(self): self.sent = False; self.stop = None; self.entry_price = None
+        def on_data(self, timestamp, data, context, broker):
+            pos = broker.get_position("MNQ")
+            if not self.sent:
+                broker.submit_order("MNQ", 4, order_type=OrderType.MARKET); self.sent = True
+            elif pos and self.stop is None:
+                self.entry_price = float(pos.entry_price)
+                self.stop = protective_stop(self.entry_price, 1.0, float(pos.quantity))
+                broker.submit_order("MNQ", -4, order_type=OrderType.STOP, stop_price=self.stop)
+
+    config = BacktestConfig(initial_cash=100_000, allow_short_selling=True, allow_leverage=True,
+        fixed_margin_schedule={"MNQ": (100, 50)}, execution_mode=ExecutionMode.NEXT_BAR,
+        stop_fill_mode=StopFillMode.NEXT_BAR_OPEN, commission_type=CommissionType.PER_SHARE,
+        commission_per_share=1.25, slippage_type=SlippageType.FIXED, slippage_fixed=0.25)
+    strategy = StopAfterFill()
+    result = Engine(DataFeed(prices_df=prices), strategy, config,
+        contract_specs={"MNQ": ContractSpec("MNQ", AssetClass.FUTURE, multiplier=2, tick_size=.25, margin=100)}).run()
+    fills = result.to_fills_dataframe()
+    assert fills.height == 2
+    assert fills["quantity"].abs().to_list() == [4.0, 4.0]
+    assert fills["commission"].sum() == 10.0
+    trades = result.to_trades_dataframe().filter(pl.col("status") == "closed")
+    assert trades["total_slippage_cost"].sum() == 4.0
+    assert float(fills.filter(pl.col("order_type") == "stop")["stop_price"][0]) == strategy.stop
+    assert strategy.stop == protective_stop(strategy.entry_price, 1.0, 4.0)
+
+
+def test_native_opposing_stops_can_both_fill_on_one_ohlc_bar() -> None:
+    from ml4t.backtest import BacktestConfig, DataFeed, Engine, Strategy
+    from ml4t.backtest.types import ExecutionMode, OrderType
+
+    ts = [datetime(2026, 1, 5, 23, tzinfo=timezone.utc) + timedelta(minutes=i) for i in range(3)]
+    prices = pl.DataFrame({"timestamp": ts, "asset": ["MNQ"] * 3,
+        "open": [100.0, 100.0, 100.0], "high": [100.0, 102.0, 100.0],
+        "low": [100.0, 98.0, 100.0], "close": [100.0, 100.0, 100.0]})
+
+    class OpposingStops(Strategy):
+        def __init__(self): self.sent = False
+        def on_data(self, timestamp, data, context, broker):
+            if not self.sent:
+                broker.submit_order("MNQ", 1, order_type=OrderType.STOP, stop_price=101)
+                broker.submit_order("MNQ", -1, order_type=OrderType.STOP, stop_price=99)
+                self.sent = True
+
+    result = Engine(DataFeed(prices_df=prices), OpposingStops(),
+        BacktestConfig(initial_cash=100_000, allow_short_selling=True, allow_leverage=True,
+            execution_mode=ExecutionMode.NEXT_BAR)).run()
+    fills = result.to_fills_dataframe()
+    assert fills.height == 2
+    assert fills["timestamp"].n_unique() == 1
+

diff --git a/scripts/run_one_bar_nq_b2_20261012.py b/scripts/run_one_bar_nq_b2_20261012.py
