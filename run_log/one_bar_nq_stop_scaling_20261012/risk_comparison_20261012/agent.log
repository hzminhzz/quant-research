+    results, mc = {}, {}
+    for name, (lo, hi) in periods.items():
+        x0 = b0.filter((pl.col("utc_entry_date") >= lo) & (pl.col("utc_entry_date") <= hi)).with_columns(pl.lit(1000.0).alias("nominal_risk_usd"))
