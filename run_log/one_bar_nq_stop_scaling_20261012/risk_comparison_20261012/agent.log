dependencies: [transaction-costs]
metadata:
  book_chapters: "17"
  library: "ml4t-backtest"
paths: ["**/*portfolio*.py", "**/*position*.py", "**/*risk*.py", "**/*optim*.py", "**/*exposure*.py", "**/*kill*.py", "**/*stress*.py"]
