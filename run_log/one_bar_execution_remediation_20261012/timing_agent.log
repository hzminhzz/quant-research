+def test_fiftieth_completed_bar_releases_level_at_its_close_to_incomplete_next_bar():
+    start = datetime(2024, 1, 8, 23, 0, tzinfo=timezone.utc)
+    timestamps, prices = [], []
+    for bar_no in range(50):
+        for minute in range(30):
