"""Execute the frozen practical one-minute native-engine replay."""
from __future__ import annotations

import hashlib
import json
import sys
from datetime import date, datetime, timezone
from pathlib import Path

import polars as pl

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / "run_log/one_bar_practical_1m_20261012"
BASE = ROOT / "run_log/one_bar_dukascopy_2013_2026_20261011"
STORE = Path("/home/quant/dev/quant/ml4t-data/.data/store/index_minute_NQ")
sys.path.insert(0, str(ROOT / "scripts"))
import run_one_bar_dukascopy_phase567_20261011 as phase


def sha(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def files() -> list[Path]:
    return sorted(p for p in STORE.glob("year=*/month=*/data.parquet")
        if p.parent.parent.name < "year=2026" or
        (p.parent.parent.name == "year=2026" and int(p.parent.name.split("=")[1]) <= 7))


def frozen_spec() -> dict:
    manifest_path = BASE / "source_manifest.json"
    manifest = json.loads(manifest_path.read_text())
    return {
        "status": "frozen_before_execution", "classification": "EXPLORATORY retrospective; not approval",
        "source": "Dukascopy USATECH.IDX/USD BID 1-minute CFD proxy; not CME NQ",
        "data": {"root": str(STORE), "start_inclusive_utc": "2013-01-01", "end_inclusive_utc": "2026-07-14",
            "protected_after": "2026-07-14", "partition_count": len(manifest),
            "source_manifest": str(manifest_path.relative_to(ROOT)), "source_manifest_sha256": sha(manifest_path),
            "source_manifest_matches_frozen_baseline": sha(manifest_path) == json.loads((BASE / "frozen_spec.json").read_text())["data"]["source_manifest_sha256"]},
        "instrument_assumptions": {"multiplier_usd_per_point": 20, "tick_points": 0.25, "contracts": 1,
            "identity_limit": "NQ-equivalent sizing is illustrative, not source CFD specification."},
        "rules": {"lookback": "highest high / lowest low of 50 fully completed session-anchored 30m bars",
            "entry": "native buy STOP and sell STOP, cancel opposite after fill; max 2 entries per Chicago Globex date",
            "protective_stop": "$1000 nominal = 50 index points from entry", "exit": "market at next 30m boundary open; next actual source minute if boundary print is absent",
            "session": "Chicago 17:00 anchored 30m intervals; extended hours", "one contract": True,
            "ambiguous_ohlc": "Native engine ledger retained as modeled. Separate conservative bound replaces each affected trade/event with worst-case loss; no intraminute sequence inferred."},
        "trials": [
            {"id":"A","name":"native_zero_cost","commission_per_fill_usd":0,"slippage_points_per_fill":0},
            {"id":"B","name":"native_full_tick_cost","commission_per_fill_usd":2.5,"slippage_points_per_fill":0.25},
            {"id":"C","name":"native_additional_half_spread","commission_per_fill_usd":2.5,"slippage_points_per_fill":0.375,"note":"B plus 0.125 index points per fill; extra one tick round trip, proxy stress."},
            {"id":"D","name":"conservative_ambiguous_bound","source_trial":"B","method":"Replace ambiguous executions by -$1000 nominal plus B round-trip commission and slippage. Conservative diagnostic, not native replay."}],
        "skill_invariants": ["ml4t-run-backtest: Strategy/Engine/DataFeed; future-event fills; explicit costs",
            "ml4t-polars-patterns: sorted Polars source processing", "ml4t-calendar-ops: Chicago session dates and DST-aware UTC boundaries",
            "ml4t-build-bars: only 30 complete source minutes form a decision bar", "ml4t-lookahead-bias: levels released only after prior completed bar",
            "ml4t-validate-data: source row, duplicate, null, and OHLC audit", "ml4t-cost-model: isolate commission and adverse slippage"],
    }


def load_feed() -> tuple[pl.DataFrame, dict]:
    paths = files()
    frozen = json.loads((BASE / "frozen_spec.json").read_text())
    expected = json.loads((BASE / "source_manifest.json").read_text())
    if len(paths) != frozen["data"]["partitions"] or sha(BASE / "source_manifest.json") != frozen["data"]["source_manifest_sha256"]:
        raise ValueError("Source manifest identity mismatch")
    for path, record in zip(paths, expected, strict=True):
        if path.relative_to(STORE).as_posix() != record["path"] or sha(path) != record["sha256"]:
            raise ValueError(f"Source partition mismatch: {path}")
    raw = (pl.scan_parquet([str(p) for p in paths])
        .filter(pl.col("timestamp").dt.date().is_between(date(2013,1,1), date(2026,7,14)))
        .select("timestamp", "open", "high", "low", "close", "volume").sort("timestamp").collect()
        .with_columns(pl.col("timestamp").dt.replace_time_zone("UTC")))
    local = pl.col("timestamp").dt.convert_time_zone("America/Chicago")
    minute = local.dt.hour() * 60 + local.dt.minute()
    raw = raw.with_columns(local.alias("local"), pl.when(minute >= 1020).then(local.dt.date())
        .otherwise(local.dt.date().dt.offset_by("-1d")).alias("session_date"))
    dates = raw["session_date"].unique().sort().to_list()
    from zoneinfo import ZoneInfo
    from datetime import datetime as dt
    starts = pl.DataFrame({"session_date": dates, "session_start_utc": [dt(d.year,d.month,d.day,17,tzinfo=ZoneInfo("America/Chicago")).astimezone(timezone.utc) for d in dates]})
    source = raw.join(starts, on="session_date", how="left").with_columns(
        ((pl.col("timestamp")-pl.col("session_start_utc")).dt.total_minutes()//30).alias("bar_no"))
    bars = (source.group_by("session_date","bar_no").agg(pl.col("timestamp").min().alias("bar_start"),
        pl.col("high").max().alias("bar_high"),pl.col("low").min().alias("bar_low"),pl.len().alias("n"),
        pl.col("timestamp").n_unique().alias("unique_n")).filter((pl.col("n")==30)&(pl.col("unique_n")==30))
        .sort("bar_start").with_columns(pl.col("bar_high").rolling_max(50).alias("next_long_stop"),
        pl.col("bar_low").rolling_min(50).alias("next_short_stop"),
        ((pl.col("bar_high")-pl.col("bar_low"))/pl.col("bar_high")).alias("range_proxy"),
        (pl.col("bar_start")+pl.duration(minutes=30)).alias("available_at"))
        .filter(pl.col("next_long_stop").is_not_null()))
    # The prior minute's on_data call submits before the next source row opens at the release boundary.
    levels = bars.select((pl.col("available_at")-pl.duration(minutes=1)).alias("release_decision_at"),"next_long_stop","next_short_stop","range_proxy")
    feed = source.sort("timestamp").join_asof(levels.sort("release_decision_at"),left_on="timestamp",
        right_on="release_decision_at",strategy="backward").with_columns(
            pl.lit(phase.ASSET).alias("asset"),
            ((pl.col("next_long_stop")-pl.col("next_short_stop"))/pl.col("next_long_stop")).alias("range_proxy"))
    quality = {"source_rows": raw.height,"source_minutes_all_retained": feed.height,
"""Run the frozen one-bar strategy in isolated annual ML4T Engine processes."""
from __future__ import annotations

import argparse
import gc
import hashlib
import json
import os
import subprocess
import sys
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

import polars as pl

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / "run_log/one_bar_practical_1m_20261012"
BASE = ROOT / "run_log/one_bar_dukascopy_2013_2026_20261011"
STORE = Path("/home/quant/dev/quant/ml4t-data/.data/store/index_minute_NQ")
ASSET = "NQ_PROXY"
TZ = ZoneInfo("America/Chicago")
FIRST_YEAR, LAST_YEAR = 2013, 2026
DATA_END = date(2026, 7, 14)
MULTIPLIER = 20.0
sys.path.insert(0, str(ROOT / "scripts"))


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda: f.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def eligible_years() -> list[int]:
    return list(range(FIRST_YEAR, LAST_YEAR + 1))


def chicago_session_day(ts: datetime) -> date:
    local = ts.astimezone(TZ)
    return local.date() if local.hour >= 17 else local.date() - timedelta(days=1)


def source_files() -> list[Path]:
    return sorted(
        p for p in STORE.glob("year=*/month=*/data.parquet")
        if int(p.parent.parent.name.split("=")[1]) < 2026
        or (int(p.parent.parent.name.split("=")[1]) == 2026
            and int(p.parent.name.split("=")[1]) <= 7)
    )


def verify_source() -> dict:
    manifest_path = BASE / "source_manifest.json"
    frozen = json.loads((BASE / "frozen_spec.json").read_text())
    records = json.loads(manifest_path.read_text())
    paths = source_files()
    if sha256(manifest_path) != frozen["data"]["source_manifest_sha256"]:
        raise ValueError("Frozen source manifest hash mismatch")
    if len(paths) != frozen["data"]["partitions"] or len(paths) != len(records):
        raise ValueError("Frozen source partition count mismatch")
    checked_bytes = 0
    for path, row in zip(paths, records, strict=True):
        if path.relative_to(STORE).as_posix() != row["path"] or sha256(path) != row["sha256"]:
            raise ValueError(f"Frozen source partition mismatch: {path}")
        checked_bytes += path.stat().st_size
    return {"manifest": str(manifest_path.relative_to(ROOT)),
            "manifest_sha256": sha256(manifest_path), "partition_count": len(paths),
            "verified_bytes": checked_bytes, "protected_after": str(DATA_END),
            "all_partition_hashes_match": True}


def files_for_year(year: int) -> list[Path]:
    # December provides at least two full Chicago sessions of prior context.
    return [p for p in source_files()
            if (int(p.parent.parent.name.split("=")[1]) == year
                or (int(p.parent.parent.name.split("=")[1]) == year - 1
                    and int(p.parent.name.split("=")[1]) == 12)
# One-bar execution remediation audit

Status: stop-gap handling `VERIFIED`; full rule replay `BLOCKED`; strategy approval `NOT_APPROVED`.

The frozen account remains $1,000,000 initial cash, with short selling and leverage enabled, $25,000 initial margin, and $20,000 maintenance margin per contract. The unchanged stress case is 0.25 adverse index points and $2.50 commission per fill. The instrument remains one indicative contract at $20 per point.

## Work completed

The bounded scenarios used `ml4t.backtest 0.1.7 Engine`. No code in site-packages changed. The installed `StopFillMode.STOP_PRICE` implementation checks the source bar's `open`. It fills at that open when the open crosses a stop. It fills at the trigger when the bar crosses the stop after the open. Synthetic Engine tests verify both long and short entry gaps and protective-stop gaps. They verify that a $1,000 trigger is not a guaranteed maximum loss.

The previous gap diagnostic used `reference_price` as if it were the bar open. The saved fill ledger contains the actual `price_source=open`, but the diagnostic compared reference prices to stop prices. The corrected audit joins each saved stop fill to the source OHLC row at its timestamp. It checks the trigger/open rule and recorded side-adverse slippage.

| Check on saved full-tick ledger | Result |
|---|---:|
| Stop fills joined to source OHLC | 5,581 |
| Missing source rows | 0 |
| Fill-price mismatches after recorded slippage | 0 |
| Actual stop gaps | 286 |
| Actual entry gaps | 282 |
| Actual protective-stop gaps | 4 |
| Gross minus net minus commission | $0.00 |
| Fill versus trade slippage-cost difference | $0.00 |
| Trade ledger versus final equity difference | less than $0.000001 |

The 3,335 entry gap count and its $409,132.58 “price advantage” are not supported by source opens. The 105 stop-gap count and $19,993.80 amount are also not supported by source opens. Do not use these earlier diagnostics.

## Source-minute execution and 30-minute decisions

`prepare_execution_feed` retains every valid source-minute row. It creates a signal event only after 50 complete 30-minute bars are available. For a completed bar `b`, the level is the rolling maximum/minimum of bars `b-49` through `b`, inclusive. Its availability timestamp is `bar_start + 30 minutes`, the close boundary of `b`. A backward as-of join attaches that event to the first source minute at or after the boundary. A minute stamped at the boundary is the opening execution event for the next bar, so it can use the released level. A missing boundary print does not remove the event; the next observed source minute receives the latest released level.

The old exact-bin join exposed a level from bars `b-1` through `b-50` on source minutes inside `b`. That level was not the level intended for orders submitted after `b` closed. The corrected join has no same-bar lookahead and does not use completeness of the current bar to choose whether to execute at its open. A 14-test focused suite verifies release at the 50th completed bar close, retention of the next incomplete bar's opening print and level, invariance to future-bar mutations, session-gap carry, and distinct UTC boundaries across the repeated Chicago DST hour. The machine-readable timing proof is in `run_log/one_bar_execution_remediation_20261012/timing_audit.json`.

The saved historical output had 216 delayed scheduled exits. The source audit classifies them as follows:

- 191 scheduled boundary opens exist in source data. The previous inner join removed those execution minutes because their 30-minute bins were incomplete.
- 25 scheduled boundary opens do not exist in source data. Those exits remain unresolved until a real later print. The audit does not fabricate an opening event.

The source timestamps are shifted before any decision-bin filter. UTC boundary logic passed the repeated Chicago DST hour test.

## OCO and intrabar limits

The native synthetic OCO fixture triggers buy and sell stops within one minute. Both orders fill at the same timestamp. `Broker.submit_order` has no OCO group parameter. The installed native API cannot pass the atomic OCO invariant. Do not treat the one-minute candle as an ordered event, and do not select the favorable side after observing its result.

The prior saved run contains one same-minute opposing stop-order event and 44 entry/protective-stop same-minute ambiguities. Minute OHLC cannot establish their order. These events remain unresolved. A stop trigger at $1,000 risk does not cap loss if the market gaps.

The source store contains BID OHLCV only. The local canonical store has no verified index ASK or index tick/quote dataset. `index_minute_NAS100` is also OHLCV. The source is a Dukascopy USATECH.IDX/USD BID CFD proxy, not CME NQ futures. No ASK was synthesized.

## Trial and execution status

R1 verified native stop-gap fills. R2's source-minute timing was corrected and verified with focused synthetic Polars tests. R3, the full-history zero-cost and 0.25-point/$2.50-cost replay, is blocked. An exact replay would require atomic OCO handling that the installed Broker does not provide. A replay that admits the observed double fill would create false exposure. No post-hoc PnL adjustment was used. This timing fix does not establish a corrected historical performance result.

The prior ledger reconciles to $166,521.58 net and $1,166,521.58 final equity, with $26,860 of commission and reconciled fill slippage. These are historical output values only. They are not corrected performance results because the previous feed delayed 191 exits and contains OCO/intrabar ambiguities. The mission's corrected full-history outcome remains unavailable.

No data after 2026-07-14 was used. The complete test and run evidence is in `run_log/one_bar_execution_remediation_20261012/`. The updated focused suite passed 14 tests. The prior native fixture suite passed 6 tests.
