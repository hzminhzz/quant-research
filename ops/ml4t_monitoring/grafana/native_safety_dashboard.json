      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"ml4t-vps-node\",mode=\"idle\"}[5m]))",
          "legendFormat": "CPU busy fraction",
          "range": true
